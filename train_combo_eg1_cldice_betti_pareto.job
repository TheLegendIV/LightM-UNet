#!/bin/bash
#SBATCH --job-name=combo_eg1_cldice_betti
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Single training run: ENetComboEG1 (COMBO_EXPERIMENT=EG1) with the
# Dice+CE+clDice+Betti-0 loss (nnUNetTrainerENetComboClDiceBetti). clDice is
# kept in the loss rather than replaced by Betti-0 -- the two terms are
# complementary (clDice rewards centerline overlap, Betti-0 penalizes excess
# connected components; see cldice_betti.py) -- so the previous single run's
# most-aggressive clDice weight (COMBO_CLDICE_WEIGHT=2.0) is now split evenly
# between the two terms: COMBO_CLDICE_WEIGHT=1.0, COMBO_BETTI_WEIGHT=1.0, to
# keep the total topological loss magnitude comparable to that earlier run
# rather than simply doubling it. 150 epochs / batch size 8, on a MIG GPU
# slice.
#
# To evaluate afterward: run inference into its own labelsPr_<name>, then reuse
# analysis/compute_topology_metrics.py + analysis/preview_results.ipynb to compare
# dice/purity/branch-consistency against the existing labelsPr_ENetComboEG1 baseline
# (and against the clDice-only run this one is split from, if that checkpoint/labels
# folder is still around).
#
# NOTE: verify `--partition=gpu_mig` (and whether your cluster wants a
# `--gres=gpu:<slice>:1`-style request instead of plain `--gpus=1` for MIG) against
# `sinfo -o "%P %G"` on your cluster -- partition/gres naming for MIG slices is
# cluster-specific and this is a best-guess default, not a verified value.

set -e

mkdir -p logs

RUN_NAME="nnUNetTrainerENetComboClDiceBetti_c1p0_b1p0"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENetCombo / clDice+Betti trainer knobs ------------------------------------
export COMBO_EXPERIMENT=EG1
export COMBO_EPOCHS=150
export COMBO_BATCH_SIZE=8
export COMBO_SAVE_EVERY=25          # checkpoint_latest.pth every 25 epochs, plus checkpoint_best/final as usual
export COMBO_CLDICE_WEIGHT=1.0      # split from the previous single-term run's most-aggressive weight (2.0)
export COMBO_CLDICE_ITERS=12        # covers p99 vessel width (~20-24px) measured on ARCADE GT; see cldice.py docstring
export COMBO_BETTI_WEIGHT=1.0       # other half of the split; see nnUNetTrainerENetComboBetti / betti.py
export COMBO_BETTI_PATCH_SIZE=64    # bounds Betti-0's CPU-bound Union-Find cost regardless of the real patch size
export COMBO_OUTPUT_FOLDER="$nnUNet_results/Dataset501_ARCADE/${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "COMBO_CLDICE_WEIGHT=${COMBO_CLDICE_WEIGHT}"
echo "COMBO_BETTI_WEIGHT=${COMBO_BETTI_WEIGHT}"
echo "Output folder: ${COMBO_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

echo "=== Start ENetComboClDiceBetti training (EG1, cldice=${COMBO_CLDICE_WEIGHT}, betti=${COMBO_BETTI_WEIGHT}) ==="
nnUNetv2_train 501 2d 0 -tr nnUNetTrainerENetComboClDiceBetti

echo "Training finished for ${RUN_NAME}."
