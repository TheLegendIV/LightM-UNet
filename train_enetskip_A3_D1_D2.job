#!/bin/bash
#SBATCH --job-name=enetskip_A3_D1_D2
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --gpus=1
#SBATCH --partition=gpu_a100
#SBATCH --time=12:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
# Full 150-epoch training for ENetSkip A3, D1, D2.
#   A3 — raw skips at 4x and 5x with Conv1×1 fusion
#   D1 — lightweight edge-gated skip at 4x
#   D2 — lightweight edge-gated skips at both 4x and 5x
# Experiments run sequentially. Checkpoints and final validation are kept.
# If the job times out before all three finish, re-run with --configs <remaining>.

set -e

mkdir -p logs

module purge
module load 2023
module load CUDA/12.1.1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Working dir: $(pwd)"
echo "Conda env: $CONDA_PREFIX"

echo "=== GPU info ==="
nvidia-smi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

OUTPUT_ROOT="$HOME/LightM-UNet/data/nnUNET_results/enet_skip_e150"

python pareto_experiments/run_enet_skip_pareto.py \
    --configs A3 D1 D2 \
    --epochs 150 \
    --batch-size 8 \
    --output-root "$OUTPUT_ROOT" \
    --keep-checkpoints \
    --run-final-validation \
    --overwrite

echo "=== Training done at $(date) ==="
echo "Results: $OUTPUT_ROOT/summary.csv"
