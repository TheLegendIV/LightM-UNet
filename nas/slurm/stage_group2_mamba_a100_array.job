#!/bin/bash
#SBATCH --job-name=stage_group2_mamba_a100
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=10:00:00
#SBATCH --array=0-1
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# lightmunet/lmunet split out of stage_group2_literature_benchmark_array.job
# (originally tasks 2/3 there) -- both crashed with CUDA out-of-memory on
# that array's gpu_mig partition BEFORE saving any checkpoint:
#   lmunet:      OOM inside PVMamba's Mamba call (nnunetv2/nets/LMUNet.py's
#                SequenceMamba/PVMamba forward chain).
#   lightmunet:  OOM inside mamba_ssm's mamba_simple.py in_proj matmul,
#                reached via nnunetv2/nets/LightMUNet.py's own
#                `self.mamba(x_norm)` call (LightMUNet.py:50).
# Root cause (same for both): LMUNet.py's SequenceMamba/PVMamba explicitly
# upcast fp16 activations to fp32 before calling Mamba (LMUNet.py:53-54,
# 84-85) -- mamba_ssm's own kernels require fp32 regardless -- which defeats
# nnU-Net's default fp16 AMP memory savings specifically inside every Mamba
# call, of which both architectures run several concurrently (LightMUNet:
# one per encoder/decoder stage; LMUNet: PVMamba in 3 encoder stages, 2
# decoder stages, EdgeFeatureExtraction x2 + its own fuse stage, and one per
# scale in MMSC's EdgeFeatureFusion). Neither job overrode its
# trainer's own *_BATCH_SIZE env hook (LIGHTMUNET_BATCH_SIZE/LMUNET_BATCH_SIZE,
# both already wired in nnUNetTrainerLightMUNet.py/nnUNetTrainerLMUNet.py), so
# each inherited nnU-Net's plan-auto-configured batch size -- sized for
# PlainConvUNet's much cheaper memory profile, not Mamba's -- and the
# gpu_mig partition's MIG-sliced GPU (~19.75 GiB per both tracebacks' own
# reported totals, a slice of an A100, not a full card) had no headroom left
# to absorb the mismatch (both traces show ~19.2-19.3 GiB already allocated
# when a routine <=150 MiB allocation failed).
#
# Fix applied here: move both onto a full (non-MIG) gpu_a100 node instead of
# tuning batch size down -- everything else (trainer classes, env-var names,
# channel overrides, resume/self-healing logic) is unchanged from the
# original array.
#
#   0: LightM-UNet (official Mamba-UNet). Same nnUNetTrainerLightMUNet /
#      LIGHTMUNET_* config as stage_group2_literature_benchmark_array.job's
#      former task 2.
#   1: LM-UNet (Xu et al. 2026 reimplementation). Same nnUNetTrainerLMUNet /
#      LMUNET_* config (channels 12,20,32,44,64,72) as
#      stage_group2_literature_benchmark_array.job's former task 3.
#
# --time bumped 03:00:00 -> 10:00:00 on 2026-09-28, after the original 3h
# budget (copied from the other group1/group2 arrays, never epoch-count-
# calibrated for Mamba specifically) turned out to only cover ~50/~43 epochs
# before SLURM killed each task -- measured straight from each task's own
# training_log's real "Epoch time" lines: lightmunet ~207s/epoch, lmunet
# ~249s/epoch (both notably slower than the non-Mamba nets' per-epoch cost,
# consistent with mamba_ssm's own CUDA kernel overhead). At that rate,
# lightmunet's remaining 150-50=100 epochs need ~5.75h and lmunet's
# remaining 150-43=107 epochs need ~7.40h -- 10h covers the slower of the
# two (lmunet) plus final-validation + SLURM/env startup overhead with
# margin to spare, so a single resubmission should reach epoch 150 cleanly
# via this job's own --c self-healing instead of needing yet another
# resubmit.
#
# Also fixed the same day: the self-healing EXISTING_CHECKPOINT check below
# only ever looked for checkpoint_final.pth/checkpoint_latest.pth -- but
# nnU-Net only writes checkpoint_latest.pth every save_every=50 epochs
# (nnUNetTrainer.py's own self.save_every), so a task killed before its
# first 50-epoch mark (lmunet, at ~43) has ONLY checkpoint_best.pth on disk.
# The old check would have found neither file, silently taken the "fresh
# start" branch, and discarded all progress -- even though
# maybe_load_checkpoint() in run_training.py already falls back to
# checkpoint_best.pth for --c on its own. Added the same
# checkpoint_best.pth fallback here so the bash-level check matches nnU-Net's
# own resume logic and --c actually gets passed in this situation.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
EPOCHS_TARGET=150

TASK_ID=${SLURM_ARRAY_TASK_ID}

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- Per-task config ------------------------------------------------------------
case "$TASK_ID" in
  0)
    RUN_NAME="lightmunet"
    TRAINER_CLASS="nnUNetTrainerLightMUNet"
    SEED_VAR="LIGHTMUNET_SEED"
    EPOCHS_VAR="LIGHTMUNET_EPOCHS"
    OUTFOLDER_VAR="LIGHTMUNET_OUTPUT_FOLDER"
    ;;
  1)
    RUN_NAME="lmunet"
    TRAINER_CLASS="nnUNetTrainerLMUNet"
    SEED_VAR="LMUNET_SEED"
    EPOCHS_VAR="LMUNET_EPOCHS"
    OUTFOLDER_VAR="LMUNET_OUTPUT_FOLDER"
    export LMUNET_CHANNELS="12,20,32,44,64,72"
    ;;
esac

OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"
export "${SEED_VAR}=0"
export "${EPOCHS_VAR}=${EPOCHS_TARGET}"
export "${OUTFOLDER_VAR}=${OUTPUT_FOLDER}"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME} (${TRAINER_CLASS}), seed via ${SEED_VAR}=0"
echo "Output folder: ${OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${OUTPUT_FOLDER}/checkpoint_final.pth" "${OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${OUTPUT_FOLDER}/checkpoint_latest.pth" "${OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${OUTPUT_FOLDER}/checkpoint_latest.pth"
elif [ -f "${OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    # A task killed before its first save_every=50-epoch mark (nnUNetTrainer.py's
    # own self.save_every) never gets a checkpoint_latest.pth at all -- only
    # checkpoint_best.pth exists. Without this fallback the check below would
    # find nothing and silently restart from scratch, discarding real
    # progress -- matches run_training.py's own maybe_load_checkpoint, which
    # already falls back final -> latest -> best for --c.
    EXISTING_CHECKPOINT="${OUTPUT_FOLDER}/checkpoint_best.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${EPOCHS_TARGET}."
    if [ "$CURRENT_EPOCH" -ge "$EPOCHS_TARGET" ]; then
        echo "Real ${EPOCHS_TARGET}-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME ${EPOCHS_TARGET}-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's time budget)."

echo "=== Archiving checkpoints + logs to \$HOME/models (only once the real epoch schedule is complete) ==="
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$EPOCHS_TARGET" ]; then
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
    echo "No collect_results.py support yet for ${TRAINER_CLASS} -- checkpoint archived, results collection deferred."
else
    echo "Only at epoch ${FINAL_EPOCH}/${EPOCHS_TARGET} -- skipping archive (resubmit this array to continue training)."
fi
