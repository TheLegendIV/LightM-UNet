#!/bin/bash
#SBATCH --job-name=small_refinement_enet_507
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# nnUNetTrainerSmallRefinementENet on Dataset507_ARCADE_refinement -- the
# actual two-channel refinement network from analysis/507_refinement_net_plan.md
# (lightm-unet/nnunetv2/nets/SmallRefinementENet.py), NOT the single-channel
# baseline in train_small_enet_507.job. This one consumes BOTH channels --
# the raw image (_0000) and ENetOriginal's first-pass predicted mask
# (_0001) -- through separate stems that fuse via a 1x1 projection, then one
# down/up round-trip for cheap context, then a skip-connected refinement
# stage back at full resolution. ~31K parameters (smoke-tested).
#
# Compare this run's discontinuity-category dice against
# train_small_enet_507.job's (same data, image-only) to answer the actual
# question this dataset/network pair exists for: does having access to the
# first-pass prediction help the network fix its own mistakes, beyond what
# the discontinuity-focused patch mix alone buys?
#
# Batch size 362 carried over from Dataset504/505/506/507's 85x85 patches
# feeding the same nnU-Net planner sizing heuristic -- not yet independently
# confirmed for this specific (heavier, 2-stem) network; watch the first
# couple of epochs' wall-clock/memory and adjust if needed.
#
# IMPORTANT: SMALLENET_SKIP_FINAL_VALIDATION=1 is required -- inherited from
# nnUNetTrainerSmallENet, same single-logit-sigmoid incompatibility with
# nnU-Net's normal sliding-window export path.



RUN_NAME="nnUNetTrainerSmallRefinementENet"
DATASET_ID=507
DATASET_NAME="Dataset507_ARCADE_refinement"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

# -- SmallRefinementENet trainer knobs -------------------------------------------
export SMALLENET_EPOCHS=150
export SMALLENET_BATCH_SIZE=362
export SMALLENET_SAVE_EVERY=25
export SMALLENET_SKIP_FINAL_VALIDATION=1   # required -- see note above
export SMALLENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"
# SMALLENET_STEM_CHANNELS / SMALLENET_STAGE_CHANNELS left at their defaults
# (8 / 32) -- see SmallRefinementENet.py.

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "Trainer: ${RUN_NAME}"
echo "SMALLENET_EPOCHS=${SMALLENET_EPOCHS}"
echo "SMALLENET_BATCH_SIZE=${SMALLENET_BATCH_SIZE}"
echo "Output folder: ${SMALLENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Start SmallRefinementENet training (batch_size=${SMALLENET_BATCH_SIZE}, epochs=${SMALLENET_EPOCHS}) ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerSmallRefinementENet

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."
