#!/bin/bash
#SBATCH --job-name=enet_skip_pareto
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --gpus=1
#SBATCH --partition=gpu_mig
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
# ENetSkip skip-connection ablation — 14 configs x 15 epochs.
# Baseline (ENet.py defaults, channels 20,72,144,72,20) is reused from the existing
# nnUNetTrainerENetOriginal run — no retraining needed.
# If the job runs over 8h, re-run with --configs to finish remaining groups.

set -e

mkdir -p logs

module purge
module load 2023
module load CUDA/12.1.1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Working dir: $(pwd)"
echo "Conda env: $CONDA_PREFIX"

echo "=== GPU info ==="
nvidia-smi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

OUTPUT_ROOT="$HOME/LightM-UNet/data/nnUNET_results_pareto/enet_skip_e15"
BASELINE_SRC="$HOME/LightM-UNet/data/nnUNet_results/Dataset501_ARCADE/nnUNetTrainerENetOriginal__nnUNetPlans__2d"

python pareto_experiments/run_enet_skip_pareto.py \
    --epochs 15 \
    --batch-size 8 \
    --output-root "$OUTPUT_ROOT" \
    --reuse-baseline "$BASELINE_SRC" \
    --overwrite

echo "=== Sweep done at $(date) ==="
echo "Results: $OUTPUT_ROOT/summary.csv"
