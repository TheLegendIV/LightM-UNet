#!/bin/bash
#SBATCH --job-name=combo_eg1_cldice_territory_smoketest
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Quick end-to-end smoke test for nnUNetTrainerENetComboClDiceTerritory (Dice +
# CE + clDice + territory-consistency): batch_size=1, 2 epochs, 5 train / 2 val
# iterations per epoch -- just enough to prove the combined loss actually runs
# on real data/hardware without crashing or OOMing, before committing the full
# 150-epoch training run (train_combo_eg1_cldice_territory_pareto.job) to the
# queue.
#
# Unlike the clDice+Betti-0 combo (nnUNetTrainerENetComboClDiceBetti, which
# was measured to collapse training to predicting no foreground at all --
# see betti.py / territory.py's docstrings), territory-consistency reads the
# true RCA-vs-LAD/LCX territory straight off ground truth, so there's no
# guessing and no CPU-bound Union-Find -- it's expected to be cheap and safe.
# This smoke test still exists mainly to catch trivial bugs (shape mismatches,
# NaNs) before spending the full 150-epoch budget.
#
# batch_size=1 specifically isolates whether a failure is a real bug in
# territory.py vs. simply not enough VRAM for the real batch_size=8 on a MIG
# slice -- if this fails too, it's not a memory problem.
#
# Separate output folder from the real run (nnUNetTrainerENetComboClDiceTerritory_smoketest),
# so this never collides with or contaminates real checkpoints.

set -e
mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- Minimal smoke-test settings ------------------------------------------------
export COMBO_EXPERIMENT=EG1
export COMBO_EPOCHS=2
export COMBO_BATCH_SIZE=1
export COMBO_ITERATIONS_PER_EPOCH=5
export COMBO_VAL_ITERATIONS_PER_EPOCH=2
export COMBO_CLDICE_WEIGHT=0.5
export COMBO_CLDICE_ITERS=12
export COMBO_TERRITORY_WEIGHT=0.5
export COMBO_SKIP_FINAL_VALIDATION=1
export COMBO_SKIP_ARCH_PLOT=1
export COMBO_OUTPUT_FOLDER="$nnUNet_results/Dataset501_ARCADE/nnUNetTrainerENetComboClDiceTerritory_smoketest__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

echo "=== Smoke test: nnUNetTrainerENetComboClDiceTerritory, batch_size=1, 2 epochs, 5 iters/epoch ==="
nnUNetv2_train 501 2d 0 -tr nnUNetTrainerENetComboClDiceTerritory

echo "Smoke test finished."
echo "Check the log above for: (1) no exceptions/OOM, (2) per-epoch loss values are finite (no NaN/inf),"
echo "(3) loss is roughly stable in scale across the 2 epochs."
