#!/bin/bash
#SBATCH --job-name=combo_eg1_cldice_pareto
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=48:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%A_%a.out
#SBATCH --error=logs/%x_%A_%a.err

# Pareto sweep over the clDice loss weight for ENetComboEG1 (COMBO_EXPERIMENT=EG1),
# 150 epochs / batch size 8, on a MIG GPU slice.
#
# 5 array tasks = 5 independent training runs, one per clDice weight below.
# weight=0.0 reproduces the plain Dice+CE loss exactly (nnUNetTrainerENetComboClDice
# with COMBO_CLDICE_WEIGHT=0 is mathematically identical to nnUNetTrainerENetCombo's
# default loss) -- keep it as the sanity-check anchor point for the sweep, separate
# from the existing labelsPr_ENetComboEG1 baseline (different trainer code path).
#
# After all 5 finish: run inference for each into its own labelsPr_<name>, then reuse
# analysis/compute_topology_metrics.py + analysis/preview_results.ipynb to score
# dice/purity/branch-consistency per weight and see where Dice-vs-connectivity
# actually trades off -- that comparison is the actual "Pareto front," this job
# only produces the checkpoints it's built from.
#
# NOTE: verify `--partition=gpu_mig` (and whether your cluster wants a
# `--gres=gpu:<slice>:1`-style request instead of plain `--gpus=1` for MIG) against
# `sinfo -o "%P %G"` on your cluster -- partition/gres naming for MIG slices is
# cluster-specific and this is a best-guess default, not a verified value.
# Same for --time: 48h is a guess for 150 epochs on a 1g.10gb-class slice (slower
# per-epoch than the gpu_a100 partition train.job uses) -- check actual throughput
# from this job's first few epochs and adjust for any future array in this family.

set -e

mkdir -p logs

WEIGHTS=(0.0 0.25 0.5 1.0 2.0)
COMBO_CLDICE_WEIGHT="${WEIGHTS[$SLURM_ARRAY_TASK_ID]}"
WEIGHT_TAG="w$(echo "$COMBO_CLDICE_WEIGHT" | tr '.' 'p')"   # e.g. 0.25 -> w0p25
RUN_NAME="nnUNetTrainerENetComboClDice_${WEIGHT_TAG}"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENetCombo / clDice trainer knobs ------------------------------------------
export COMBO_EXPERIMENT=EG1
export COMBO_EPOCHS=150
export COMBO_BATCH_SIZE=8
export COMBO_SAVE_EVERY=25          # checkpoint_latest.pth every 25 epochs, plus checkpoint_best/final as usual
export COMBO_CLDICE_WEIGHT
export COMBO_CLDICE_ITERS=3
export COMBO_OUTPUT_FOLDER="$nnUNet_results/Dataset501_ARCADE/${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${SLURM_ARRAY_TASK_ID}  (COMBO_CLDICE_WEIGHT=${COMBO_CLDICE_WEIGHT}, tag=${WEIGHT_TAG})"
echo "Output folder: ${COMBO_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

echo "=== Start ENetComboClDice training (EG1, weight=${COMBO_CLDICE_WEIGHT}) ==="
nnUNetv2_train 501 2d 0 -tr nnUNetTrainerENetComboClDice

echo "Training finished for ${RUN_NAME}."
