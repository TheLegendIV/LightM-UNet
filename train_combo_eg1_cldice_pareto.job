#!/bin/bash
#SBATCH --job-name=combo_eg1_cldice
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# One point in the clDice-weight Pareto sweep for ENetComboEG1 (COMBO_EXPERIMENT=EG1),
# 150 epochs / batch size 8, on a MIG GPU slice. Submit via
# submit_combo_eg1_cldice_pareto.sh, which fires one of these per weight in
# {0.0, 0.25, 0.5, 1.0, 2.0} -- weight=0.0 reproduces the plain Dice+CE loss
# exactly (nnUNetTrainerENetComboClDice with COMBO_CLDICE_WEIGHT=0 is
# mathematically identical to nnUNetTrainerENetCombo's default loss), kept as
# the sanity-check anchor point, separate from the existing
# labelsPr_ENetComboEG1 baseline (different trainer code path).
#
# --time is capped at 6h (cluster policy), which 150 epochs will not fit into
# on a MIG slice in one go -- see the self-chaining block below for how this
# job keeps resuming itself across multiple 6h slots until done.
#
# After it's done for all 5 weights: run inference for each into its own
# labelsPr_<name>, then reuse analysis/compute_topology_metrics.py +
# analysis/preview_results.ipynb to score dice/purity/branch-consistency per
# weight and see where Dice-vs-connectivity actually trades off -- that
# comparison is the actual "Pareto front," this job only produces the
# checkpoints it's built from.
#
# NOTE: verify `--partition=gpu_mig` (and whether your cluster wants a
# `--gres=gpu:<slice>:1`-style request instead of plain `--gpus=1` for MIG)
# against `sinfo -o "%P %G"` -- partition/gres naming for MIG slices is
# cluster-specific and this is a best-guess default, not a verified value.

set -e

mkdir -p logs

: "${COMBO_CLDICE_WEIGHT:?COMBO_CLDICE_WEIGHT is required -- submit via submit_combo_eg1_cldice_pareto.sh, or manually: sbatch --export=ALL,COMBO_CLDICE_WEIGHT=0.5,RESUBMIT_COUNT=0 train_combo_eg1_cldice_pareto.job}"
RESUBMIT_COUNT="${RESUBMIT_COUNT:-0}"
MAX_RESUBMITS=20   # 20 x 6h = 120h ceiling per weight -- plenty of margin for 150 epochs; lower it once you know real per-epoch time on a MIG slice

WEIGHT_TAG="w$(echo "$COMBO_CLDICE_WEIGHT" | tr '.' 'p')"    # e.g. 0.25 -> w0p25
RUN_NAME="nnUNetTrainerENetComboClDice_${WEIGHT_TAG}"
OUTPUT_FOLDER="$HOME/LightM-UNet/data/nnUNet_results/Dataset501_ARCADE/${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "COMBO_CLDICE_WEIGHT=${COMBO_CLDICE_WEIGHT}  RESUBMIT_COUNT=${RESUBMIT_COUNT}/${MAX_RESUBMITS}"
echo "Output folder: ${OUTPUT_FOLDER}"

# -- Pre-emptively queue the next chunk BEFORE training starts ---------------
# This job's 6h time limit will very likely be shorter than 150 epochs needs
# on a MIG slice, so SLURM will usually SIGKILL this job mid-training rather
# than let it exit normally. A hard kill skips any "resubmit if not done yet"
# logic placed *after* the training command -- it would never run. Queuing
# the continuation now instead, dependent on this job ending (any reason),
# makes the chain robust to that. The continuation re-checks
# checkpoint_final.pth itself and exits almost immediately if training
# actually finished, so this is safe even once the run is done -- worst case
# it costs one near-instant extra queued job.
if [ ! -f "$OUTPUT_FOLDER/checkpoint_final.pth" ] && [ "$RESUBMIT_COUNT" -lt "$MAX_RESUBMITS" ]; then
    sbatch --dependency=afterany:"$SLURM_JOB_ID" \
           --export=ALL,COMBO_CLDICE_WEIGHT="$COMBO_CLDICE_WEIGHT",RESUBMIT_COUNT=$((RESUBMIT_COUNT + 1)) \
           "$0"
    echo "Queued continuation job (next RESUBMIT_COUNT=$((RESUBMIT_COUNT + 1)))."
elif [ -f "$OUTPUT_FOLDER/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already present -- not queuing a continuation."
else
    echo "WARNING: hit MAX_RESUBMITS=${MAX_RESUBMITS} without a checkpoint_final.pth. Not queuing further -- investigate before resubmitting manually."
fi

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENetCombo / clDice trainer knobs ------------------------------------------
export COMBO_EXPERIMENT=EG1
export COMBO_EPOCHS=150
export COMBO_BATCH_SIZE=8
export COMBO_SAVE_EVERY=25          # checkpoint_latest.pth every 25 epochs, plus checkpoint_best/final as usual
export COMBO_CLDICE_WEIGHT
export COMBO_CLDICE_ITERS=12        # covers p99 vessel width (~20-24px) measured on ARCADE GT; see cldice.py docstring
export COMBO_OUTPUT_FOLDER="$OUTPUT_FOLDER"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

echo "=== Start/resume ENetComboClDice training (EG1, weight=${COMBO_CLDICE_WEIGHT}) ==="
# --c is safe to always pass, even on the very first run with no checkpoint
# yet -- nnU-Net just prints a warning and starts fresh in that case.
nnUNetv2_train 501 2d 0 -tr nnUNetTrainerENetComboClDice --c

DONE=$( [ -f "$OUTPUT_FOLDER/checkpoint_final.pth" ] && echo yes || echo no )
echo "This chunk finished for ${RUN_NAME}. checkpoint_final.pth present: ${DONE}"
