#!/bin/bash
#SBATCH --job-name=enetoriginal_probabilities
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Re-run nnUNetTrainerENetOriginal inference on Dataset501_ARCADE's imagesTr
# (1200 train+val) and imagesTs (300 test), this time with
# --save_probabilities. The original labelsPr_ENetOriginal_Tr /
# labelsPr_ENetOriginal directories only have binarized PNG labels (any
# class > 0 = vessel) -- no softmax was kept from that run. Dataset508 (see
# dataset-prep/prepare_arcade_508_refinement_hard.py) needs the continuous
# per-pixel vessel probability as its second input channel instead of a
# hard 0/255 mask, since a real discontinuity in ENetOriginal's output is
# usually activation that dipped *below* 0.5, not activation that hit zero
# -- a binarized mask throws away exactly that near-threshold signal.
#
# --save_probabilities writes one <case>.npz (key "probabilities", shape
# (4, H, W) -- background/LAD/RCA/LCX, matching Dataset501's dataset.json)
# and <case>.pkl per case, alongside the (re-written, identical) <case>.png
# label -- safe to run into the same output directories the original
# binarized run used; nothing there is hand-edited.
#
# Vessel probability = 1 - probabilities[0] (background channel), computed
# at Dataset508-build time directly from these .npz files -- no separate
# combination/extraction step here.



DATASET_ID=501
DATASET_NAME="Dataset501_ARCADE"
TRAINER="nnUNetTrainerENetOriginal"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42

# -- nnU-Net paths --------------------------------------------------------------
# Matches train_small_enet_507.job / preprocess_dataset507.job's convention
# (nnUNET_results, not nnUNet_results) -- this is where
# nnUNetTrainerENetOriginal__nnUNetPlans__2d/fold_0/checkpoint_best.pth
# actually lives on this cluster.
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "Trainer: ${TRAINER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

CKPT_DIR="$nnUNet_results/${DATASET_NAME}/${TRAINER}__nnUNetPlans__2d"
if [ ! -f "$CKPT_DIR/fold_0/checkpoint_best.pth" ]; then
    echo "ERROR: checkpoint not found at $CKPT_DIR/fold_0/checkpoint_best.pth"
    exit 1
fi

echo "=== Predicting imagesTr (train+val, 1200 cases) with probabilities ==="
nnUNetv2_predict \
    -i "$nnUNet_raw/${DATASET_NAME}/imagesTr" \
    -o "$nnUNet_raw/${DATASET_NAME}/labelsPr_ENetOriginal_Tr" \
    -d "${DATASET_ID}" -c 2d -f 0 -tr "${TRAINER}" -p nnUNetPlans \
    --save_probabilities

echo "=== Predicting imagesTs (test, 300 cases) with probabilities ==="
nnUNetv2_predict \
    -i "$nnUNet_raw/${DATASET_NAME}/imagesTs" \
    -o "$nnUNet_raw/${DATASET_NAME}/labelsPr_ENetOriginal" \
    -d "${DATASET_ID}" -c 2d -f 0 -tr "${TRAINER}" -p nnUNetPlans \
    --save_probabilities

echo "=== Done. Verify .npz files landed alongside the .png labels: ==="
ls "$nnUNet_raw/${DATASET_NAME}/labelsPr_ENetOriginal_Tr" | grep -c '\.npz$'
ls "$nnUNet_raw/${DATASET_NAME}/labelsPr_ENetOriginal" | grep -c '\.npz$'
