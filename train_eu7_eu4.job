#!/bin/bash
#SBATCH --job-name=enet_upscaled_eu7_eu4_full
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --mem=120G
#SBATCH --time=72:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
# Full 150-epoch training for EU7 highres_flat and EU4 shallow_wide.
# ~10-15 min/epoch on A100 per config → 150 epochs x 2 configs ~ 50-75h; 72h limit.

set -e

mkdir -p logs

module purge
module load 2023
module load CUDA/12.1.1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

OUTPUT_ROOT="$HOME/LightM-UNet/data/nnUNET_results/ENetUpscaled_full_e150"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Working dir: $(pwd)"
echo "Conda env: $CONDA_PREFIX"

echo "=== GPU info ==="
nvidia-smi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

# Shared training settings
export ENETUSC_EPOCHS=150
export ENETUSC_BATCH_SIZE=8
export ENETUSC_DISABLE_CHECKPOINTING=0
export ENETUSC_SKIP_FINAL_VALIDATION=0
export ENETUSC_SKIP_ARCH_PLOT=1
export ENETUSC_ASYM_STAGE3=0

# --- EU7 highres_flat ---
echo "=== EU7 highres_flat (24,96,144,144,256) ==="
export ENETUSC_CHANNELS="24,96,144,144,256"
export ENETUSC_OUTPUT_FOLDER="$OUTPUT_ROOT/EU7_highres_flat/fold_0"
mkdir -p "$ENETUSC_OUTPUT_FOLDER"
nnUNetv2_train 501 2d 0 -tr nnUNetTrainerENetUpscaled
echo "=== EU7 done at $(date) ==="

# --- EU4 shallow_wide ---
echo "=== EU4 shallow_wide (20,96,96,144,256) ==="
export ENETUSC_CHANNELS="20,96,96,144,256"
export ENETUSC_OUTPUT_FOLDER="$OUTPUT_ROOT/EU4_shallow_wide/fold_0"
mkdir -p "$ENETUSC_OUTPUT_FOLDER"
nnUNetv2_train 501 2d 0 -tr nnUNetTrainerENetUpscaled
echo "=== EU4 done at $(date) ==="

echo "=== Both configs finished at $(date) ==="
echo "Checkpoints saved to:"
echo "  $OUTPUT_ROOT/EU7_highres_flat/fold_0/checkpoint_best.pth"
echo "  $OUTPUT_ROOT/EU7_highres_flat/fold_0/checkpoint_final.pth"
echo "  $OUTPUT_ROOT/EU4_shallow_wide/fold_0/checkpoint_best.pth"
echo "  $OUTPUT_ROOT/EU4_shallow_wide/fold_0/checkpoint_final.pth"
