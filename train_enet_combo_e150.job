#!/bin/bash
#SBATCH --job-name=enet_combo_e150
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --gpus=1
#SBATCH --partition=gpu_mig
#SBATCH --time=36:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err
# Full 150-epoch training for the ENetCombo skip x context cross product
# (see nnunetv2/nets/ENetCombo.py for the full rationale):
#   EG1  E1 (residual 4x)      + G3 (Mamba stage3)
#   EG2  E1 (residual 4x)      + UAS2 (stage2 +2 blocks)
#   EG3  E1 (residual 4x)      + G3 + UAS2
#   AG1  A3 (raw skip 4x+5x)   + G3 (Mamba stage3)
#   AG2  A3 (raw skip 4x+5x)   + UAS2 (stage2 +2 blocks)
#   AG3  A3 (raw skip 4x+5x)   + G3 + UAS2
# --keep-checkpoints is required: run_enet_combo_pareto.py disables ALL
# checkpointing by default (checkpoint_best.pth, checkpoint_final.pth, the
# periodic checkpoint_latest.pth -- all of it, see nnUNetTrainer.save_checkpoint)
# unless that flag is passed. Final validation runs by default
# (COMBO_SKIP_FINAL_VALIDATION=0), no flag needed for that part.
# summary.csv (with momentum/acceleration per config, matching the other
# pareto scripts) and pareto_final_dice.png / pareto_momentum.png are written
# after every experiment, so a timeout still leaves usable partial results.
# Experiments run sequentially. If the job times out before all six finish,
# re-run with --configs <remaining IDs>.

set -e

mkdir -p logs

module purge
module load 2023
module load CUDA/12.1.1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Working dir: $(pwd)"
echo "Conda env: $CONDA_PREFIX"

echo "=== GPU info ==="
nvidia-smi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

OUTPUT_ROOT="$HOME/LightM-UNet/data/nnUNET_results/enet_combo_e150"

python pareto_experiments/run_enet_combo_pareto.py \
    --configs EG1 EG2 EG3 AG1 AG2 AG3 \
    --epochs 150 \
    --batch-size 8 \
    --output-root "$OUTPUT_ROOT" \
    --keep-checkpoints \
    --overwrite

echo "=== Training done at $(date) ==="
echo "Results: $OUTPUT_ROOT/summary.csv"
echo "Plots:   $OUTPUT_ROOT/pareto_final_dice.png"
echo "         $OUTPUT_ROOT/pareto_momentum.png"
