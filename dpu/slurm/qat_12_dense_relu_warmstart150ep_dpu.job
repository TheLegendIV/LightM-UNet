#!/bin/bash
#SBATCH --job-name=qat_dpu_12_dense_relu_warmstart150ep_ft15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Vitis AI (pytorch_nndct) QAT fine-tune of the S12 dense-ReLU warm-start model for the ZCU104 DPU.
# Mirrors the Brevitas QAT jobs: 15 epochs x 250 iters, batch 12, AdamW 1e-3 / wd 1e-2, poly LR, seed 1234.
# Output: $OUT/{best,final}/{deployable.pth,quant_info.json} + history.json.
# Then, on the WSL box: copy $OUT to $DPU_WORK_ROOT/<job>/qat/ and run
#   ./run_flow.sh <job> qat_export && ./run_flow.sh <job> qat_compile
# Env: build once with dpu/slurm/setup_qat_env.sh.

ENV_DIR="$HOME/conda-envs/vitisqat"
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
FP32_CHECKPOINT="$HOME/LightM-UNet/data/nnUNet_results/${DATASET_NAME}/nnUNetTrainerENet_12_dense_relu_warmstart150ep__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
DATA="$HOME/LightM-UNet/data/nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans_2d"
BUILD_DIR="$HOME/LightM-UNet/dpu/builds/12_dense_relu_warmstart150ep_fp32"
OUT="$HOME/LightM-UNet/dpu/qat_runs/12_dense_relu_warmstart150ep_ft15ep"

mkdir -p logs

module purge
module load 2023

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$ENV_DIR"

unset PYTHONPATH
export PYTHONHASHSEED=42

echo "=== Job info ==="
echo "Host: $(hostname)"; echo "Date: $(date)"
echo "OUT=$OUT"

[ -f "$FP32_CHECKPOINT" ] || { echo "ERROR: FP32 checkpoint not found: $FP32_CHECKPOINT" >&2; exit 1; }
[ -d "$DATA" ] || { echo "ERROR: preprocessed data not found: $DATA" >&2; exit 1; }
nvidia-smi

cd "$BUILD_DIR"
python qat_train.py \
    --data "$DATA" \
    --fp32-checkpoint "$FP32_CHECKPOINT" \
    --out "$OUT" \
    --epochs 15 --iters 250 --val-iters 50 --batch-size 12 \
    --lr 1e-3 --workers 8 --device cuda

echo "=== Done: $(date) ==="
ls -la "$OUT/best" "$OUT/final"
