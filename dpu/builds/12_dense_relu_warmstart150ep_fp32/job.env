# S12 dense ReLU warm-start (150ep) FP32 -> Vitis AI 3.0 DPU (ZCU104, 2x B4096).
# Source checkpoint is a real PyTorch zip that was saved with a .txt extension.
CHECKPOINT=/mnt/c/DEV/repos/LightM-UNet/data/nnUNet_results/Dataset509_ARCADE_1x1_4c/nnUNetTrainerENet_12_dense_relu_warmstart150ep__nnUNetPlans__2d/fold_0/checkpoint_best.pth.txt
CALIB_DIR=/mnt/c/DEV/repos/LightM-UNet/data/nnUNet_raw/Dataset509_ARCADE_1x1_4c/imagesTs
LABEL_DIR=/mnt/c/DEV/repos/LightM-UNet/data/nnUNet_raw/Dataset509_ARCADE_1x1_4c/labelsTs
# Only the 300 test images exist locally: model.py calibrates on every 3rd (100) and
# evaluates on a disjoint subset, so the quantized accuracy is not measured on calibration data.

# N,C,H,W: Dataset509 patch size is 512x512, 1 grayscale channel.
INPUT_SHAPE=1,1,512,512

BOARD_IP=192.168.1.10          # ZCU104 address (static; PC Ethernet 5 = 192.168.1.9)
