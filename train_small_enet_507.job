#!/bin/bash
#SBATCH --job-name=small_enet_507
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# nnUNetTrainerSmallENet on Dataset507_ARCADE_refinement -- kept deliberately
# simple: plain Dice+BCE+clDice at default settings, no VesselGapTransform.
# Dataset507's own patch mix (dataset-prep/prepare_arcade_507_refinement.py,
# see dataset-prep/README_507_refinement.md) already targets ENetOriginal's
# *real observed* discontinuities directly, so layering synthetic gap
# augmentation on top would double up on the same failure mode rather than
# adding new signal -- left off here; SMALLENET_GAP_AUG=1 still works if you
# want to test the combination later.
#
# Dataset507 declares 2 input channels (grayscale, predicted_mask) for the
# *planned* two-channel refinement network -- SmallENet only supports 1, so
# SMALLENET_INPUT_CHANNELS=0 below tells it to use just the grayscale
# channel and ignore predicted_mask (see nnUNetTrainerSmallENet.py). This is
# a baseline run: does training on Dataset507's discontinuity-focused patch
# mix alone (no access to the first-pass prediction) already help, before
# building the real 2-channel refinement net that gets to see both?
#
# Batch size 362 carried over from Dataset504/505/506 (same 85x85 patch
# dimensions feed the same nnU-Net planner sizing heuristic) -- not yet
# confirmed for Dataset507 specifically; the plan+preprocess step below will
# print the actual planned value, check it before assuming this is right.
#
# IMPORTANT: SMALLENET_SKIP_FINAL_VALIDATION=1 is required -- see
# nnUNetTrainerSmallENet.py.



RUN_NAME="nnUNetTrainerSmallENet"
DATASET_ID=507
DATASET_NAME="Dataset507_ARCADE_refinement"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

# -- SmallENet trainer knobs ----------------------------------------------------
export SMALLENET_EPOCHS=150
export SMALLENET_BATCH_SIZE=362
export SMALLENET_SAVE_EVERY=25
export SMALLENET_SKIP_FINAL_VALIDATION=1   # required -- see note above
export SMALLENET_INPUT_CHANNELS=0          # grayscale only; Dataset507 also has predicted_mask (channel 1)
export SMALLENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "SMALLENET_EPOCHS=${SMALLENET_EPOCHS}"
echo "SMALLENET_BATCH_SIZE=${SMALLENET_BATCH_SIZE}"
echo "SMALLENET_INPUT_CHANNELS=${SMALLENET_INPUT_CHANNELS}"
echo "Output folder: ${SMALLENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Plan + preprocess (skipped if already done -- or run preprocess_dataset507.job first on a CPU-only partition) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Start SmallENet training (batch_size=${SMALLENET_BATCH_SIZE}, epochs=${SMALLENET_EPOCHS}) ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerSmallENet

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."
