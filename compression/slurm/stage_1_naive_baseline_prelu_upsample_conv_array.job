#!/bin/bash
#SBATCH --job-name=stage_1_naive_baseline_prelu_upsample_conv
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-3
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 1_naive_baseline_prelu_upsample_conv -- third point on Stage 1's
# activation/decoder grid, alongside archive/stage_1_naive_baseline_array.job
# (ReLU + upsample_conv) and stage_1_naive_baseline_prelu_maxunpool_array.job
# (PReLU + max_unpool). This array isolates PReLU alone: same bilinear
# upsample_conv decoder as the original ReLU curve, only
# ENET_USE_PRELU=1 changes. Answers whether Stage 2's "+PReLU wins" result
# (measured as a single-op flip off the U4 reference) holds across the whole
# width grid, and does so without the max_unpool decoder's indices/patch-size
# coupling confounding the activation comparison.
#
# Unlike stage_1_naive_baseline_prelu_maxunpool_array.job (which dropped its
# own Baseline task since Stage 0 already has a full-width PReLU+max_unpool
# anchor to borrow), no full-width PReLU+upsample_conv point exists anywhere
# in results.csv -- so this array keeps its own Baseline task, using the same
# 5-tuple, f_i-included form as the original ReLU+upsample_conv curve's own
# Baseline (archive/stage_1_naive_baseline_array.job), not Stage 0's 6-tuple
# split-stage2/3 paper form:
#   0: Baseline -- CHANNELS=16,64,128,64,16
#   1: U2       -- CHANNELS=8,32,64,32,8
#   2: U8       -- CHANNELS=4,8,16,8,4
#   3: U16      -- CHANNELS=4,4,8,4,4
#
# U4 deliberately excluded from this array -- it's already in results.csv as
# nnUNetTrainerENet_2_special_ops_prelu (Stage 2's "+PReLU" probe): same
# CHANNELS=4,16,32,16,4, decoder_type=upsample_conv, use_prelu=1,
# dilated/asymmetric/strided=1, dsc=0 as this array would produce. Only
# difference is that row predates the ENET_SEED=0 convention (unseeded, like
# the rest of the original Stage 1/2 arrays) -- not worth re-training just to
# seed it. Stage 1's harvest (nas_stages.py) should point at that existing
# config_name for this curve's U4 point rather than expecting a
# "1_naive_baseline_prelu_upsample_conv_U4" row.
#
# Everything else stays at the same ENet-paper-native values as both sibling
# curves: dilated/asymmetric/strided=1, dsc=0, context_pattern=default,
# bottlenecks=4,8,8,2,1.
#
# Writes to a DISTINCT stage/config_name ("1_naive_baseline_prelu_upsample_
# conv") so this does NOT overwrite/collide with either sibling curve's rows
# in compression/results.csv.
#
# ENET_SEED=0 set explicitly, same as the prelu_maxunpool array (see that
# job's own comment on the original stage_1/stage_2 arrays being unseeded).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(Baseline U2 U8 U16)
TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"

case "$CONFIG_NAME" in
  Baseline) CHANNELS="16,64,128,64,16" ;;
  U2)       CHANNELS="8,32,64,32,8" ;;
  U8)       CHANNELS="4,8,16,8,4" ;;
  U16)      CHANNELS="4,4,8,4,4" ;;
esac

RUN_NAME="1_naive_baseline_prelu_upsample_conv_${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- PReLU + upsample_conv (bilinear) ------------------
export ENET_CHANNELS="${CHANNELS}"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_CONTEXT_PATTERN="default"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=1
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_USE_PRELU=1
export ENET_SEED=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS} ENET_BOTTLENECKS=${ENET_BOTTLENECKS}"
echo "ENET_DECODER_TYPE=${ENET_DECODER_TYPE} ENET_USE_PRELU=${ENET_USE_PRELU} ENET_SEED=${ENET_SEED}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 1_naive_baseline_prelu_upsample_conv \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --seed "${ENET_SEED}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
