#!/bin/bash
#SBATCH --job-name=stage_6_dscnoprojdense_variants
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-1
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 6 -- two follow-up variants of S5-DscNoProjDense (nnUNetTrainerENet_
# 5_1_dscnoprojection_dense_dilation, dice=0.8105, our best-Dice compressed
# config), off the same U4 reference cell / policy as stage_5
# (CHANNELS=4,16,32,16,4, BOTTLENECKS=4,8,8,2,1 native unless noted,
# DECODER_TYPE=upsample_conv, USE_PRELU=1, USE_ASYMMETRIC=0, dilated/
# strided=1, dsc_no_projection=1 always on for both tasks here).
#
#   0: 6_1_reg_interleaved -- ENET_CONTEXT_PATTERN=dense_dilation_reg_
#      interleaved, ENET_BOTTLENECKS=4,11,11,2,1 (stage2/3 depth bumped
#      from native 8 to 11 to fit the full pattern without truncating the
#      trailing reg -- see ENet.py's DENSE_DILATION_REG_INTERLEAVED_PATTERN
#      module comment). Inserts a full (non-DSC, projected) RegularBottleneck
#      before AND after each (2,4,8,16) dilation cycle -- reg,2,4,8,16,reg,
#      2,4,8,16,reg -- instead of dsc_no_projection's usual "every slot is
#      DSCNoProjectionBottleneck" uniform treatment. Rationale: dsc_no_
#      projection mixes channels only through each block's single 1x1
#      pointwise conv, at full channel width, no squeeze anywhere; a plain
#      RegularBottleneck's reduce -> 3x3 -> expand does spatial and channel
#      mixing AS ONE joint (non-factored) operation, reintroduced
#      periodically to test whether that recovers accuracy the all-DSC
#      version leaves on the table. Costs real params (30488 -> 37880,
#      +24%) from the 3 added reduce/expand projection pairs plus the
#      extra depth -- MACs go up too, unlike every other schedule change
#      in stage_4/5, which were all dilation-only and free.
#   1: 6_2_schedule_a -- ENET_CONTEXT_PATTERN=dense_dilation_a, native
#      bottlenecks (4,8,8,2,1) unchanged. Swaps the (2,4,8,16) schedule for
#      the fully pairwise-coprime (1,5,7,17) from
#      compression/gridding_investigation/ -- that investigation's
#      impulse-response test found (2,4,8,16) reaches only 25.8% of its own
#      61x61 receptive field (textbook gridding checkerboard, every
#      consecutive rate pair shares a factor of 2) vs. 87.3% for (1,5,7,17)
#      (near-solid fill). Same sum (30), same RF, same params/MACs as the
#      base config (30488, identical to S5-DscNoProjDense) -- dilation rate
#      doesn't change kernel size or channel count, so this is a
#      structural-only change at zero added cost. The investigation's own
#      empirical FFT test on S5-DscNoProjDense's real errors didn't find a
#      clear periodic signature (inconclusive, not confirmed) -- this task
#      is the direct "does it matter in practice" follow-up.
#
# Both variants confirmed via local docker smoke test (nnUNetv2_train, 1
# epoch/2 iterations against Dataset509_ARCADE_1x1_4c) to build and train
# without error, and structurally verified in ENet.py's own self-test
# ("Stage-6 DscNoProjDense-variant self-test": exact per-block dilation
# rates for 6_2, exact per-slot bottleneck CLASS -- RegularBottleneck vs.
# DSCNoProjectionBottleneck -- and presence/absence of a reduce/expand
# projection for 6_1, not just "it built").

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(6_1_reg_interleaved 6_2_schedule_a)
CHANNELS_ARR=("4,16,32,16,4" "4,16,32,16,4")
BOTTLENECKS_ARR=("4,11,11,2,1" "4,8,8,2,1")
CONTEXT_PATTERN_ARR=(dense_dilation_reg_interleaved dense_dilation_a)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S5-DscNoProjDense reference, one thing changed ---
export ENET_CHANNELS="${CHANNELS_ARR[$TASK_ID]}"
export ENET_BOTTLENECKS="${BOTTLENECKS_ARR[$TASK_ID]}"
export ENET_CONTEXT_PATTERN="${CONTEXT_PATTERN_ARR[$TASK_ID]}"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_DSC_NO_PROJECTION=1
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS} ENET_BOTTLENECKS=${ENET_BOTTLENECKS} ENET_CONTEXT_PATTERN=${ENET_CONTEXT_PATTERN}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 6_dscnoprojdense_variants \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
