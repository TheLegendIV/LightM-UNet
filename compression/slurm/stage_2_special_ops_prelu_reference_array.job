#!/bin/bash
#SBATCH --job-name=stage_2_special_ops_prelu_reference
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-1
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 2_special_ops_prelu_reference -- re-run of the two remaining
# archive/stage_2_special_ops_array.job probes (no_dilated, no_asymmetric),
# but referenced against PReLU + upsample_conv at U4
# (nnUNetTrainerENet_2_special_ops_prelu) instead of the original ReLU + U4
# reference -- keeps the thesis's ablation story consistent with the
# ENet-paper-native activation (PReLU) rather than mixing a ReLU-referenced
# ablation into a narrative that otherwise treats PReLU as the carried-
# forward choice from here on (see nas_stages.py stage_2's own note on the
# ops_ablation.png reference marker).
#
# The third original probe (max_unpool) is deliberately NOT re-run here --
# nnUNetTrainerENet_1_naive_baseline_prelu_maxunpool_U4 (from
# stage_1_naive_baseline_prelu_maxunpool_array.job) is already EXACTLY this
# probe: same CHANNELS=4,16,32,16,4, dilated=1/asymmetric=1/strided=1/dsc=0/
# context_pattern=default/prelu=1 as the PReLU+upsample_conv reference,
# decoder_type flipped to max_unpool, dice=0.590484. Confirmed by diffing
# both rows' ops_flags -- re-training it here would be a duplicate row under
# a different config_name for no reason.
#
# Each task below flips exactly ONE knob off nnUNetTrainerENet_2_special_ops_
# prelu's own settings (CHANNELS=4,16,32,16,4, BOTTLENECKS=4,8,8,2,1,
# DECODER_TYPE=upsample_conv, USE_PRELU=1, strided=1, dsc=0,
# context_pattern=default, dilated=1, asymmetric=1):
#   0: no_dilated    -- USE_DILATED 1->0
#   1: no_asymmetric -- USE_ASYMMETRIC 1->0
#
# ENET_SEED=0 set explicitly (the original stage_2_special_ops_array.job
# predates that convention and was unseeded -- these two new runs at least
# are reproducible).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

# name, use_dilated, use_asymmetric
NAMES=(no_dilated no_asymmetric)
USE_DILATED=(0 1)
USE_ASYMMETRIC=(1 0)

TASK_ID=${SLURM_ARRAY_TASK_ID}
RUN_NAME="2_special_ops_prelu_${NAMES[$TASK_ID]}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- PReLU+upsample_conv U4 reference, one flag flipped
# per task -----------------------------------------------------------------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_CONTEXT_PATTERN="default"
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_USE_PRELU=1
export ENET_USE_DILATED="${USE_DILATED[$TASK_ID]}"
export ENET_USE_ASYMMETRIC="${USE_ASYMMETRIC[$TASK_ID]}"
export ENET_SEED=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_USE_DILATED=${ENET_USE_DILATED} ENET_USE_ASYMMETRIC=${ENET_USE_ASYMMETRIC} ENET_USE_PRELU=${ENET_USE_PRELU}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 2_special_ops_prelu \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --seed "${ENET_SEED}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
