#!/bin/bash
#SBATCH --job-name=stage_12_dense_relu_bilinear_upsample_256
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# S12-dense BILINEAR decoder (decoder_type "upsample_conv": F.interpolate(mode="bilinear", align_corners=False) on the main branch of up4/up5, no skip_resize_conv) trained at 256x256
# (Dataset510_ARCADE_256_4c) -- the FP32 source for the 256x256 bilinear hardware net: LayerQuantEnetFINN realises that bilinear resize as a frozen nearest upsample + frozen depthwise
# 3x3 tent-kernel conv (INT8, `_nearest_depthwise_bilinear_kernel`: UpsampleNearestNeighbour -> FMPadding -> depthwise SWG -> VVAU_hls), modelled in the analytical flow as
# MILP/analytical/up_bottleneck.py `skip_dw=True`. The FP32 training net has the real bilinear op; nothing about the hardware substitute is learned (it is parameter-free).
#
# Why this job exists: the bilinear S12 net (nnUNetTrainerENet_12_dense_relu / _warmstart150ep, upsample_conv, 24,261-parameter family) was only ever trained at 512x512 (Dataset509);
# the 256x256 runs so far (Dataset510) are the nearest_conv_upsample and nearest_upsample families. The 512 weights do not transfer to the 256 data as they are (the 256 dataset is a
# half-scale version of the 512 images; see stage_12_dense_relu_nearest_upsample_256.job: mean dice 0.12 without retraining), so this net has to be trained on Dataset510.
#
# Recipe: byte-for-byte stage_12_dense_relu_nearest_upsample_256.job (CHANNELS 4,16,32,16,4, bottlenecks 4,8,8,2,1, ENET_CONTEXT_PATTERN "dense_dilation", plain ReLU, dense dilated convs)
# with ONE difference, ENET_DECODER_TYPE="upsample_conv" instead of "nearest_upsample" (so every other weight shape is identical and the warm start transfers completely):
#   * DATASET: Dataset510_ARCADE_256_4c (256x256 patches, batch 49 from its own plans) instead of Dataset509.
#   * WARM START from the 512 bilinear net's best checkpoint (nnUNetTrainerENet_12_dense_relu_warmstart150ep, dice 0.7954; fully convolutional so the name+shape state_dict transfer is
#     complete) via -pretrained_weights, only on a genuinely fresh start (a resubmitted run uses --c, as every job here).
#   * ENET_LR is NOT lowered: the data scale changes (2x), so the trainer's default peak LR (1e-3) with a fresh 150-epoch PolyLR schedule is used (as the nearest_upsample_256 job).
# ENET_CONTEXT_PATTERN stays "dense_dilation" (dilations 2,4,8,16 repeated over the 16 context blocks), the pattern of the nearest net and of the S12 U4 analytical artifacts.
#
# Output: $nnUNet_results/Dataset510_ARCADE_256_4c/nnUNetTrainerENet_12_dense_relu_bilinear_upsample_256__nnUNetPlans__2d/fold_0/checkpoint_best.pth
# Next step: calibration + the 15-epoch QAT fine-tune on LayerQuantEnetFINN with decoder_type="upsample_conv" (frozen depthwise tent kernel), uniform INT6 per-site bits from the analytical
# bilinear artifact (MILP/artifacts/S12_dense_256_u4_bilinear_analytical_v1/); the calibrate / QAT scripts for this net are still to be written.

DATASET_ID=510
DATASET_NAME="Dataset510_ARCADE_256_4c"
SOURCE_DATASET_NAME="Dataset509_ARCADE_1x1_4c"      # where the 512x512 FP32 bilinear warm-start net lives
TRAINER_CLASS="nnUNetTrainerENet"
RUN_NAME="12_dense_relu_bilinear_upsample_256"
SOURCE_NET_NAME="nnUNetTrainerENet_12_dense_relu_warmstart150ep"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- the nearest_upsample_256 recipe with the bilinear decoder ----------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=0
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SEPARABLE_DILATED=0
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

SOURCE_CHECKPOINT="$nnUNet_results/${SOURCE_DATASET_NAME}/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (warm-started from ${SOURCE_CHECKPOINT}, default LR, ${ENET_EPOCHS} epochs)"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== Checking source checkpoint exists ==="
if [ ! -f "$SOURCE_CHECKPOINT" ]; then
    echo "ERROR: source checkpoint not found: $SOURCE_CHECKPOINT -- the 512x512 stage_12_dense_relu_warmstart150ep.job must have run first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh, warm-started from ${SOURCE_NET_NAME}): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" -pretrained_weights "${SOURCE_CHECKPOINT}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real 150-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME 150-epoch LR schedule from epoch ${CURRENT_EPOCH} -- pretrained_weights NOT re-applied, this run's own progress already carries the warm-started weights) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Archiving checkpoints + logs to \$HOME/models (only once the real 150-epoch schedule is complete) ==="
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0

    echo "=== Collecting results into compression/results.csv ==="
    cd "$HOME/LightM-UNet"
    python compression/collect_results.py \
        --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
        --stage "12_dense_relu_bilinear_upsample_256" \
        --dataset-name "${DATASET_NAME}" \
        --dataset-id "${DATASET_ID}" \
        --channels "${ENET_CHANNELS}" \
        --bottlenecks "${ENET_BOTTLENECKS}" \
        --decoder-type "${ENET_DECODER_TYPE}" \
        --use-dilated "${ENET_USE_DILATED}" \
        --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
        --use-strided "${ENET_USE_STRIDED}" \
        --use-dsc "${ENET_USE_DSC}" \
        --separable-dilated "${ENET_SEPARABLE_DILATED}" \
        --context-pattern "${ENET_CONTEXT_PATTERN}" \
        --use-prelu "${ENET_USE_PRELU}" \
        --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
        --trainer-class "${TRAINER_CLASS}"
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping archive/collect_results.py (resubmit to continue training)."
fi

echo "Done: ${RUN_NAME}."
