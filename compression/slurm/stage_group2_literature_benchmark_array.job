#!/bin/bash
#SBATCH --job-name=stage_group2_literature_benchmark
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --array=0-5
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Group 2 (literature benchmark on ARCADE, external reference) -- all at
# 4-class ARCADE (Dataset509_ARCADE_1x1_4c, 512x512), 150 epochs, fixed
# seed. 3h/submission -- resumable via the same checkpoint_final/
# checkpoint_latest self-healing + `--c` continue pattern as
# stage_group1_enet_family_array.job / stage_erfnet_u4.job (only archives
# once the real 150-epoch schedule is complete; resubmit the array to keep
# making progress otherwise).
#
# NONE of these six are wired into compression/collect_results.py's
# --model-class choices yet (enet/erfnet/mobilenetv2/mobilenetv3 only) --
# every task here trains + checkpoints + archives but SKIPS
# collect_results.py (deliberate: "train now, collect later").
#
#   0: nnUNetv2 (plain) -- the real, unmodified self-configuring nnU-Net
#      baseline (PlainConvUNet). Uses the new nnUNetTrainerPlainSeeded
#      (adds only PLAIN_EPOCHS/PLAIN_SEED/etc. hooks, build_network_
#      architecture untouched) since the base nnUNetTrainer class itself
#      has no such hooks -- everything else here subclasses from it.
#   1: ResNet101-nnUNetv2 (torchvision ResNet101 encoder + this repo's own
#      decoder). Uses the *pretrained* variant (nnUNetTrainerTVResNet101UNet,
#      ImageNet weights) -- confirmed reachable/downloadable from this
#      cluster's network in the lightmunet_dev smoke test.
#   2: LightM-UNet (official Mamba-UNet, this repo's own namesake/origin
#      point). 1,342,949 params (in=1,out=4, this trainer's existing default
#      init_filters=16/blocks_down=[1,2,2,4]/blocks_up=[1,1,1] -- predates
#      this session). Paper's own Table 2 (2D, Montgomery&Shenzhen, closest
#      analog to our own 2D setup) reports 1.09M for its own 2D config --
#      block depths already match exactly (paper: RVM-layer counts 1,2,2 in
#      the three Encoder Blocks + 4 in the Bottleneck Block = our own
#      blocks_down=[1,2,2,4]), so the residual gap is most likely the
#      paper's own 2D run using a different init_filters/channel-width
#      config than this trainer's default -- kept as-is per explicit
#      instruction, not changed to chase the paper's exact figure.
#   3: LM-UNet (Xu et al. 2026, not open source -- reimplemented from
#      lmunet.pdf; channels (12,20,32,44,64,72) verified to measure
#      525,706 params vs. the paper's reported 0.527M).
#   4: BSCNet (mmcv/mmseg stripped, backbone verbatim + this repo's own
#      FCNHead-shaped decode head, no auxiliary/deep-supervision heads).
#   5: UNext (full, NOT the smaller UNext_S -- verified 1.472M params
#      matches the literature survey's "UNeXt-S" entry, which was actually
#      measured on this larger config).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
EPOCHS_TARGET=150

TASK_ID=${SLURM_ARRAY_TASK_ID}

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- Per-task config ------------------------------------------------------------
case "$TASK_ID" in
  0)
    RUN_NAME="nnunetv2_plain"
    TRAINER_CLASS="nnUNetTrainerPlainSeeded"
    SEED_VAR="PLAIN_SEED"
    EPOCHS_VAR="PLAIN_EPOCHS"
    OUTFOLDER_VAR="PLAIN_OUTPUT_FOLDER"
    ;;
  1)
    RUN_NAME="resnet101_pretrained"
    TRAINER_CLASS="nnUNetTrainerTVResNet101UNet"
    SEED_VAR="RESNET101_SEED"
    EPOCHS_VAR="RESNET101_EPOCHS"
    OUTFOLDER_VAR="RESNET101_OUTPUT_FOLDER"
    ;;
  2)
    RUN_NAME="lightmunet"
    TRAINER_CLASS="nnUNetTrainerLightMUNet"
    SEED_VAR="LIGHTMUNET_SEED"
    EPOCHS_VAR="LIGHTMUNET_EPOCHS"
    OUTFOLDER_VAR="LIGHTMUNET_OUTPUT_FOLDER"
    ;;
  3)
    RUN_NAME="lmunet"
    TRAINER_CLASS="nnUNetTrainerLMUNet"
    SEED_VAR="LMUNET_SEED"
    EPOCHS_VAR="LMUNET_EPOCHS"
    OUTFOLDER_VAR="LMUNET_OUTPUT_FOLDER"
    export LMUNET_CHANNELS="12,20,32,44,64,72"
    ;;
  4)
    RUN_NAME="bscnet"
    TRAINER_CLASS="nnUNetTrainerBSCNet"
    SEED_VAR="BSCNET_SEED"
    EPOCHS_VAR="BSCNET_EPOCHS"
    OUTFOLDER_VAR="BSCNET_OUTPUT_FOLDER"
    ;;
  5)
    RUN_NAME="unext"
    TRAINER_CLASS="nnUNetTrainerUNeXtS"
    SEED_VAR="UNEXTS_SEED"
    EPOCHS_VAR="UNEXTS_EPOCHS"
    OUTFOLDER_VAR="UNEXTS_OUTPUT_FOLDER"
    ;;
esac

OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"
export "${SEED_VAR}=0"
export "${EPOCHS_VAR}=${EPOCHS_TARGET}"
export "${OUTFOLDER_VAR}=${OUTPUT_FOLDER}"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME} (${TRAINER_CLASS}), seed via ${SEED_VAR}=0"
echo "Output folder: ${OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${OUTPUT_FOLDER}/checkpoint_final.pth" "${OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${OUTPUT_FOLDER}/checkpoint_latest.pth" "${OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${EPOCHS_TARGET}."
    if [ "$CURRENT_EPOCH" -ge "$EPOCHS_TARGET" ]; then
        echo "Real ${EPOCHS_TARGET}-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME ${EPOCHS_TARGET}-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's time budget)."

echo "=== Archiving checkpoints + logs to \$HOME/models (only once the real epoch schedule is complete) ==="
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$EPOCHS_TARGET" ]; then
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
    echo "No collect_results.py support yet for ${TRAINER_CLASS} -- checkpoint archived, results collection deferred."
else
    echo "Only at epoch ${FINAL_EPOCH}/${EPOCHS_TARGET} -- skipping archive (resubmit this array to continue training)."
fi
