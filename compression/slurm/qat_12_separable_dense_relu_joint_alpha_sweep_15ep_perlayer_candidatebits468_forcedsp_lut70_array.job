#!/bin/bash
#SBATCH --job-name=qat_12_separable_dense_relu_joint_alpha_sweep_15ep_perlayer_candidatebits468_forcedsp_lut70
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Real 15-epoch QAT fine-tune for the PER-LAYER joint bits+folding ILP sweep
# at a HARD 70% LUT cap under the NEW forced-DSP derating (compression/hawq/
# finn_cost_model.py's force_dsp=True path, fit from two real S12 8-way
# forced-DSP OOC builds -- see compression/hawq/fit_forced_dsp_derating.py
# and finn_cost_model.py's own module comment on _FORCED_DSP_LUT_FACTOR).
# compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/, real
# non-force-serial folding search, predecessor-corrected act sensitivity --
# see joint_bits_folding_ilp_perlayer.py's and layer_topology.py's own
# module docstrings. Same 5 alpha points and --max-latency-ms 1000
# --clock-mhz 100 hard-capped convention as every earlier alpha sweep this
# session, but --hard-lut-fraction 0.7 --force-dsp instead of the earlier
# default (1.0, auto-resType) regime -- deploys via LayerQuantENet (one
# independent bit-width per quantizer SITE, not per whole block).
#
# ENET_SEED is set to the SAME fixed value across every alpha in this array
# (not left unset/random) -- calibrate_12_separable_dense_relu_perlayer.py's
# own calibrate() ALSO reseeds torch's global RNG from --calibration-seed
# (default 0, same for every alpha here) right before its calibration loop.
# Both matter for the same reason: DownsamplingBottleneck/
# UpsamplingBottleneck's nn.Dropout2d is active whenever the model is in
# .train() mode (both during Brevitas calibration_mode AND during real QAT
# training), so leaving the RNG unseeded means each alpha's dropout
# trajectory differs from every other alpha's purely by accident of process
# startup entropy -- a real, measured, non-negligible confound (this exact
# mechanism, uncontrolled, produced an apparent ~0.041 dice gap between two
# architectures that turned out to be numerically IDENTICAL once the RNG was
# controlled for -- see compression/post-quantization/
# verify_layerquant_matches_combined.py). Fixing ENET_SEED here means any
# real dice difference observed ACROSS this alpha sweep reflects the alpha
# dial itself, not which random dropout draws each alpha happened to get.
#
# THREE steps per task, same as the earlier (non-forced-DSP) per-layer sweep:
#   STEP 0: expand_layer_bits.py   (per-conv-layer bits -> per-site bits)
#   STEP 1: calibrate_12_separable_dense_relu_perlayer.py (warm-start + real calibration, seeded)
#   STEP 2: real QAT fine-tuning (nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer, seeded)
QAT_EPOCHS=15
ENET_FREEZE_BN=0
ENET_CHECKPOINT_EVERY=5
ENET_SEED=1234
CALIBRATION_SEED=0

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_12_separable_dense_relu"

LAYER_BITS_ILP_ARR=(
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_folding_12_separable_dense_relu_joint_alpha0.0_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_folding_12_separable_dense_relu_joint_alpha0.25_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_folding_12_separable_dense_relu_joint_alpha0.5_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_folding_12_separable_dense_relu_joint_alpha0.75_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_folding_12_separable_dense_relu_joint_alpha1.0_candidatebits468_forcedsp_lut70.json"
)
LAYER_BITS_SITES_ARR=(
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_SITES_12_separable_dense_relu_joint_alpha0.0_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_SITES_12_separable_dense_relu_joint_alpha0.25_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_SITES_12_separable_dense_relu_joint_alpha0.5_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_SITES_12_separable_dense_relu_joint_alpha0.75_candidatebits468_forcedsp_lut70.json"
    "compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/layer_bits_SITES_12_separable_dense_relu_joint_alpha1.0_candidatebits468_forcedsp_lut70.json"
)
CALIBRATED_NET_ARR=(
    nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer_joint_alpha0.0_candidatebits468_forcedsp_lut70_calibrated
    nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer_joint_alpha0.25_candidatebits468_forcedsp_lut70_calibrated
    nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer_joint_alpha0.5_candidatebits468_forcedsp_lut70_calibrated
    nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer_joint_alpha0.75_candidatebits468_forcedsp_lut70_calibrated
    nnUNetTrainerLayerQuantENet_12_separable_dense_relu_perlayer_joint_alpha1.0_candidatebits468_forcedsp_lut70_calibrated
)
RUN_NAME_ARR=(
    12_separable_dense_relu_joint_alpha0.0_perlayer_candidatebits468_forcedsp_lut70_ft15ep
    12_separable_dense_relu_joint_alpha0.25_perlayer_candidatebits468_forcedsp_lut70_ft15ep
    12_separable_dense_relu_joint_alpha0.5_perlayer_candidatebits468_forcedsp_lut70_ft15ep
    12_separable_dense_relu_joint_alpha0.75_perlayer_candidatebits468_forcedsp_lut70_ft15ep
    12_separable_dense_relu_joint_alpha1.0_perlayer_candidatebits468_forcedsp_lut70_ft15ep
)

TASK_ID=${SLURM_ARRAY_TASK_ID}
LAYER_BITS_ILP_FILE="${LAYER_BITS_ILP_ARR[$TASK_ID]}"
LAYER_BITS_SITES_FILE="${LAYER_BITS_SITES_ARR[$TASK_ID]}"
CALIBRATED_NET_NAME="${CALIBRATED_NET_ARR[$TASK_ID]}"
RUN_NAME="${RUN_NAME_ARR[$TASK_ID]}"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "LAYER_BITS_ILP_FILE=${LAYER_BITS_ILP_FILE}"
echo "QAT_EPOCHS=${QAT_EPOCHS}"
echo "ENET_FREEZE_BN=${ENET_FREEZE_BN}"
echo "ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}"
echo "ENET_SEED=${ENET_SEED} (same across every alpha in this array -- see header comment)"
echo "CALIBRATION_SEED=${CALIBRATION_SEED} (same across every alpha in this array)"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT -- run stage_12_separable_dense_relu.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

if [ ! -f "$LAYER_BITS_ILP_FILE" ]; then
    echo "ERROR: $LAYER_BITS_ILP_FILE not found -- run the per-layer candidate-bits={4,6,8} --hard-lut-fraction 0.7 " \
         "--force-dsp joint ILP sweep first (see compression/hawq/artifacts/S12_ILP_outputs_perlayer_forcedsp_lut70/run_args.json " \
         "for the exact command)." >&2
    exit 1
fi

echo "=== STEP 0: expand per-conv-layer bits to LayerQuantENet's full per-site schema (skip if already done) ==="
if [ -f "$LAYER_BITS_SITES_FILE" ]; then
    echo "Site-level bits file already exists at ${LAYER_BITS_SITES_FILE} -- skipping expansion."
else
    python compression/hawq/expand_layer_bits.py \
        --config config_12_separable_dense_relu \
        --ilp-result "${LAYER_BITS_ILP_FILE}" \
        --out-file "${LAYER_BITS_SITES_FILE}"
fi

CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== STEP 1: calibrate (warm-start from the real FP32 checkpoint; skip if already done) ==="
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists at ${CALIBRATED_CHECKPOINT} -- skipping calibration."
else
    python compression/post-quantization/calibrate_12_separable_dense_relu_perlayer.py \
        --source-net-name "${FP32_SOURCE_NET_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --layer-bits-file "${LAYER_BITS_SITES_FILE}" \
        --calibration-seed "${CALIBRATION_SEED}"
fi

echo "=== STEP 2: real QAT fine-tuning, complete ${QAT_EPOCHS}-epoch schedule ==="
export ENET_LAYER_BITS_FILE="$HOME/LightM-UNet/${LAYER_BITS_SITES_FILE}"
export ENET_PRETRAINED_CHECKPOINT="${CALIBRATED_CHECKPOINT}"
export ENET_EPOCHS=${QAT_EPOCHS}
export ENET_FREEZE_BN=${ENET_FREEZE_BN}
export ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}
export ENET_SEED=${ENET_SEED}
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real ${QAT_EPOCHS}-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME ${QAT_EPOCHS}-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real ${QAT_EPOCHS}-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    NET_NAME="${TRAINER_CLASS}_${RUN_NAME}"
    COMMON_ARGS=(
        --net-name "${NET_NAME}"
        --dataset-name "${DATASET_NAME}"
        --dataset-id "${DATASET_ID}"
        --channels 4,16,32,16,4
        --bottlenecks 4,8,8,2,1
        --decoder-type upsample_conv
        --use-asymmetric 0
        --context-pattern dense_dilation
        --separable-dilated 1
        --quant-bits 8
        --trainer-class "${TRAINER_CLASS}"
    )
    # --quant-bits 8 is a deliberate placeholder -- this row's REAL per-site
    # bits AND folding live in $LAYER_BITS_SITES_FILE / $LAYER_BITS_ILP_FILE,
    # not this row's own params/flops/bops columns, same convention every
    # other per-block/per-layer job's own collect_results.py call uses.
    BEST_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_best.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
    echo "DIAGNOSTIC: checkpoint_best.pth is at epoch ${BEST_EPOCH}, checkpoint_final.pth is at epoch ${FINAL_EPOCH} (target ${ENET_EPOCHS})."
    if [ "$BEST_EPOCH" != "$FINAL_EPOCH" ]; then
        echo "NOTE: 'best' EMA dice plateaued before the run finished (last improved at epoch ${BEST_EPOCH}, training reached ${FINAL_EPOCH}) -- the standard row below reports epoch-${BEST_EPOCH} weights, not epoch-${FINAL_EPOCH}. This is real, not a failure -- the epoch5/10/15 rows below are NOT affected (fixed snapshots, independent of EMA-best tracking)."
    fi
    PREDICTION_DIR="$nnUNet_raw/${DATASET_NAME}/labelsPr_${NET_NAME}"

    echo "--- Evaluating checkpoint_best.pth (standard 'best EMA dice' row) ---"
    rm -rf "${PREDICTION_DIR}"
    python compression/collect_results.py "${COMMON_ARGS[@]}" \
        --stage "${RUN_NAME}" --checkpoint-name checkpoint_best.pth

    for EP in 5 10 15; do
        CKPT="${ENET_OUTPUT_FOLDER}/checkpoint_epoch${EP}.pth"
        if [ -f "$CKPT" ]; then
            echo "--- Evaluating checkpoint_epoch${EP}.pth ---"
            rm -rf "${PREDICTION_DIR}"
            python compression/collect_results.py "${COMMON_ARGS[@]}" \
                --stage "${RUN_NAME}_epoch${EP}" --config-name "${NET_NAME}_epoch${EP}" \
                --checkpoint-name "checkpoint_epoch${EP}.pth"
        else
            echo "checkpoint_epoch${EP}.pth not found at ${ENET_OUTPUT_FOLDER} -- skipping that row."
        fi
    done
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
