#!/bin/bash
#SBATCH --job-name=qat_12_dense_relu_nearest_conv_upsample_alpha1.0_lut50_bram20_dsp90_maxlat200ms_ft15ep
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --mem=120G
#SBATCH --time=00:45:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# QAT fine-tune for the S12_dense_nn_upsample_v1 per-layer joint bits+folding
# ILP solve (MILP/artifacts/S12_dense_nn_upsample_v1) on the
# nearest_conv_upsample FP32 checkpoint (nnUNetTrainerENet_12_dense_relu_
# nearest_conv_upsample, dice=0.7779, 143/150 epochs -- the decoder-resize
# ablation that follows nearest-neighbor resize with a learned 3x3 conv+BN+
# act on the skip/main branch, see enet/nnunetv2/nets/ENet.py's
# UpsamplingBottleneck and MILP/config_12_dense_relu_nearest_conv_upsample.py).
#
# ILP solve used here: candidate bits {4,6,8}, force-dsp, alpha=1.0 (PURE
# sensitivity objective -- latency_term's own weight is zero) with
# --max-latency-ms 200 as a REAL HARD CONSTRAINT (epsilon-constraint form:
# minimize accuracy-sensitivity subject to cycles <= a real latency budget,
# not a soft alpha-weighted blend). Hard caps: LUT 50%, BRAM 20% (tightened
# from the v1 solve's own 30%), DSP 90%.
#
# BRAM 20% + latency 150ms is INFEASIBLE (confirmed by direct search --
# BRAM 20% alone needs latency >~155ms even at alpha=0/pure-latency/LUT+DSP
# fully relaxed) -- 200ms is the real, achievable target at this tighter
# BRAM budget. Solve landed at LUT 46.3%/BRAM 19.9%/DSP 34.5%/latency
# 199.60ms, avg weight bits 5.53 (down from the v1/BRAM30 solve's own 6.64
# -- the tighter BRAM budget forces more aggressive weight quantization
# broadly, not just at the join), avg act bits 6.47.
#
# --max-join-imbalance-ratio 1.1 is ALSO real here (not the v1 solve's own
# unconstrained plan): up4/up5's own residual-add join (skip_resize_conv.0
# vs. expand.0 -- the new skip-branch conv vs. the residual branch's own
# last op) was left badly skewed by the unconstrained per-layer solve (6.0x
# at up4, 3.0x at up5 -- exactly what forces a real, UNPRICED FIFO in
# actual FINN hardware, see finn_cost_model.py's own "still not covered:
# FIFOs" note). Binding it in the ILP (finn_milp.py's own
# --max-join-imbalance-ratio, re-added specifically because THIS join is
# genuinely detected by layer_topology.compute_predecessor_map -- confirmed
# regular4.0.reduce.0 -> ['up4.skip_resize_conv.0', 'up4.expand.0'], unlike
# most plain RegularBottleneck residual adds which get pruned by that map's
# own one-branch-point cap) let the solver jointly retune BOTH branches
# together, landing both joins at an EXACT 1.00 ratio -- cheaper than a
# looser 1.5 target turned out to be, a real discrete-folding-lattice
# effect (see this artifact's own run history), and dramatically cheaper
# than a post-hoc single-branch-only patch (which independently verified to
# breach the original LUT cap by fixing the join without any joint
# re-optimization -- see MILP/rebalance_join_folding.py).
#
# See MILP/artifacts/S12_dense_nn_upsample_v1/run_args.json + summary.csv
# for the exact ILP solve commands.
#
# THIS ARCHITECTURE NEEDED A REAL CODE EXTENSION FIRST: LayerQuantENet.py
# (the Brevitas-quantized architecture QAT actually trains) only implemented
# the "upsample_conv" decoder path before this job's own prerequisite work --
# LayerQuantUpsamplingBottleneck gained a quantized skip_resize_conv
# (QuantConv2d(3x3) + BatchNorm2d + quantized activation) mirroring ENet.py's
# own addition, and MILP/expand_layer_bits.py gained the matching
# skip_resize_conv.2 act-site resolution rule (local, downstream of this
# same block's own skip_resize_conv.0 -- same pattern as reduce.2<-reduce.0/
# up.2<-up.0). Both verified end-to-end (forward+backward pass, site
# discovery, expand_layer_bits.py -> calibration -- all real, not just unit
# tests) before this job was written.
#
# THREE steps, same as every other per-layer forced-DSP job:
#   STEP 0: expand_layer_bits.py   (per-conv-layer bits -> per-site bits; already done for this artifact, skip-if-exists)
#   STEP 1: calibrate_12_dense_relu_nearest_conv_upsample_perlayer.py (warm-start + real calibration, seeded)
#   STEP 2: real QAT fine-tuning (nnUNetTrainerLayerQuantENet_12_dense_relu_nearest_conv_upsample_perlayer, seeded)
QAT_EPOCHS=15
ENET_FREEZE_BN=0
ENET_CHECKPOINT_EVERY=5
ENET_SEED=1234
CALIBRATION_SEED=0

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerLayerQuantENet_12_dense_relu_nearest_conv_upsample_perlayer"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_12_dense_relu_nearest_conv_upsample"

LAYER_BITS_ILP_FILE="MILP/artifacts/S12_dense_nn_upsample_v1/layer_bits_folding_12_dense_relu_nearest_conv_upsample_joint_alpha1.0_candidatebits468_forcedsp_lut50_bram20_dsp90_maxlat200ms_joinbalance1.1.json"
LAYER_BITS_SITES_FILE="MILP/artifacts/S12_dense_nn_upsample_v1/layer_bits_SITES_12_dense_relu_nearest_conv_upsample_joint_alpha1.0_candidatebits468_forcedsp_lut50_bram20_dsp90_maxlat200ms_joinbalance1.1.json"
CALIBRATED_NET_NAME="nnUNetTrainerLayerQuantENet_12_dense_relu_nearest_conv_upsample_joint_alpha1.0_candidatebits468_lut50_bram20_dsp90_maxlat200ms_joinbalance1.1_calibrated"
RUN_NAME="12_dense_relu_nearest_conv_upsample_joint_alpha1.0_perlayer_candidatebits468_forcedsp_lut50_bram20_dsp90_maxlat200ms_joinbalance1.1_ft15ep"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "RUN_NAME=${RUN_NAME}"
echo "LAYER_BITS_ILP_FILE=${LAYER_BITS_ILP_FILE}"
echo "QAT_EPOCHS=${QAT_EPOCHS}"
echo "ENET_FREEZE_BN=${ENET_FREEZE_BN}"
echo "ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}"
echo "ENET_SEED=${ENET_SEED}"
echo "CALIBRATION_SEED=${CALIBRATION_SEED}"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT -- run stage_12_dense_relu_nearest_conv_upsample.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

if [ ! -f "$LAYER_BITS_ILP_FILE" ]; then
    echo "ERROR: $LAYER_BITS_ILP_FILE not found -- run the per-layer candidate-bits={4,6,8} alpha=1.0 " \
         "--hard-lut-fraction 0.5 --hard-bram-fraction 0.2 --hard-dsp-fraction 0.9 --max-latency-ms 200 " \
         "--max-join-imbalance-ratio 1.1 --force-dsp joint ILP solve first (see " \
         "MILP/artifacts/S12_dense_nn_upsample_v1/run_args.json for the exact command)." >&2
    exit 1
fi

echo "=== STEP 0: expand per-conv-layer bits to LayerQuantENet's full per-site schema (skip if already done) ==="
if [ -f "$LAYER_BITS_SITES_FILE" ]; then
    echo "Site-level bits file already exists at ${LAYER_BITS_SITES_FILE} -- skipping expansion."
else
    python MILP/expand_layer_bits.py \
        --config config_12_dense_relu_nearest_conv_upsample \
        --ilp-result "${LAYER_BITS_ILP_FILE}" \
        --out-file "${LAYER_BITS_SITES_FILE}"
fi

CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== STEP 1: calibrate (warm-start from the real FP32 checkpoint; skip if already done) ==="
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists at ${CALIBRATED_CHECKPOINT} -- skipping calibration."
else
    python compression/post-quantization/calibrate_12_dense_relu_nearest_conv_upsample_perlayer.py \
        --source-net-name "${FP32_SOURCE_NET_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --layer-bits-file "${LAYER_BITS_SITES_FILE}" \
        --calibration-seed "${CALIBRATION_SEED}"
fi

echo "=== STEP 2: real QAT fine-tuning, complete ${QAT_EPOCHS}-epoch schedule ==="
export ENET_LAYER_BITS_FILE="$HOME/LightM-UNet/${LAYER_BITS_SITES_FILE}"
export ENET_PRETRAINED_CHECKPOINT="${CALIBRATED_CHECKPOINT}"
export ENET_EPOCHS=${QAT_EPOCHS}
export ENET_FREEZE_BN=${ENET_FREEZE_BN}
export ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}
export ENET_SEED=${ENET_SEED}
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real ${QAT_EPOCHS}-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME ${QAT_EPOCHS}-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real ${QAT_EPOCHS}-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    NET_NAME="${TRAINER_CLASS}_${RUN_NAME}"
    COMMON_ARGS=(
        --net-name "${NET_NAME}"
        --dataset-name "${DATASET_NAME}"
        --dataset-id "${DATASET_ID}"
        --channels 4,16,32,16,4
        --bottlenecks 4,8,8,2,1
        --decoder-type nearest_conv_upsample
        --use-asymmetric 0
        --context-pattern dense_dilation
        --separable-dilated 0
        --quant-bits 32
        --trainer-class "${TRAINER_CLASS}"
    )
    # --quant-bits 32 (not 8) -- see the warmstart150ep_perlayer job's own
    # comment for why: this repo's own QuantENet.py (used ONLY for
    # collect_results.py's own params/flops/bops estimate, never for the
    # real trained model) doesn't need to be exercised here -- 32 skips
    # that branch entirely and uses the plain FP32 ENet count instead
    # (ENet.py already supports decoder_type=nearest_conv_upsample). This
    # row's REAL per-site bits AND folding live in $LAYER_BITS_SITES_FILE /
    # $LAYER_BITS_ILP_FILE, not this row's own params/flops/bops columns.
    BEST_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_best.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
    echo "DIAGNOSTIC: checkpoint_best.pth is at epoch ${BEST_EPOCH}, checkpoint_final.pth is at epoch ${FINAL_EPOCH} (target ${ENET_EPOCHS})."
    if [ "$BEST_EPOCH" != "$FINAL_EPOCH" ]; then
        echo "NOTE: 'best' EMA dice plateaued before the run finished (last improved at epoch ${BEST_EPOCH}, training reached ${FINAL_EPOCH}) -- the standard row below reports epoch-${BEST_EPOCH} weights, not epoch-${FINAL_EPOCH}. This is real, not a failure -- the epoch5/10/15 rows below are NOT affected (fixed snapshots, independent of EMA-best tracking)."
    fi
    PREDICTION_DIR="$nnUNet_raw/${DATASET_NAME}/labelsPr_${NET_NAME}"

    echo "--- Evaluating checkpoint_best.pth (standard 'best EMA dice' row) ---"
    rm -rf "${PREDICTION_DIR}"
    python compression/collect_results.py "${COMMON_ARGS[@]}" \
        --stage "${RUN_NAME}" --checkpoint-name checkpoint_best.pth

    for EP in 5 10 15; do
        CKPT="${ENET_OUTPUT_FOLDER}/checkpoint_epoch${EP}.pth"
        if [ -f "$CKPT" ]; then
            echo "--- Evaluating checkpoint_epoch${EP}.pth ---"
            rm -rf "${PREDICTION_DIR}"
            python compression/collect_results.py "${COMMON_ARGS[@]}" \
                --stage "${RUN_NAME}_epoch${EP}" --config-name "${NET_NAME}_epoch${EP}" \
                --checkpoint-name "checkpoint_epoch${EP}.pth"
        else
            echo "checkpoint_epoch${EP}.pth not found at ${ENET_OUTPUT_FOLDER} -- skipping that row."
        fi
    done
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
