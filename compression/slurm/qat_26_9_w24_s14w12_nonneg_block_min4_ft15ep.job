#!/bin/bash
#SBATCH --job-name=qat_26_9_w24_nonneg_block_min4_ft15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Real per-block HAWQ QAT for nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block
# -- MIN4 (candidates {4,8} only, no 2-bit anywhere) joint ILP bit
# assignment (block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint_min4.json,
# an ilp_search.py --joint --candidate-bits 4,8 output -- verified: weight
# bits in {4,8}, act bits in {4,8}, status Optimal), NOT the unconstrained
# acc1x_joint.json the earlier diagnostic job used (that one allows 2-bit).
# Same real trained per-block nonneg_block scalar slope map
# (compression/post-quantization/slope_maps/26_9_w24_s14w12_
# nonneg_block.json) -- i.e. real leaky/PReLU activation via
# QuantDecomposedLeakyAct (prelu_variant="nonneg_block"), NOT plain ReLU
# (this architecture is NOT part of the S8.2/CombinedQuantENet family,
# which always forces ReLU -- it uses its own dedicated QuantENet26_9_w24_
# s14w12_nonneg_block / nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_
# blockBlock, both already existing this session).
#
# UNLIKE that earlier diagnostic job (ENET_EPOCHS=150 + ENET_MAX_EPOCHS_
# TO_RUN=15, training-log-only, no collect_results.py -- a peek to check
# whether QAT recovers a normal trajectory at all), this is a genuine
# COMPLETE 15-epoch PolyLR schedule (ENET_EPOCHS=15, LR decays to ~0 by
# epoch 15) WITH collect_results.py at the end -- same convention as this
# session's other "_ft15ep" jobs (e.g. qat_8_2_relu_no_reg_w16_manual_
# ft15ep.job, qat_26_10_w24_s14w12_relu_min4_ft15ep.job). Same self-healing
# checkpoint_final.pth-vs-checkpoint_latest.pth promotion too, in case a
# single 2-hour submission isn't enough.
#
# WARM START: 26_9_w24_s14w12_nonneg_block's own real FP32 checkpoint_best.pth
# (same as the diagnostic job -- no separate PTQ/calibration step needed,
# this trainer builds the quantized model + transfers real weights directly
# from the FP32 checkpoint via ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_
# CHECKPOINT, see nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock.py).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_9_w24_s14w12_nonneg_block_qat_min4_ft15ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"

SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint_min4.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
export ENET_EPOCHS=15
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (genuine complete ${ENET_EPOCHS}-epoch schedule)"
echo "Block bits file:       ${ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real 15-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME 15-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real 15-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    python compression/collect_results.py \
        --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
        --stage 26_9_w24_s14w12_nonneg_block_min4_ft15ep \
        --dataset-name "${DATASET_NAME}" \
        --dataset-id "${DATASET_ID}" \
        --channels 4,12,24,12,4 \
        --bottlenecks 4,8,8,2,1 \
        --decoder-type upsample_conv \
        --use-dilated 1 \
        --use-asymmetric 0 \
        --use-strided 1 \
        --use-dsc 0 \
        --separable-dilated 1 \
        --context-pattern dense_dilation \
        --use-prelu 1 \
        --prelu-variant nonneg_block \
        --dsc-no-projection 0 \
        --quant-bits 8 \
        --trainer-class "${TRAINER_CLASS}"
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
