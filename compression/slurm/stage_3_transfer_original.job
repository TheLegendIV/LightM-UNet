#!/bin/bash
#SBATCH --job-name=stage_3_transfer_original
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Stage 3_transfer_original -- fine-tune "ENet original" on the new 4-class
# objective (LAD/RCA/LCX/LM on Dataset509_ARCADE_1x1_4c), warm-started from
# its own binary-run checkpoint (data/nnUNet_results/Dataset501_ARCADE/
# nnUNetTrainerENet_Original__nnUNetPlans__2d/fold_0/checkpoint_best.pth --
# see compression/slurm/archive/train_enet_original.job, the retired job
# that produced it) instead of training from scratch.
#
# Rebuilds ENet_Original's EXACT architecture (channels=16,64,128,64,16,
# native bottlenecks, decoder_type=max_unpool, PReLU ON, dilated/asymmetric/
# strided=1, dsc=0 -- train_enet_original.job only set ENET_CHANNELS, so
# every other knob is nnUNetTrainerENet's own default) so every weight
# tensor lines up in shape with the checkpoint EXCEPT the final output
# layer (ENet.py's `self.final`, a ConvTranspose2d: 2 channels for
# Dataset501's background/vessel vs 5 for Dataset509's
# background/LAD/RCA/LCX/LM). nnU-Net's own -pretrained_weights loader
# (enet/nnunetv2/run/load_pretrained_weights.py) only auto-skips keys named
# '.seg_layers.' by default and hard-crashes on any other shape mismatch --
# ENet's `final.weight`/`final.bias` aren't named that, so that loader was
# patched this session to skip (warn, not crash) ANY shape-mismatched or
# missing key, not just '.seg_layers.' ones. Net effect here: every
# pretrained weight loads except `final.weight`/`final.bias`, which stay at
# their fresh random init and get trained from scratch on top of the
# otherwise-pretrained backbone.
#
# Single run, not an array -- one architecture, one checkpoint, one dataset.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
PRETRAINED_DATASET_NAME="Dataset501_ARCADE"
PRETRAINED_CKPT="$HOME/LightM-UNet/data/nnUNet_results/${PRETRAINED_DATASET_NAME}/nnUNetTrainerENet_Original__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

RUN_NAME="3_transfer_original"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- ENet_Original's exact architecture ---------------
export ENET_CHANNELS="16,64,128,64,16"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_CONTEXT_PATTERN="default"
export ENET_DECODER_TYPE="max_unpool"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=1
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_USE_PRELU=1
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS} ENET_DECODER_TYPE=${ENET_DECODER_TYPE} ENET_USE_PRELU=${ENET_USE_PRELU}"
echo "Pretrained checkpoint: ${PRETRAINED_CKPT}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking pretrained checkpoint exists ==="
if [ ! -f "${PRETRAINED_CKPT}" ]; then
    echo "ERROR: pretrained checkpoint not found at ${PRETRAINED_CKPT}" >&2
    exit 1
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} (warm-started from ${PRETRAINED_CKPT}) ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" -pretrained_weights "${PRETRAINED_CKPT}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 3_transfer_original \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
