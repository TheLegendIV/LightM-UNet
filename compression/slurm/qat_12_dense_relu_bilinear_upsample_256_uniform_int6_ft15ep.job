#!/bin/bash
#SBATCH --job-name=qat_12_dense_relu_bilinear_upsample_256_uniform_int6_ft15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# QAT fine-tune at UNIFORM INT6 (every conv layer weights 6-bit, every activation 6-bit) of the S12-dense BILINEAR-decoder net (decoder_type "upsample_conv": F.interpolate(bilinear) on the
# main branch of up4/up5) at 256x256 (Dataset510_ARCADE_256_4c), trained directly on LayerQuantEnetFINN (the network that actually gets exported). In LayerQuantEnetFINN the bilinear resize is
# the frozen nearest upsample + frozen depthwise 3x3 INT8 tent-kernel conv (`_nearest_depthwise_bilinear_kernel`: UpsampleNearestNeighbour -> FMPadding -> depthwise SWG -> VVAU_hls), which
# has no quantizer site and no trainable parameter; the analytical model of this net is MILP/artifacts/S12_dense_256_u4_bilinear_analytical_v1/.
#
# FP32 source: nnUNetTrainerENet_12_dense_relu_bilinear_upsample_256 (stage_12_dense_relu_bilinear_upsample_256.job, 150 epochs, from scratch on Dataset510). Bits:
# MILP/artifacts/S12_dense_bilinear_256_uniform_int6_v1/layer_bits_SITES_uniform_int6.json -- a per-SITE file (85 weight / 110 activation sites, all 6), so no MILP solve and no
# expand_layer_bits.py step; folding is not part of QAT (accuracy depends only on bits).
#
# Pipeline (the nearest_upsample_256 job's, but FINN-class from STEP 1 on):
#   STEP 1: calibrate_12_dense_relu_bilinear_upsample_256_perlayer.py --model-class finn: LayerQuantEnetFINN.from_pretrained(FP32 checkpoint) + real calibration on all 1200 preprocessed images
#           (reflect-padded to a multiple of 8), seeded. The saved checkpoint is the INT6 LayerQuantEnetFINN checkpoint (the PTQ result and the warm start of STEP 2).
#   STEP 2: QAT fine-tune nnUNetTrainerLayerQuantEnetFINN_12_dense_relu_bilinear_upsample_256_perlayer (15 epochs, seeded)
#   STEP 3: collect_results.py on checkpoint_best.pth ONLY (no epoch5/10/15 rows).
QAT_EPOCHS=15
ENET_FREEZE_BN=0
ENET_CHECKPOINT_EVERY=5
ENET_SEED=1234
CALIBRATION_SEED=0

DATASET_ID=510
DATASET_NAME="Dataset510_ARCADE_256_4c"
TRAINER_CLASS="nnUNetTrainerLayerQuantEnetFINN_12_dense_relu_bilinear_upsample_256_perlayer"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_12_dense_relu_bilinear_upsample_256"

LAYER_BITS_SITES_FILE="MILP/artifacts/S12_dense_bilinear_256_uniform_int6_v1/layer_bits_SITES_uniform_int6.json"
CALIBRATED_NET_NAME="nnUNetTrainerLayerQuantEnetFINN_12_dense_relu_bilinear_upsample_256_uniform_int6_calibrated"
RUN_NAME="12_dense_relu_bilinear_upsample_256_uniform_int6_perlayer_ft15ep"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "RUN_NAME=${RUN_NAME}"
echo "LAYER_BITS_SITES_FILE=${LAYER_BITS_SITES_FILE}"
echo "QAT_EPOCHS=${QAT_EPOCHS}"
echo "ENET_FREEZE_BN=${ENET_FREEZE_BN}"
echo "ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}"
echo "ENET_SEED=${ENET_SEED}"
echo "CALIBRATION_SEED=${CALIBRATION_SEED}"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT -- run stage_12_dense_relu_bilinear_upsample_256.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

if [ ! -f "$LAYER_BITS_SITES_FILE" ]; then
    echo "ERROR: $LAYER_BITS_SITES_FILE not found -- it ships with the repo (MILP/artifacts/S12_dense_bilinear_256_uniform_int6_v1/); git pull on the HPC." >&2
    exit 1
fi

CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== STEP 1: calibrate LayerQuantEnetFINN at uniform INT6 (warm-start from the real FP32 checkpoint; skip if already done) ==="
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists at ${CALIBRATED_CHECKPOINT} -- skipping calibration."
else
    python compression/post-quantization/calibrate_12_dense_relu_bilinear_upsample_256_perlayer.py \
        --model-class finn \
        --source-net-name "${FP32_SOURCE_NET_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --layer-bits-file "${LAYER_BITS_SITES_FILE}" \
        --n-calibration-images 1200 --pad-to-multiple 8 \
        --calibration-seed "${CALIBRATION_SEED}"
fi

echo "=== STEP 2: QAT fine-tuning of LayerQuantEnetFINN directly (warm start: the INT6 FINN checkpoint of STEP 1), complete ${QAT_EPOCHS}-epoch schedule ==="
export ENET_LAYER_BITS_FILE="$HOME/LightM-UNet/${LAYER_BITS_SITES_FILE}"
export ENET_PRETRAINED_CHECKPOINT="${CALIBRATED_CHECKPOINT}"
export ENET_EPOCHS=${QAT_EPOCHS}
export ENET_FREEZE_BN=${ENET_FREEZE_BN}
export ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}
export ENET_SEED=${ENET_SEED}
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real ${QAT_EPOCHS}-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME ${QAT_EPOCHS}-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real ${QAT_EPOCHS}-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    NET_NAME="${TRAINER_CLASS}_${RUN_NAME}"
    COMMON_ARGS=(
        --net-name "${NET_NAME}"
        --dataset-name "${DATASET_NAME}"
        --dataset-id "${DATASET_ID}"
        --channels 4,16,32,16,4
        --bottlenecks 4,8,8,2,1
        --decoder-type upsample_conv
        --use-asymmetric 0
        --use-prelu 0
        --context-pattern dense_dilation
        --separable-dilated 0
        --quant-bits 32
        --trainer-class "${TRAINER_CLASS}"
    )
    BEST_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_best.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
    echo "DIAGNOSTIC: checkpoint_best.pth is at epoch ${BEST_EPOCH}, checkpoint_final.pth is at epoch ${FINAL_EPOCH} (target ${ENET_EPOCHS})."
    if [ "$BEST_EPOCH" != "$FINAL_EPOCH" ]; then
        echo "NOTE: 'best' EMA dice plateaued before the run finished (last improved at epoch ${BEST_EPOCH}, training reached ${FINAL_EPOCH}) -- the row below reports epoch-${BEST_EPOCH} weights, not epoch-${FINAL_EPOCH}. This is real, not a failure."
    fi
    PREDICTION_DIR="$nnUNet_raw/${DATASET_NAME}/labelsPr_${NET_NAME}"

    echo "--- Evaluating checkpoint_best.pth (standard 'best EMA dice' row) ---"
    rm -rf "${PREDICTION_DIR}"
    python compression/collect_results.py "${COMMON_ARGS[@]}" \
        --stage "${RUN_NAME}" --checkpoint-name checkpoint_best.pth

else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
