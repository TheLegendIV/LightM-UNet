#!/bin/bash
#SBATCH --job-name=qat_26_9_noquant_full150_finetune_full150
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=20:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# FULL-SCALE version of the noquant_ablation_5ep -> noquant_finetune_
# internal8_15ep diagnostic pair, at real 150-epoch length instead of
# 5+15 epochs. Real per-epoch pace observed on HPC (this same partition,
# same architecture) is ~186-190s/epoch (full iteration count, no
# ENET_ITERATIONS_PER_EPOCH override, same as every real diagnostic job
# this session) -- so each 150-epoch phase alone is realistically ~8 hours,
# ~16 hours combined + a few minutes for calibration. --time=20:00:00
# above is a rough estimate with margin, NOT a guarantee this partition
# allows a job that long -- CHECK YOUR OWN gpu_mig QUEUE LIMITS before
# submitting; MIG partitions on many clusters cap well under this. If it
# gets killed by the scheduler mid-phase, RESUBMIT THIS EXACT SAME SCRIPT
# -- every phase below checks for its own checkpoint_final.pth (skip if
# done) or checkpoint_latest.pth (resume via nnU-Net's own --c flag) before
# deciding to start fresh, so re-running picks up exactly where it left
# off, no manual bookkeeping needed. Consider splitting this into two
# separate sbatch submissions (one per phase, with a
# --dependency=afterok:<phase1_jobid> chain) if a single ~16-20h
# allocation isn't available on your queue.
#
# PHASE A (150 real epochs): the winning recipe from the noquant_ablation_
# 5ep job (real held-out dice=0.537 at 5 epochs, still climbing) --
# quant_enabled=False the ENTIRE run (QuantDecomposedLeakyAct's own fake-
# quant chain bypassed entirely at every leaky site, pure float
# LeakyReLU(x,a)=a*x+(1-a)*ReLU(x) -- see QuantENet.py's own docstring),
# zeroed slope map (every block starts at alpha=0.0, genuinely NUMERICALLY
# identical to ReLU at epoch 0 since there's no quantization noise left to
# make that equivalence only algebraic), ALPHA_LR_SCALE=0.1 damping. SAME
# bit assignment as every stuck attempt on record (block_bits_26_9_w24_
# s14w12_nonneg_block_acc1x_joint.json, genuine 2-bit sites intact,
# UNCHANGED) -- unaffected either way since quant_enabled=False means the
# real per-block bits never actually get exercised during this phase's own
# training at all (they only matter starting Phase C).
#
# PHASE B (fast, no GPU-heavy compute): reconstruct a real
# QuantDecomposedLeakyAct-based model (internal_bit_width=8 for pre_quant/
# act_pos, out_quant unchanged at the real per-block bit-width) from Phase
# A's finished checkpoint, and CALIBRATE the newly-introduced pre_quant/
# act_pos/out_quant quantizers on real data (compression/post-quantization/
# calibrate_noquant_to_decomposed.py -- Brevitas calibration_mode(), ~64
# images, NO gradients). This step is NOT optional -- confirmed by direct
# local experiment that skipping it (loading the quant_enabled=False
# checkpoint straight into the real chain with zero calibration) produces
# 100% EMPTY predictions on every test case, since pre_quant/act_pos/
# out_quant's own scale was never touched during Phase A's forward passes.
#
# PHASE C (150 real epochs): a real fine-tuning CONTINUATION,
# quant_enabled=True (the real chain now genuinely active, real gradients
# flowing), internal_bit_width=8, warm-started from Phase B's calibrated
# checkpoint. Motivation: calibration alone was tested locally and found
# NOT sufficient on its own (real held-out eval after calibration-only:
# dice~0.028, dice_binary=0.141, ~996 predicted connected components/image
# -- real, non-empty signal, but extremely fragmented, since the network's
# weights were never exposed to ANY quantization noise at these sites
# during Phase A and calibration only sets a sane scale, it doesn't teach
# the weights to tolerate the resulting rounding the way real QAT gradient
# steps do). A 15-epoch diagnostic version of exactly this recovered 3 of 4
# classes into a healthy 0.10-0.47 range and was STILL CLIMBING at epoch 9
# (EMA dice 0.101 -> 0.182) when this full-length version was written --
# this phase gives it the full 150-epoch schedule to actually converge.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block_zeroed.json"

PHASE_A_RUN_NAME="acc1x_joint_noquant_damped_zeroslope_full150"
CALIBRATED_NET_NAME="nnUNetTrainerENetQuant_26_9_noquant_zeroslope_internal8_calibrated_full150"
PHASE_C_RUN_NAME="acc1x_joint_noquant_zeroslope_finetune_internal8_full150"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT" >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    (cd "$HOME/LightM-UNet/enet" && nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity)
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

# ==============================================================================
# PHASE A: 150 real epochs, quant_enabled=False, zeroed slope, damping
# ==============================================================================
PHASE_A_OUT="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${PHASE_A_RUN_NAME}__nnUNetPlans__2d/fold_0"
echo "############################################"
echo "### PHASE A: quant_enabled=False, 150 epochs -- output: ${PHASE_A_OUT}"
echo "############################################"

export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$FP32_CHECKPOINT"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_QUANT_LEAKY_FROM_EPOCH=999999
export ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE=0.1
unset ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_INTERNAL_BITS
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=150
export ENET_SKIP_ARCH_PLOT=1
unset ENET_DISABLE_CHECKPOINTING
unset ENET_SKIP_FINAL_VALIDATION
export ENET_OUTPUT_FOLDER="$PHASE_A_OUT"

cd "$HOME/LightM-UNet/enet"
if [ -f "${PHASE_A_OUT}/checkpoint_final.pth" ]; then
    echo "Phase A already complete (checkpoint_final.pth exists) -- skipping."
elif [ -f "${PHASE_A_OUT}/checkpoint_latest.pth" ]; then
    echo "Phase A partially complete -- resuming with --c."
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
else
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
fi
echo "Phase A done."

# ==============================================================================
# PHASE B: reconstruct (internal_bit_width=8) + calibrate
# ==============================================================================
CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "############################################"
echo "### PHASE B: reconstruct + calibrate (internal_bit_width=8) -- output: ${CALIBRATED_CHECKPOINT}"
echo "############################################"

cd "$HOME/LightM-UNet"
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists -- skipping Phase B."
else
    python compression/post-quantization/calibrate_noquant_to_decomposed.py \
        --source-net-name "${TRAINER_CLASS}_${PHASE_A_RUN_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --block-bits-file "${BLOCK_BITS_FILE}" \
        --leaky-slope-map-file "${SLOPE_MAP_FILE}" \
        --internal-bit-width 8
fi
echo "Phase B done."

# ==============================================================================
# PHASE C: 150 real epochs, quant_enabled=True (real chain active), internal_bit_width=8
# ==============================================================================
PHASE_C_OUT="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${PHASE_C_RUN_NAME}__nnUNetPlans__2d/fold_0"
echo "############################################"
echo "### PHASE C: quant_enabled=True fine-tune, 150 epochs -- output: ${PHASE_C_OUT}"
echo "############################################"

export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$CALIBRATED_CHECKPOINT"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_INTERNAL_BITS=8
unset ENET26_9_W24_S14W12_NONNEG_BLOCK_QUANT_LEAKY_FROM_EPOCH
unset ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE
export ENET_OUTPUT_FOLDER="$PHASE_C_OUT"

cd "$HOME/LightM-UNet/enet"
if [ -f "${PHASE_C_OUT}/checkpoint_final.pth" ]; then
    echo "Phase C already complete (checkpoint_final.pth exists) -- skipping."
elif [ -f "${PHASE_C_OUT}/checkpoint_latest.pth" ]; then
    echo "Phase C partially complete -- resuming with --c."
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
else
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
fi
echo "Phase C done. Read the final validation/summary.json for the real held-out dice."
