#!/bin/bash
#SBATCH --job-name=qat_26_9_noquant_finetune_internal8_15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# DEPENDS ON qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_noquant_ablation_5ep.job
# having already completed -- specifically its variant 4 (zero-slope +
# damping) checkpoint, nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock_
# acc1x_joint_noquant_damped_zeroslope_5ep, the best of the 5-variant
# ablation (real held-out validation dice=0.537, quant_enabled=False the
# entire training run -- the fake-quant chain at every leaky site bypassed
# entirely, pure float LeakyReLU(x,a)=a*x+(1-a)*ReLU(x)).
#
# Two-step continuation testing whether that result can be carried into a
# genuinely exportable, real-quantized model:
#
# STEP 1: reconstruct a real QuantDecomposedLeakyAct-based model
# (internal_bit_width=8 for pre_quant/act_pos, out_quant unchanged at the
# real per-block bit-width) from that checkpoint, and CALIBRATE the newly-
# introduced pre_quant/act_pos/out_quant quantizers on real data (Brevitas
# calibration_mode(), ~64 images, no gradients -- see
# compression/post-quantization/calibrate_noquant_to_decomposed.py's own
# docstring for why this is required, not optional: quant_enabled=False's
# forward pass never touches these 3 quantizers at all, so skipping
# calibration leaves them at an arbitrary default scale -- confirmed by
# direct local experiment to produce 100% EMPTY predictions on every test
# case). alpha and every conv/BN weight transfer unchanged (real name+shape
# match) -- only those 3 quantizers' own scale gets set.
#
# STEP 2: a real fine-tuning CONTINUATION (nnUNetv2_train, quant_enabled=
# True -- the real chain now genuinely active, real gradients flowing) warm-
# started from that calibrated checkpoint, 15 epochs. Motivation: calibration
# alone was tested locally and found NOT sufficient on its own (real held-out
# eval after calibration-only: dice~0.028, dice_binary=0.141, ~996 predicted
# connected components/image -- real, non-empty signal this time, but
# extremely fragmented, since the network's own weights were never exposed
# to ANY quantization noise at these sites during the original quant_enabled
# =False training and calibration only sets a sane scale, it doesn't teach
# the weights to tolerate the resulting rounding the way real QAT gradient
# steps do). This step lets the network's weights actually adapt to the
# newly-introduced quantization noise, starting from a MUCH better position
# (calibrated scales + a real, already-good leaky-trained network) than any
# cold-start QAT attempt on record.
#
# SAME bit assignment as every stuck attempt on record (block_bits_26_9_w24_
# s14w12_nonneg_block_acc1x_joint.json, genuine 2-bit sites intact,
# UNCHANGED). Zeroed slope map file passed for structural consistency only
# (which blocks get QuantDecomposedLeakyAct vs plain QuantReLU) -- alpha's
# actual VALUE is irrelevant here since it gets overwritten by the real
# trained value transferred from the checkpoint regardless of what the
# slope map says.
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=15, same LR-schedule-preservation
# rule as every other diagnostic job this session. No ENET_ITERATIONS_PER_
# EPOCH override -- full real per-epoch iteration count.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"
SOURCE_NET_NAME="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock_acc1x_joint_noquant_damped_zeroslope_5ep"
CALIBRATED_NET_NAME="nnUNetTrainerENetQuant_26_9_noquant_zeroslope_internal8_calibrated"
RUN_NAME="acc1x_joint_noquant_zeroslope_finetune_internal8_15ep"
BLOCK_BITS_FILE="compression/hawq/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block_zeroed.json"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"

SOURCE_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"
echo "=== Checking source checkpoint exists (from the noquant_ablation_5ep job) ==="
if [ ! -f "$SOURCE_CHECKPOINT" ]; then
    echo "ERROR: source checkpoint not found: $SOURCE_CHECKPOINT -- run qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_noquant_ablation_5ep.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== STEP 1: reconstruct + calibrate (internal_bit_width=8) ==="
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists at ${CALIBRATED_CHECKPOINT} -- skipping Step 1."
else
    python compression/post-quantization/calibrate_noquant_to_decomposed.py \
        --source-net-name "${SOURCE_NET_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --block-bits-file "${BLOCK_BITS_FILE}" \
        --leaky-slope-map-file "${SLOPE_MAP_FILE}" \
        --internal-bit-width 8
fi

echo "=== STEP 2: fine-tuning continuation, quant_enabled=True (real chain active), 15 epochs ==="
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="${CALIBRATED_CHECKPOINT}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_INTERNAL_BITS=8
unset ENET26_9_W24_S14W12_NONNEG_BLOCK_QUANT_LEAKY_FROM_EPOCH
unset ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=15
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines + final validation summary.json to judge whether fine-tuning recovers dice toward the quant_enabled=False checkpoint's own 0.537."
