#!/bin/bash
#SBATCH --job-name=qat_s19_validated_trainable_slope
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=01:00:00
# DELIBERATELY SHORT (2026-08-25): diagnostic ablation, not a publishable-
# dice run -- see the module comment below. 5 epochs x 250 iterations/epoch
# = 1,250 iterations; at the ~1.07s/iteration real rate qat_s19_block_bits.
# job's own header measured on this partition, that's ~22 real minutes,
# comfortably inside this budget with margin for the post-training Dice
# check.
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# ABLATION (companion to qat_s19_int8_trainable_slope.job -- read that
# job's header first for the full background): reruns the ALREADY-
# VALIDATED two-pass per-block bit assignment (compression/hawq/
# block_bits_s19_validated.json -- the historical record of what
# qat_s19_block_bits.job actually trained with when it reached a real
# dice=0.7458, preserved separately since the live block_bits_s19.json has
# since been overwritten by later ILP reruns) for just 5 epochs, but with
# trainable_slope=True (now unconditionally wired into
# QuantENetS19Block.py's encoder call sites) instead of the frozen slope
# that original run actually used.
#
# WHY THIS TEST: this is the other half of the trainable-slope isolation
# started by qat_s19_int8_trainable_slope.job. That job checks trainable
# slope on an easy (uniform INT8, healthy ~0.51 PTQ start) bit assignment.
# This job checks it on the bit assignment we ALREADY KNOW recovers well
# under the OLD frozen-slope code -- its real HPC log (training_log_
# 2026_8_24_23_47_59.txt, nnUNetTrainerENetQuantS19Block__nnUNetPlans__2d's
# bare results folder) shows nonzero per-class dice by epoch 2
# ([0.0, 0.0721, 0.0, 0.0001]), broad recovery by epoch 6-8 (EMA 0.0683 ->
# 0.1443), and EMA=0.5495 by epoch 25 -- despite an equally collapsed
# PTQ-only starting point (~0.0, confirmed via compression/hawq/
# diagnose_ptq_collapse.py) to every other per-block config tried.
#
# INTERPRETATION once this finishes (compare its 5-epoch trajectory against
# the frozen-slope log's own epochs 0-5 above):
#   - If dice climbs on a similar schedule (nonzero by epoch ~2, visibly
#     recovering by epoch 5): trainable_slope doesn't hurt this
#     already-working config -- consistent with it being safe to apply
#     everywhere, and strengthens the case that the joint/S5.6 failures are
#     about their OWN bit assignments, not the slope mechanism in general.
#   - If dice stays pinned near 0 through epoch 5 (unlike the frozen-slope
#     original, which was already moving here): trainable_slope itself
#     introduces a regression even on a known-good bit assignment -- would
#     directly implicate the slope-parameter/optimizer change (e.g. weight
#     decay now pulling on alpha, see session notes) rather than any
#     per-block bit-width story.
#
# WARM START: S19's own FP32 checkpoint_final.pth -- same source
# qat_s19_block_bits.job's original (frozen-slope) run used, so this is as
# close to an apples-to-apples rerun of that job as trainable_slope allows
# (a cold restart either way, since making alpha a real nn.Parameter
# changes which params the optimizer tracks).
#
# Decomposed nonneg-PReLU activation (ENET_S19_LEAKY_SLOPE_MAP_FILE below):
# same slope map as every other S19 QAT job -- NOT optional, see
# qat_s19_block_bits.job's own header for the documented incident of
# skipping it.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="s19_qat_validated_trainable_slope"
TRAINER_CLASS="nnUNetTrainerENetQuantS19Block"

SOURCE_NET_NAME="nnUNetTrainerENet_19_reginterleaved_separable_nonneg_block_double_mid"
BLOCK_BITS_FILE="compression/hawq/block_bits_s19_validated.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/19_reginterleaved_separable_nonneg_block_double_mid.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET_S19_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_S19_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET_S19_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Deliberately short -- see module comment above. Not meant to reach a
# final/publishable dice number, just to compare this 5-epoch trajectory
# against the frozen-slope original's own real epoch-0-through-5 log.
export ENET_EPOCHS=5
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (diagnostic ablation, ${ENET_EPOCHS} epochs)"
echo "Block bits file:       ${ENET_S19_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET_S19_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET_S19_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET_S19_BLOCK_BITS_FILE" "$ENET_S19_LEAKY_SLOPE_MAP_FILE" "$ENET_S19_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT ablation): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Post-training Dice check ==="
cd "$HOME/LightM-UNet"
python -c "
import torch, json
import sys
sys.path.insert(0, 'enet')
from nnunetv2.nets.QuantENetS19Block import QuantENetS19Block, OUT_CHANNELS
sys.path.insert(0, 'compression/hawq')
from eval_dice import evaluate
with open('${BLOCK_BITS_FILE}') as f: bits = json.load(f)
with open('${SLOPE_MAP_FILE}') as f: slope_map = json.load(f)
ckpt = torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)
model = QuantENetS19Block(bits['stage_weight_bits'], bits['stage_act_bits'], slope_map)
model.load_state_dict(ckpt['network_weights'], strict=False)
device = 'cuda' if torch.cuda.is_available() else 'cpu'
model.to(device)
with open('data/nnUNet_preprocessed/${DATASET_NAME}/splits_final.json') as f:
    val_cases = json.load(f)[0]['val']
result = evaluate(model, val_cases, device, OUT_CHANNELS)
print(json.dumps(result, indent=2))
"

echo "Done: ${RUN_NAME}."
