#!/bin/bash
#SBATCH --job-name=stage_9_dsc_projected_dense_dilation
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-3
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 9 -- isolates whether RegInterleaved's no-projection choice
# (DSCNoProjectionBottleneck, full channel width, no reduce/expand) costs
# accuracy relative to keeping the projection, by building the SAME
# depthwise-separable factoring but through RegularBottleneck's own
# use_dsc=True path instead -- reduce -> depthwise+pointwise (at
# internal_channels, not full width) -> expand. All four tasks share
# CHANNELS=4,16,32,16,4, CONTEXT_PATTERN=dense_dilation (or its reg-trailing
# variant for task 2), USE_DSC=1, DSC_NO_PROJECTION=0 (the projection stays).
#
#   0: 9_1_dense_dilation_dsc_projected -- native depth (8 slots, all
#      dilated 2,4,8,16 x2, no reg-bookend at all). Directly comparable to
#      S5-DscNoProjDense (same dense_dilation pattern, same depth,
#      dsc_no_projection=1 instead) -- isolates the projection-vs-no-
#      projection choice with the dilation-schedule composition held fixed.
#      Structurally verified (ENet.py's own self-test) to keep its
#      reduce/expand at every stage2/3 slot, unlike dsc_no_projection's
#      DSCNoProjectionBottleneck. Measured (not assumed): 17,610 params /
#      192.0M MACs / 139,264 buffer elements -- cheaper than BOTH U4
#      (24,581p/344.0M/90,240*) and S5-DscNoProjDense (30,488p/224.8M/
#      527,872) on params and MACs, and dramatically cheaper than S5 on
#      FINN buffer memory specifically (dropping the no-projection choice
#      keeps the spatial conv at internal_channels=8, not the full 32 S5's
#      DSCNoProjectionBottleneck runs at -- see compression/'s buffer-
#      memory analysis for the full derivation). *U4's buffer figure isn't
#      an apples-to-apples comparison -- different context_pattern/op mix.
#   1: 9_2_dense_dilation_dsc_projected_extra_depth -- same as task 0 but
#      stage2/3 widened to 11 slots (DENSE_DILATION_PATTERN's native 8
#      wrapping around to repeat its first 3 rates: 2,4,8,16,2,4,8,16,2,4,8)
#      -- no new code, pure bottlenecks_per_stage composition. Isolates
#      whether extra DEPTH alone (not the reg-bookend's specific non-DSC
#      character) explains any of RegInterleaved's edge over task 0.
#      Measured: 22,362 params / 223.9M MACs / 167,936 buffer elements --
#      +4,752p/+31.9M/+28,672 over task 0 for 3 more dilated slots.
#   2: 9_3_dense_dilation_reg_trailing -- new context_pattern (ENet.py's
#      DENSE_DILATION_REG_TRAILING_PATTERN): 2,4,8,16,reg repeating (10
#      slots total, 2 full cycles) -- the reg-bookend TRAILS each dilation
#      cycle instead of leading it (unlike dense_dilation_reg_interleaved's
#      reg-first pattern), on the reasoning that down1/down2 already
#      provide a joint spatial+channel op right before stage2 begins, so a
#      LEADING reg block there is redundant -- this variant only spends one
#      where the stage has no other nearby source of a joint op (right
#      before handoff to proj2_to_3/stage3, or to up4). The reg slot itself
#      is forced non-DSC (a genuine monolithic RegularBottleneck, not
#      DSC-factored) via the {"reg_bottleneck": True} sentinel, now also
#      honored in _make_context_stage's "plain" (projected) loop, not just
#      the dsc_no_projection branch dense_dilation_reg_interleaved uses.
#      Measured: 22,538 params / 242.1M MACs / 143,360 buffer elements --
#      only +4,096 buffer over task 0 (the 2 extra reg slots run at the
#      SAME internal_channels=8 as everything else, so they're cheap),
#      vs. task 1's +28,672 for a comparable params/depth increase --
#      i.e. extending via reg-trailing blocks is far cheaper in buffer
#      memory than extending via more dilated blocks.
#   3: 9_4_dense_dilation_dsc_projected_relu -- task 0 with ENET_USE_PRELU=0
#      (existing flag, no new code) instead of PReLU. Directly motivated by
#      stage_8's own finding that the SAME ReLU-vs-PReLU swap on
#      RegInterleaved (8_2_relu) became the best dice in the whole sweep
#      (0.8218) -- this checks whether that same swap helps the
#      projection-kept DSC variant too. Params/MACs/buffer identical to
#      task 0 (17,610p/192.0M/139,264) -- ReLU has no params of its own,
#      so it doesn't change architecture cost at all, only training
#      dynamics.
#
# (Two further variants -- separable_dilated=1 stacked on top of tasks 0/3,
# spatially factoring DSC's already-depthwise conv into a (3,1)+(1,3) pair
# -- were built, self-tested, and smoke-tested, then DROPPED before this
# job was written: measured strictly worse than tasks 0/3 on params, MACs,
# AND buffer memory simultaneously, the same "linear savings, linear
# overhead, net wash-to-loss" result as an earlier separable-factored-
# DSCNoProjectionBottleneck probe. Not included here.)
#
# All 4 confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c) to build and train
# (forward+backward+optimizer, not just a forward pass) without error, and
# tasks 0-2 additionally verified via ENet.py's own self-test ("Stage-9
# DSC+projection dense_dilation self-test": exact per-slot bottleneck
# class, presence/absence of reduce/expand projection, per-slot dilation
# schedule, and params-strictly-less-than-baseline checks). Task 3 needed
# no new self-test coverage -- ENET_USE_PRELU=0 composed with task 0's
# config is already covered by every other use_prelu=0 build elsewhere in
# the self-test suite (same precedent as stage_8's 8_2_relu).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(9_1_dense_dilation_dsc_projected 9_2_dense_dilation_dsc_projected_extra_depth 9_3_dense_dilation_reg_trailing 9_4_dense_dilation_dsc_projected_relu)
BOTTLENECKS_ARR=("4,8,8,2,1" "4,11,11,2,1" "4,10,10,2,1" "4,8,8,2,1")
CONTEXT_PATTERN_ARR=(dense_dilation dense_dilation dense_dilation_reg_trailing dense_dilation)
USE_PRELU_ARR=(1 1 1 0)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- DSC-with-projection dense_dilation family --------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="${BOTTLENECKS_ARR[$TASK_ID]}"
export ENET_CONTEXT_PATTERN="${CONTEXT_PATTERN_ARR[$TASK_ID]}"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU="${USE_PRELU_ARR[$TASK_ID]}"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_BOTTLENECKS=${ENET_BOTTLENECKS} ENET_CONTEXT_PATTERN=${ENET_CONTEXT_PATTERN} ENET_USE_PRELU=${ENET_USE_PRELU}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth (written once, at the very end of a finished
# num_epochs-epoch run) counts as "already trained" -- checkpoint_best.pth
# gets written as early as epoch 0 (any first pseudo-dice counts as "new
# best"), so treating IT as a completion signal was what let a crashed
# stage_8 run's undertrained checkpoint get silently collected as if it
# were a finished result (see stage_8's own job file for the incident).
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 9_dsc_projected_dense_dilation \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
