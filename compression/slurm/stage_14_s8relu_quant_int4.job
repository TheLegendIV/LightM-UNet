#!/bin/bash
#SBATCH --job-name=stage_14_s8relu_quant_int4
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Stage 14 -- quantization-aware training (QAT) of S8-ReLU (8_2_relu,
# FP32 dice=0.8218, the sweep's current dice leader) at INT4, to measure
# dice degradation under aggressive quantization. Exact same recipe as the
# real trained FP32 config: channels=4,16,32,16,4, bottlenecks=4,11,11,2,1
# (widened for the reg-bookend cycle), context_pattern=
# dense_dilation_reg_interleaved, dsc_no_projection=1 (network-wide --
# dsc_no_projection_context_only=0), use_asymmetric=0.
#
# No leaky-activation complication here: S8-ReLU's real trained recipe is
# already use_prelu=0 (plain ReLU throughout, encoder included), which is
# exactly what QuantENet already builds by default (QuantReLU everywhere,
# no PReLU/leaky path needed at all) -- see QuantENet.py's module
# docstring. The only real new engineering this run depends on is
# QuantENet.py's newly-added context_pattern selection +
# QuantDSCNoProjectionBottleneck (dsc_no_projection support), ported from
# ENet.py and self-tested (see QuantENet.py's own __main__ self-test,
# "S8-ReLU@INT4 recipe" section: build+forward + reg-bookend/DSC-no-
# projection block TYPE verification against this exact recipe).
#
# Cold-started (no -pretrained_weights) -- matches this repo's own
# established convention for every prior QuantENet job (postpruning_3a_
# quant_array.job / postpruning_3a_quant_O4_int8_no_asym.job, neither of
# which warm-started either). A `-pretrained_weights` attempt from the
# real FP32 8_2_relu checkpoint was tried and hits a genuine, pre-existing
# Brevitas quirk unrelated to this stage's own new code (missing
# `scaling_impl.value` keys -- nnUNetTrainerENetQuant.py's own
# `load_checkpoint` docstring already documents a related Brevitas
# parameter-scaling re-materialization quirk for the checkpoint-RESUME
# path specifically), so this follows precedent instead of chasing that
# rabbit hole for a QAT run that's supposed to be measuring quantization
# noise, not weight-transfer fidelity.
#
# Confirmed via local docker smoke test: nnUNetv2_train runs end-to-end
# (forward+backward+optimizer, 1 epoch/2 iterations) at INT4 with this
# exact recipe.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="14_s8relu_quant_int4"
TRAINER_CLASS="nnUNetTrainerENetQuant"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S8-ReLU's exact recipe, INT4 --------------------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,11,11,2,1"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_CONTEXT_PATTERN="dense_dilation_reg_interleaved"
export ENET_DSC_NO_PROJECTION=1
export ENET_QUANT_BITS=4
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "ENET_QUANT_BITS=${ENET_QUANT_BITS}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth (written once, at the very end of a finished
# num_epochs-epoch run) counts as "already trained" -- checkpoint_best.pth
# gets written as early as epoch 0, see stage_8's own job file for the
# incident this guards against.
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training (QAT): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 14_s8relu_quant_int4 \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --quant-bits "${ENET_QUANT_BITS}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
