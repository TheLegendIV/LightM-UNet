#!/bin/bash
#SBATCH --job-name=qat_5_6_acc2x
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=10:00:00
# WALLTIME: same architecture/compute graph as qat_5_6_block_bits.job (only
# the per-block bit-width ints differ, not tensor shapes or op count -- see
# that job's own header for the full real-HPC-rate derivation), so its
# proven 10:00:00 budget for a full 150-epoch/250-iterations-per-epoch run
# applies here unchanged.
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# QAT (quantization-aware training) of the ACCURACY-WEIGHTED HAWQ two-pass
# per-block search (compression/hawq/ilp_search.py --sensitivity-weight 2.0,
# compression/hawq/block_bits_5_6_acc2x.json) on the same S5.6 architecture
# as qat_5_6_block_bits.job (which used the default --sensitivity-weight
# 1.0 --joint search, block_bits_5_6.json) -- ENET5_6_BLOCK_BITS_FILE is the
# only knob that differs, same trainer class
# (nnUNetTrainerENetQuant5_6Block).
#
# WHY: qat_5_6_block_bits.job's own real HPC run got stuck at Pseudo dice
# ~0.0 (see that job's TRAINABLE SLOPE comment) even after the
# trainable_slope fix was applied for its retry. Weighting accuracy 2x
# relative to LUT/BRAM in the ILP objective (--sensitivity-weight 2.0,
# default --lut-weight/--bram-weight 1.0 each) shifted 't's own bit
# assignment substantially: block_bits_5_6_acc2x.json moves S5.6's context
# stage from mostly W4 (the original --joint result's own choice) to almost
# entirely W2, while pushing MORE activation bits up from 2 to 4 across the
# same stage (see block_bits_5_6.json vs block_bits_5_6_acc2x.json for the
# exact per-block diff) -- a genuinely different point in the search space,
# not a fine-tune of the same one. Calibrated cost: LUT 136.0% of budget,
# BRAM_18K 49.7% (both informational -- this is a soft-penalty search, no
# hard cap).
#
# TRAINABLE SLOPE: QuantENet5_6Block.py unconditionally passes
# trainable_slope=True at every encoder activation site (see
# QuantDecomposedLeakyAct's own docstring and qat_5_6_block_bits.job's own
# TRAINABLE SLOPE comment for the full background) -- no separate flag
# needed here, it's wired into the class itself regardless of which
# block-bits file is used.
#
# NONNEG-PRELU FOR THE QAT: same slope map, same rationale, as
# qat_5_6_block_bits.job's own header (S5.6 is prelu_variant="standard",
# the slope map is a post-hoc per-channel average with no retraining behind
# it until QAT gives it one) -- not repeated here.
#
# Confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations, ENET_VAL_ITERATIONS_PER_EPOCH=1, ENET_DISABLE_CHECKPOINTING=1):
# nnUNetTrainerENetQuant5_6Block builds with block_bits_5_6_acc2x.json,
# warm-starts from S5.6's own FP32 checkpoint_final.pth (721/820 keys
# transferred, 0 shape mismatches -- identical transfer count to
# qat_5_6_block_bits.job's own, since only the per-block bit-width ints
# differ, not which keys exist), all 83/83 QuantDecomposedLeakyAct sites
# confirmed trainable (nn.Parameter, requires_grad=True) AND warm-started
# to the real per-block slope-map values (spot-checked initial/down1/
# stage2.0 -- exact match, not reset to a default), and completes a real
# forward+backward+optimizer step end to end.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="5_6_qat_acc2x"
TRAINER_CLASS="nnUNetTrainerENetQuant5_6Block"

SOURCE_NET_NAME="nnUNetTrainerENet_5_6_separable_dense_dilation"
BLOCK_BITS_FILE="compression/hawq/block_bits_5_6_acc2x.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/5_6_separable_dense_dilation.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET5_6_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET5_6_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET5_6_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch budget, nnU-Net's real default 250 iterations/epoch --
# ENET_ITERATIONS_PER_EPOCH deliberately left UNSET, see WALLTIME comment
# above.
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "Block bits file:       ${ENET5_6_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET5_6_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET5_6_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET5_6_BLOCK_BITS_FILE" "$ENET5_6_LEAKY_SLOPE_MAP_FILE" "$ENET5_6_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        echo "  (run compression/hawq/block_sensitivity.py -> finn_block_costs.py -> ilp_search.py, and/or" >&2
        echo "   compression/post-quantization/extract_leaky_slope_map.py --prelu-variant standard, first)" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
SLOPE_MAP_JSON=$(python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage experiment_5_6_qat_acc2x \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels 4,16,32,16,4 \
    --bottlenecks 4,8,8,2,1 \
    --decoder-type upsample_conv \
    --use-asymmetric 0 \
    --context-pattern dense_dilation \
    --separable-dilated 1 \
    --leaky-slope-map "$SLOPE_MAP_JSON" \
    --quant-bits 32 \
    --trainer-class "${TRAINER_CLASS}"
# --quant-bits 32 here is a deliberate placeholder, same rationale as
# qat_5_6_block_bits.job's own note -- real per-block params/bops/LUT/BRAM
# live in compression/hawq/finn_block_costs_5_6.json / block_bits_5_6_acc2x.json,
# not this row's own params/flops/bops columns.

echo "Done: ${RUN_NAME}."
