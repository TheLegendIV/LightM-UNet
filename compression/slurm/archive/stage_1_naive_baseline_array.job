#!/bin/bash
#SBATCH --job-name=stage_1_naive_baseline
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-5
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 1_naive_baseline -- first sweep on the new 4-class objective
# (LAD/RCA/LCX/LM on Dataset509_ARCADE_1x1_4c, replaces the retired binary
# Dataset501 compression study -- see compression/README.md's top note and
# compression/slurm/archive/README.md). A uniform-divisor channel-width grid
# off the ENet PAPER baseline (16,64,128,64,16) -- including f_i itself,
# unlike the old (archived) pruning_2a_grid_array.job's O2/O4/O8/O16/OF axis
# which kept f_i fixed at 16 and only shrank the inner stages. All other
# knobs at ENet-paper native/default values EXCEPT:
#   ENET_USE_PRELU=0      -- plain ReLU everywhere (encoder collapsed off
#                             PReLU; decoder is already ReLU regardless of
#                             this flag, see ENet.py)
#   ENET_DECODER_TYPE=upsample_conv -- no MaxUnpool2d
# Bottlenecks (4,8,8,2,1), context_pattern=default, dilated/asymmetric/
# strided=1, dsc=0 all stay at ENet-paper native values -- not swept in this
# stage. This stage intentionally does NOT source
# compression/configs/cfinal_ops.env (that file encodes the retired binary
# run's Stage-1b decision) -- every knob below is set explicitly, fresh.
#
# U8/U16's raw uniform divisor would push stage widths below 4 (U8's
# stage5=2, U16's f_i=1/stage5=1) -- ENet.py hard-rejects any of
# stage1..stage5 not divisible by 4 (the bottleneck's C/4 internal
# projection; also gives FINN folding freedom later, per
# agent_instructions_1.yaml's channel_constraint note), and separately
# requires f_i > in_channels (1, grayscale), which raw U16's f_i=1 also
# fails. Per the previous binary-run grid's own "UF" floor config (f_i
# floored at 4, agent_instructions_1.yaml's stage_2_architecture_grid),
# every value below 4 is floored to 4 here rather than left at its raw
# divisor -- confirmed via a local docker smoke test (nnUNetv2_train, 1
# epoch / 2 iterations, both raw and floored variants) that the floored
# values below actually build and train, where the raw /8 and /16 divisors
# did not.
#   0: Baseline -- CHANNELS=16,64,128,64,16 (ENet paper baseline, f_i included)
#   1: U2       -- CHANNELS=8,32,64,32,8    (uniform /2)
#   2: U4       -- CHANNELS=4,16,32,16,4    (uniform /4)
#   3: U8       -- CHANNELS=4,8,16,8,4      (uniform /8 = 2,8,16,8,2, floored to 4)
#   4: U16      -- CHANNELS=4,4,8,4,4       (uniform /16 = 1,4,8,4,1, floored to 4)
#   5: E1       -- CHANNELS=20,72,144,72,20 (paper-tuned E1 shape, added later --
#      same settings as tasks 0-4, direct 6th point on the same curve, NOT
#      the "no asymmetric" policy adopted for stage_4_arch_probes onward --
#      this grid was already established with asymmetric=1, changing it here
#      would make E1 incomparable to Baseline/U2/U4/U8/U16. Historically
#      (binary Dataset501 run) E1's wider channels UNDERPERFORMED plain
#      Original/Baseline despite more params -- this task re-checks whether
#      that holds for the harder 4-class objective too. Submit with
#      `sbatch --array=5 stage_1_naive_baseline_array.job` to add just this
#      task without redundantly re-running collect_results.py's test-set
#      inference for the already-collected 0-4.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(Baseline U2 U4 U8 U16 E1)
TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"

case "$CONFIG_NAME" in
  Baseline) CHANNELS="16,64,128,64,16" ;;
  U2)       CHANNELS="8,32,64,32,8" ;;
  U4)       CHANNELS="4,16,32,16,4" ;;
  U8)       CHANNELS="4,8,16,8,4" ;;
  U16)      CHANNELS="4,4,8,4,4" ;;
  E1)       CHANNELS="20,72,144,72,20" ;;
esac

RUN_NAME="1_naive_baseline_${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -------------------------------------------------------
export ENET_CHANNELS="${CHANNELS}"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_CONTEXT_PATTERN="default"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=1
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_USE_PRELU=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS} ENET_BOTTLENECKS=${ENET_BOTTLENECKS}"
echo "ENET_DECODER_TYPE=${ENET_DECODER_TYPE} ENET_USE_PRELU=${ENET_USE_PRELU}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 1_naive_baseline \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
