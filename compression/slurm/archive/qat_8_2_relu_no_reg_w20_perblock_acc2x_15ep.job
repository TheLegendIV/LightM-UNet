#!/bin/bash
#SBATCH --job-name=qat_8_2_relu_no_reg_w20_perblock_acc2x_15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Same as qat_8_2_relu_no_reg_w20_perblock_acc1x_15ep.job (see that job's
# own header for the full calibration/resumability rationale -- not
# repeated here), but consuming the acc2x (sensitivity_weight=2.0, more
# accuracy-favoring) per-block bit assignment instead of acc1x:
# compression/hawq/artifacts/block_bits_8_2_relu_no_reg_w20_acc2x_joint.json -- found
# Optimal: down1 bumped to weight=8 (vs acc1x's 4), stage3.3 bumped to
# weight=4/act=2 (vs acc1x's 2/4), regular4.0/4.1 dropped to act=2 (vs
# acc1x's 4) -- real folding shows 100.0% LUT / 29.1% BRAM / ~28.5ms
# hard-capped (vs acc1x's ~23.0ms -- acc2x costs ~24% more latency at the
# same LUT budget for its extra accuracy-preserving bit bumps).
#
# Reuses the SAME generic calibrate_8_2_relu_no_reg_w20_perblock.py script
# and nnUNetTrainerCombinedQuantENet_8_2_relu_no_reg_w20_perblock trainer
# as the acc1x job -- both are already bit-assignment-agnostic (take the
# block-bits file as a --block-bits-file arg / ENET_BLOCK_BITS_FILE env var
# respectively), so no new Python code was needed, only this job's own
# BLOCK_BITS_FILE/CALIBRATED_NET_NAME/RUN_NAME pointing at the acc2x
# assignment and a separate output folder from the acc1x run (does not
# touch/interfere with it).
#
# ENET_MAX_EPOCHS_TO_RUN=150 (was 60): this is a RELATIVE cap
# (max_epoch = min(ENET_EPOCHS, current_epoch + ENET_MAX_EPOCHS_TO_RUN)),
# so setting it >= ENET_EPOCHS makes every future resubmission always
# target the TRUE end of the 150-epoch schedule regardless of whatever
# epoch it's currently sitting at, instead of stopping at an arbitrary
# earlier point that then needs recalculating by hand each time. Real
# incident that prompted this: an earlier submission with =60 correctly
# advanced this net from a repaired epoch-50 base to epoch 110, but 110 is
# still short of the real 150-epoch schedule -- with the fixed value here,
# the NEXT resubmission finishes the remaining 40 epochs (fits comfortably
# in the SBATCH --time budget below) and lands exactly on 150. Safe even if
# a submission ever gets killed mid-run by the --time wall clock: the
# self-healing checkpoint_final.pth-vs-checkpoint_latest.pth promotion
# above (added after a real incident where this job's own checkpoint_
# final.pth went stale relative to checkpoint_latest.pth) means no
# resubmission can silently lose progress anymore, regardless of exactly
# where a kill happens to land.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerCombinedQuantENet_8_2_relu_no_reg_w20_perblock"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_8_2_relu_no_reg_w20"
CALIBRATED_NET_NAME="nnUNetTrainerCombinedQuantENet_8_2_relu_no_reg_w20_perblock_acc2x_calibrated"
RUN_NAME="8_2_relu_no_reg_w20_perblock_acc2x_qat"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_8_2_relu_no_reg_w20_acc2x_joint.json"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT -- run stage_8_2_relu_no_reg_w20.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== STEP 1: calibrate (warm-start from the real FP32 checkpoint; skip if already done) ==="
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists at ${CALIBRATED_CHECKPOINT} -- skipping calibration."
else
    python compression/post-quantization/calibrate_8_2_relu_no_reg_w20_perblock.py \
        --source-net-name "${FP32_SOURCE_NET_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --block-bits-file "${BLOCK_BITS_FILE}"
fi

echo "=== STEP 2: real QAT fine-tuning, 150-epoch schedule, this submission runs 15 ==="
export ENET_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_PRETRAINED_CHECKPOINT="${CALIBRATED_CHECKPOINT}"
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
# nnUNetv2_train --c ALWAYS resumes from checkpoint_final.pth if it exists
# (see run_training.py's own maybe_load_checkpoint -- checkpoint_latest.pth
# is only ever consulted as a fallback when checkpoint_final.pth is
# missing entirely). checkpoint_final.pth only gets (re)written when a
# training run's own epoch loop returns NORMALLY; checkpoint_latest.pth
# gets written every epoch regardless. If a submission's own SBATCH --time
# wall-clock limit kills the job mid-run (real, confirmed incident: a
# 60-epoch resume submission got killed partway through, leaving
# checkpoint_latest.pth genuinely at epoch 50 while checkpoint_final.pth
# stayed stuck at the PRIOR submission's own clean 15-epoch stop), the next
# --c resume would silently reload the stale, far-behind checkpoint_final.pth
# and throw away every real epoch of progress in between -- exactly what
# happened here before this fix (repaired once by hand this session; this
# check makes that recovery automatic and permanent going forward).
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real 150-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME 150-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real 150-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    python compression/collect_results.py \
        --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
        --stage 8_2_relu_no_reg_w20_perblock_acc2x_qat \
        --dataset-name "${DATASET_NAME}" \
        --dataset-id "${DATASET_ID}" \
        --channels 4,10,20,10,4 \
        --bottlenecks 4,8,8,2,1 \
        --decoder-type upsample_conv \
        --use-asymmetric 0 \
        --context-pattern dense_dilation \
        --separable-dilated 0 \
        --quant-bits 8 \
        --trainer-class "${TRAINER_CLASS}"
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
