#!/bin/bash
#SBATCH --job-name=qat_s19_acc2x_frozen_slope
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=01:00:00
# DELIBERATELY SHORT: diagnostic ablation, not a publishable-dice run --
# see the module comment below. 5 REAL epochs (ENET_MAX_EPOCHS_TO_RUN=5)
# x 250 iterations/epoch = 1,250 iterations; at the ~1.07s/iteration real
# rate qat_s19_block_bits.job's own header measured on this partition,
# that's ~22 real minutes, comfortably inside this budget with margin for
# the post-training Dice check.
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# ABLATION -- fills in the one untested cell of a 2x2 confound discovered
# this session: every stuck per-block QAT run on record (S19-joint,
# S19-acc2x, S5.6, S5.6-acc2x) used trainable_slope=True (the current
# unconditional default), while the ONE working run (S19-validated,
# dice=0.7458) used the ORIGINAL frozen slope, simply because
# trainable_slope didn't exist yet when it ran. So "harder bits" and
# "slope trainability" have been perfectly confounded across 100% of
# existing data -- {acc2x bits, frozen slope} has never been tested. This
# job is exactly that cell: qat_s19_acc2x.job's own bit assignment
# (compression/hawq/artifacts/block_bits_s19_acc2x.json), but with
# ENET_S19_TRAINABLE_SLOPE=0 (uses QuantENetS19Block.py's constructor
# toggle added 2026-08-26 specifically for this cross-comparison).
#
# COMPANION RESULT ALREADY IN HAND: qat_s19_validated_frozen_slope.job
# (validated bits, frozen slope, same ENET_EPOCHS=150/ENET_MAX_EPOCHS_TO_RUN=5
# pattern) has been run and reproduces the historical validated
# trajectory closely (epoch 4 EMA 0.022 here vs. 0.0229 in the original
# 150-epoch run, same one-class-breaks-away-first shape) -- confirms the
# LR-schedule fix is solid and there's no environment/version drift, so
# this job's result is directly comparable.
#
# INTERPRETATION once this finishes, reading raw per-epoch Pseudo dice
# (not just the lagging EMA metric) against qat_s19_validated_frozen_slope.job's:
#   - If this ALSO shows a class breaking away by epoch 1-2 and climbing
#     toward the same ballpark by epoch 4 (like validated does): bits
#     don't explain the stuck behavior either, on their own, under frozen
#     slope -- would need to revisit whether trainable slope actually IS a
#     factor after all (despite Step 0's gradient-correctness pass and the
#     original frozen-slope S19-joint stuck run -- a genuinely surprising
#     result worth re-examining closely, not simply accepted at face value).
#   - If this stays flat at exact 0.0 like the acc2x/joint stuck runs
#     always have: bits matter independent of slope -- trainable_slope is
#     cleared as a cause, and the investigation moves to which specific
#     blocks in acc2x's bit assignment (see block_bits_s19_acc2x.json vs.
#     block_bits_s19_validated.json's own diff, 16/37 blocks differ,
#     regular5.0 W8->W4 the most sensitivity-flagged one) are the real
#     driver -- next step would be the single-block override test
#     (qat_s19_acc2x_regular5_0_w8.job, not yet built).
#
# WARM START: S19's own FP32 checkpoint_final.pth -- same source
# qat_s19_acc2x.job's own (non-ablation) run uses.
#
# Decomposed nonneg-PReLU activation (ENET_S19_LEAKY_SLOPE_MAP_FILE below):
# same slope map as every other S19 QAT job -- NOT optional, see
# qat_s19_block_bits.job's own header for the documented incident of
# skipping it.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="s19_qat_acc2x_frozen_slope"
TRAINER_CLASS="nnUNetTrainerENetQuantS19Block"

SOURCE_NET_NAME="nnUNetTrainerENet_19_reginterleaved_separable_nonneg_block_double_mid"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_s19_acc2x.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/19_reginterleaved_separable_nonneg_block_double_mid.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET_S19_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_S19_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET_S19_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
export ENET_S19_TRAINABLE_SLOPE=0
# Real 150-epoch LR schedule -- ENET_MAX_EPOCHS_TO_RUN is what actually
# stops training early, NOT ENET_EPOCHS (see the LR-schedule-compression
# bug this session found and fixed: cutting ENET_EPOCHS itself would
# compress the whole PolyLRScheduler decay curve into 5 epochs instead of
# truncating a real 150-epoch one).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=5
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (diagnostic ablation, ${ENET_MAX_EPOCHS_TO_RUN} real epochs, LR schedule shaped by ENET_EPOCHS=${ENET_EPOCHS})"
echo "Block bits file:       ${ENET_S19_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET_S19_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET_S19_PRETRAINED_CHECKPOINT}"
echo "Trainable slope:       ${ENET_S19_TRAINABLE_SLOPE}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET_S19_BLOCK_BITS_FILE" "$ENET_S19_LEAKY_SLOPE_MAP_FILE" "$ENET_S19_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT ablation): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Post-training Dice check ==="
cd "$HOME/LightM-UNet"
python -c "
import torch, json
import sys
sys.path.insert(0, 'enet')
from nnunetv2.nets.QuantENetS19Block import QuantENetS19Block, OUT_CHANNELS
sys.path.insert(0, 'compression/hawq')
from eval_dice import evaluate
with open('${BLOCK_BITS_FILE}') as f: bits = json.load(f)
with open('${SLOPE_MAP_FILE}') as f: slope_map = json.load(f)
ckpt = torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)
model = QuantENetS19Block(bits['stage_weight_bits'], bits['stage_act_bits'], slope_map, trainable_slope=False)
model.load_state_dict(ckpt['network_weights'], strict=False)
device = 'cuda' if torch.cuda.is_available() else 'cpu'
model.to(device)
with open('data/nnUNet_preprocessed/${DATASET_NAME}/splits_final.json') as f:
    val_cases = json.load(f)[0]['val']
result = evaluate(model, val_cases, device, OUT_CHANNELS)
print(json.dumps(result, indent=2))
"

echo "Done: ${RUN_NAME}."
