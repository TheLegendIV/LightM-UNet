#!/bin/bash
#SBATCH --job-name=qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_zeroslope_15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=01:30:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 15-epoch DIAGNOSTIC run, second retry after qat_26_9_w24_s14w12_nonneg_
# block_acc1x_joint_15ep.job's own real HPC run came back STUCK
# (pseudo-dice flat at 0.0 through epoch 10).
#
# The first retry attempt (--fix-bits on the 5 highest-sensitivity blocks,
# see qat_26_9_w24_s14w12_nonneg_block_acc2x_joint_fixed2_15ep.job's own
# header) was called into question by a real counter-example: the
# ALREADY-WORKING nnUNetTrainerENetQuant26_5_w24Block_26_5_w24_qat_
# block_bits checkpoint uses bits at least as aggressive (stage2/stage3
# nearly all W2A2, vs this architecture's W4A2) at those exact same
# "outlier" blocks (down1/initial/final/regular5.0/up5), so bit harshness
# there isn't the actual differentiator. Checking that checkpoint's own
# state_dict directly found it has separately-stored `one_minus_alpha`
# buffers -- i.e. it was trained BEFORE this session's trainable_slope=True
# edit to QuantENet26_5_w24.py, with FROZEN slope. Every stuck run on
# record (including this architecture's own first attempt) uses TRAINABLE
# slope, warm-started from a REAL trained nonneg_block scalar (e.g.
# initial=0.76, down1=0.73 -- see compression/post-quantization/
# slope_maps/26_9_w24_s14w12_nonneg_block.json).
#
# THIS RUN tests a more targeted hypothesis than either fixed-bits or a
# blanket frozen/trainable toggle: keep trainable_slope=True (still lets
# real QAT gradients adapt the slope), but START every block's slope at
# 0.0 instead of its real trained nonneg_block value -- compression/
# post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block_zeroed.json
# (same 23 block keys, every value replaced with 0.0). Verified this still
# builds a real QuantDecomposedLeakyAct at each mapped site (not a
# fallback to plain QuantReLU -- ENet.py/QuantENet.py's own convention is
# `if negative_slope is None: use plain QuantReLU`, and 0.0 is not None),
# just initialized at slope=0 (equivalent to starting as plain ReLU) and
# free to move away from that under training.
#
# SAME bit assignment as the FIRST stuck attempt (block_bits_
# 26_9_w24_s14w12_nonneg_block_acc1x_joint.json, UNCHANGED) -- this run's
# only difference from that stuck attempt is the slope map file. Keeping
# this bit assignment (not the fixed2 one) also keeps the already-verified
# cheap, 70/80-feasible folding (folding_block_26_9_w24_s14w12_nonneg_
# block_acc1x_joint_70_80_relaxed.json, 2,322,432 cycles = 23.2ms) --
# the fixed2 alternative's own bit assignment maxes out 100% LUT and is
# infeasible at 70/80, so resolving the stuck-training question on THIS
# bit assignment first is strictly better if it works.
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=15, same LR-schedule-
# preservation rule as every other diagnostic job.
#
# WARM START: 26_9_w24_s14w12_nonneg_block's own FP32 checkpoint_best.pth
# (unchanged -- only the slope map passed at QAT construction time
# differs; from_pretrained's own conv/BN weight transfer is unaffected by
# which slope map is passed, since slope scalars never match a
# NonNegativePReLU(1) source's own shape anyway, see
# QuantENet26_9_w24_s14w12_nonneg_block.py's from_pretrained note).
#
# No collect_results.py step -- training-log-only diagnostic.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_9_w24_s14w12_nonneg_block_qat_acc1x_joint_zeroslope_15ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"

SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block_zeroed.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch schedule, early-stopped at 15 real epochs (diagnostic).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=15
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (15-epoch diagnostic, LR schedule of ${ENET_EPOCHS} epochs, slopes start at 0.0)"
echo "Block bits file:       ${ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE}"
echo "Slope map file (zeroed): ${ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT diagnostic): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines directly from this log to judge whether training recovered normally."
