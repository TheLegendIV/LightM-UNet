#!/bin/bash
#SBATCH --job-name=resume_3a_quant_O4_int8_no_asym
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Continuation of postpruning_3a_quant_O4_int8_no_asym.job: that job's
# --time=04:00:00 walltime ran out mid-epoch 117/150 (see
# training_log_2026_7_25_16_03_12.txt under
# nnUNetTrainerENetQuant__nnUNetPlans__2d/fold_0 -- nnU-Net's log file path
# is fixed at __init__ time from the trainer's DEFAULT output folder, before
# ENET_OUTPUT_FOLDER's override applies, so the log for every run of this
# config lands there instead of under the _3a_quant_O4_int8_no_asym folder;
# checkpoints themselves are unaffected since they're written after the
# override).
#
# IMPORTANT, already handled once (do not redo blindly if this job is reused
# for a different run): this config's debug.json has save_every=50, so
# checkpoint_latest.pth is only refreshed on epoch-boundary multiples of 50
# (checked directly -- it held current_epoch=100, ie. only through epoch 99,
# NOT 117) while checkpoint_best.pth updates on every new-best-EMA epoch and
# had already reached current_epoch=110. nnUNetv2_train --c always prefers
# checkpoint_latest.pth when present, so resuming as-is would have silently
# thrown away epochs 100-109. Fixed by archiving the stale latest as
# checkpoint_latest_epoch100_preresume.pth and copying checkpoint_best.pth
# over checkpoint_latest.pth, so --c now resumes from epoch 110 (~40 epochs
# remaining, not ~33/~50).
#
# Uses nnUNetv2_train's --c (continue) flag rather than a fresh
# nnUNetv2_train call: this restores network/optimizer/current_epoch/EMA/
# logger state from checkpoint_latest.pth (nnUNetTrainer.load_checkpoint),
# and because PolyLRScheduler recomputes lr = initial_lr*(1-epoch/num_epochs)
# **0.9 fresh from current_epoch on every call (nnUNetTrainer.py:876), this
# is a true continuation of the LR schedule to epoch 150 -- NOT a restart
# from initial_lr. Requires ENET_EPOCHS and every ENET_* architecture knob
# below to stay byte-identical to the original job (mismatched channels/
# bottlenecks/decoder/quant-bits would break state_dict loading; a different
# ENET_EPOCHS would change the polynomial schedule's endpoint and silently
# invalidate the "continuation" property).

DATASET_ID=501
DATASET_NAME="Dataset501_ARCADE"

RUN_NAME="3a_quant_O4_int8_no_asym"
TRAINER_CLASS="nnUNetTrainerENetQuant"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet configuration (must match postpruning_3a_quant_O4_int8_no_asym.job
#    exactly -- see header comment) -------------------------------------------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,8,8,2,1"

export ENET_DECODER_TYPE="upsample_conv"

export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0

export ENET_QUANT_BITS=8

export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (resume)"

echo "Configuration:"
echo "  Channels:    ${ENET_CHANNELS}"
echo "  Bottlenecks: ${ENET_BOTTLENECKS}"
echo "  Decoder:     ${ENET_DECODER_TYPE}"
echo "  Dilated:     ${ENET_USE_DILATED}"
echo "  Asymmetric:  ${ENET_USE_ASYMMETRIC}"
echo "  Strided:     ${ENET_USE_STRIDED}"
echo "  DSC:         ${ENET_USE_DSC}"
echo "  Quant bits:  ${ENET_QUANT_BITS}"

echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking training state for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists -- training already reached 150 epochs, skipping straight to collect_results.py."
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    echo "=== Resuming training (QAT) from checkpoint_latest.pth: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
else
    echo "ERROR: no checkpoint_latest.pth or checkpoint_final.pth at ${ENET_OUTPUT_FOLDER} -- nothing to resume from." >&2
    exit 1
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 3a_quant \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --quant-bits "${ENET_QUANT_BITS}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
