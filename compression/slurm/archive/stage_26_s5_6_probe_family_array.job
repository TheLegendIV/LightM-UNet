#!/bin/bash
#SBATCH --job-name=stage_26_s5_6_probe_family
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-7
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 26 -- 8-way probe family derived from S5-SeparableDense
# (5_6_separable_dense_dilation: channels=4,16,32,16,4, bottlenecks=
# 4,8,8,2,1, context_pattern=dense_dilation, separable_dilated=1,
# dice=0.7985, see compression/results.csv). Cost-screened first via
# compression/finn_cost_s5_6_variants.py's closed-form FINN-R INT8 estimates
# before committing any of these to real training.
#
# Two composable modifications on top of S5.6's recipe:
#   - "d1 lead-in": a plain dilation=1 slot prepended to each (2,4,8,16)
#     cycle (1,2,4,8,16,1,2,4,8,16, 10 slots vs. the native 8) -- needed a
#     NEW context_pattern, ENet.py's context_pattern="dense_dilation_lead1"
#     (DENSE_DILATION_LEAD1_PATTERN), since dense_dilation's native 4-slot
#     cycle has no d=1 rung at all. Requires ENET_BOTTLENECKS stage2/stage3
#     entries widened to 10. See ENet.py's own "dense_dilation_lead1
#     self-test" for the verified block-count/dilation-order/forward-pass
#     checks (0 new bottleneck class needed -- d=1 is built through the
#     exact same RegularBottleneck/separable_dilated path as every other
#     rate in the cycle, unlike the reg-bookend patterns' {"reg_bottleneck":
#     True} sentinel).
#   - "no stage3": bottlenecks_per_stage[2]=0 removes stage3 entirely,
#     stage2 alone carries the context pattern. 0 new code -- the same
#     div4 mechanism ENet.py's own sparse-dilation-pattern self-test
#     (div2/div4) already exercises and verifies generalizes to any
#     context_pattern, not just "sparse".
#
#   0: 26_1_u8style               -- CHANNELS=4,8,16,8,4 (S5.6's own channels
#      divided by 2, floored at 4). Plain channel shrink, no other change.
#   1: 26_2_d1leadin              -- d1 lead-in only (BOTTLENECKS=4,10,10,2,1,
#      CONTEXT_PATTERN=dense_dilation_lead1).
#   2: 26_3_no_stage3             -- no stage3 only (BOTTLENECKS=4,8,0,2,1).
#   3: 26_4_d1leadin_no_stage3    -- both of the above combined
#      (BOTTLENECKS=4,10,0,2,1, CONTEXT_PATTERN=dense_dilation_lead1).
#   4: 26_5_w24                   -- CHANNELS=4,8,24,8,4 (S5.6's own channels
#      with stage2/3 width bumped 32->24), no other change.
#   5: 26_6_w24_no_stage3         -- 26_5's channels + no stage3.
#   6: 26_7_w24_no_stage3_d1leadin -- 26_6 + d1 lead-in on top
#      (BOTTLENECKS=4,10,0,2,1, CONTEXT_PATTERN=dense_dilation_lead1).
#   7: 26_8_w24_no_stage3_d1leadin_halved -- 26_7's own channels halved
#      again (floor 4): CHANNELS=4,8,24,8,4 -> 4,4,12,4,4, same
#      BOTTLENECKS/CONTEXT_PATTERN as 26_7.
#
# S5.6 itself (dice=0.7985, params=22513) intentionally excluded -- already
# trained, this array is only the 8 new variants.
#
# Everything else fixed at S5.6's own recipe: decoder_type=upsample_conv,
# use_prelu=1 (prelu_variant=standard, matching S5.6 -- NOT nonneg_block),
# use_asymmetric=0, use_dilated=1, use_strided=1, use_dsc=0,
# dsc_no_projection=0, separable_dilated=1.
#
# Confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c, ENET_DISABLE_CHECKPOINTING=1)
# at all 8 configs: build + forward + backward + optimizer step, no error.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(26_1_u8style 26_2_d1leadin 26_3_no_stage3 26_4_d1leadin_no_stage3
              26_5_w24 26_6_w24_no_stage3 26_7_w24_no_stage3_d1leadin
              26_8_w24_no_stage3_d1leadin_halved)
CHANNELS_ARR=("4,8,16,8,4" "4,16,32,16,4" "4,16,32,16,4" "4,16,32,16,4"
              "4,8,24,8,4" "4,8,24,8,4" "4,8,24,8,4" "4,4,12,4,4")
BOTTLENECKS_ARR=("4,8,8,2,1" "4,10,10,2,1" "4,8,0,2,1" "4,10,0,2,1"
                 "4,8,8,2,1" "4,8,0,2,1" "4,10,0,2,1" "4,10,0,2,1")
CONTEXT_PATTERN_ARR=(dense_dilation dense_dilation_lead1 dense_dilation dense_dilation_lead1
                      dense_dilation dense_dilation dense_dilation_lead1 dense_dilation_lead1)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S5.6's own recipe, channels/bottlenecks/context_pattern swept --
export ENET_CHANNELS="${CHANNELS_ARR[$TASK_ID]}"
export ENET_BOTTLENECKS="${BOTTLENECKS_ARR[$TASK_ID]}"
export ENET_CONTEXT_PATTERN="${CONTEXT_PATTERN_ARR[$TASK_ID]}"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SEPARABLE_DILATED=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS} ENET_BOTTLENECKS=${ENET_BOTTLENECKS} ENET_CONTEXT_PATTERN=${ENET_CONTEXT_PATTERN}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth (written once, at the very end of a finished
# num_epochs-epoch run) counts as "already trained" -- checkpoint_best.pth
# gets written as early as epoch 0, see stage_8's own job file for the
# incident this guards against.
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 26_s5_6_probe_family \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --separable-dilated "${ENET_SEPARABLE_DILATED}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
