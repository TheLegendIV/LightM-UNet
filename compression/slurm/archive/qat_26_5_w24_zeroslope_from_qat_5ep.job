#!/bin/bash
#SBATCH --job-name=qat_26_5_w24_zeroslope_from_qat_5ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=00:45:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 5-epoch DIAGNOSTIC run, a DIFFERENT architecture/experiment from the
# 26_9_w24_s14w12_nonneg_block investigation (see that architecture's own
# qat_*.job files for the fuller stuck-training history) -- tests whether
# introducing the leaky-slope decomposition mechanism onto an ALREADY
# quantization-adapted network (real QAT-trained, not just FP32) avoids
# whatever destabilizes it when introduced fresh from an FP32 checkpoint.
#
# Uses nnUNetTrainerENetQuant26_5_w24BlockZeroSlopeFromQAT (new trainer,
# NOT nnUNetTrainerENetQuant26_5_w24Block itself -- see that new file's
# own module docstring for the full mechanism): warm-starts
# QuantENet26_5_w24 from nnUNetTrainerENetQuant26_5_w24Block_26_5_w24_
# qat_block_bits's own REAL QAT-trained checkpoint (dice=0.6806, trained
# with block_bits_26_5_w24.json, frozen slope from a "standard"-prelu
# lossy-averaged map -- see compression/results.csv), with every
# `.alpha`/`.one_minus_alpha` key EXPLICITLY EXCLUDED from the transfer
# (that source checkpoint's own alpha values are real but were trained
# under different -- frozen -- conditions; a naive from_pretrained-style
# transfer would silently pull them in by name+shape match, overriding
# the fresh zero-init this experiment wants). Every other key (conv/BN
# weights, already adapted to this exact bit assignment's real
# quantization noise over a full QAT run) transfers normally -- verified
# locally: 721/820 keys transferred, ALL 83 alpha parameters confirmed
# still exactly 0.0 after the warm-start (not silently overwritten).
#
# SAME bit assignment the source checkpoint itself was trained with
# (block_bits_26_5_w24.json, UNCHANGED) -- isolates the leaky-slope
# mechanism's own effect, not a bit-assignment change at the same time.
# trainable_slope=True (hardcoded in QuantENet26_5_w24 itself, always on).
#
# Smoke-tested locally (1 epoch/2 iterations, ENET_DISABLE_CHECKPOINTING=1):
# build + warm-start (721/820 transferred, alpha confirmed zeroed) +
# forward + backward + optimizer step, no error.
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=5, same LR-schedule-
# preservation rule as every other diagnostic job in this repo.
#
# No collect_results.py step -- training-log-only diagnostic.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_5_w24_qat_zeroslope_from_qat_5ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_5_w24BlockZeroSlopeFromQAT"

SOURCE_QAT_NET_NAME="nnUNetTrainerENetQuant26_5_w24Block_26_5_w24_qat_block_bits"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_26_5_w24.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_5_w24_zeroed.json"
SOURCE_QAT_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_QAT_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_5_W24_ZEROSLOPE_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_5_W24_ZEROSLOPE_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_5_W24_ZEROSLOPE_QAT_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_QAT_CHECKPOINT}"
# Full 150-epoch schedule, early-stopped at 5 real epochs (diagnostic).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=5
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (5-epoch diagnostic, LR schedule of ${ENET_EPOCHS} epochs)"
echo "Block bits file:            ${ENET26_5_W24_ZEROSLOPE_BLOCK_BITS_FILE}"
echo "Slope map file (zeroed):    ${ENET26_5_W24_ZEROSLOPE_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start QAT checkpoint:  ${ENET26_5_W24_ZEROSLOPE_QAT_CHECKPOINT}"
echo "Output folder:              ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_5_W24_ZEROSLOPE_BLOCK_BITS_FILE" "$ENET26_5_W24_ZEROSLOPE_LEAKY_SLOPE_MAP_FILE" "$ENET26_5_W24_ZEROSLOPE_QAT_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT diagnostic): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines directly from this log to judge whether training stays stable (starting dice should be close to the source checkpoint's own 0.68, not collapsed)."
