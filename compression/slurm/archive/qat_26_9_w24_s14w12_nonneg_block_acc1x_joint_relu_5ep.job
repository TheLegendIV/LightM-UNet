#!/bin/bash
#SBATCH --job-name=qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_relu_5ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=00:45:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 5-epoch DIAGNOSTIC run, third retry after both prior attempts on this
# architecture's own acc1x_joint bit assignment got stuck at pseudo-dice
# 0.0:
#   1. qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_15ep.job -- real
#      trained nonneg_block slope map, trainable_slope=True. STUCK
#      through epoch 10.
#   2. qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_zeroslope_15ep.job --
#      same, but every block's slope started at 0.0 instead of its real
#      trained value (still trainable_slope=True, still a real
#      QuantDecomposedLeakyAct site, just a gentler on-ramp). STUCK again.
#
# This run isolates a cleaner question than "trainable vs frozen vs
# zero-init slope": does the leaky-slope decomposition mechanism itself
# (QuantDecomposedLeakyAct + its alpha scalar, regardless of trainable/
# frozen/init value) have anything to do with the stuck training, or is
# it unrelated? No leaky_slope_map is passed here at all -- every mapped
# site's negative_slope is None, so QuantENet26_9_w24_s14w12_nonneg_block
# falls back to plain QuantReLU everywhere (same "if negative_slope is
# None: use plain QuantReLU" convention every other QuantENet file in
# this repo already uses for its own unmapped/decoder blocks). No alpha
# parameter or buffer exists anywhere in this build at all.
#
# SAME bit assignment as both prior stuck attempts (block_bits_
# 26_9_w24_s14w12_nonneg_block_acc1x_joint.json, UNCHANGED) and the same
# FP32 warm-start checkpoint -- only the activation mechanism differs.
#
# If this ALSO gets stuck: the leaky-slope machinery is cleared as a
# suspect entirely, and the real cause is something else (the bit
# assignment itself, the warm-start transfer, or a latent bug specific to
# this architecture's own new QuantENet file). If this trains normally:
# the leaky-slope decomposition itself is implicated, independent of
# trainable/frozen/init-value choices already ruled out above.
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=5 (5-epoch diagnostic, per
# request -- shorter than the two 15-epoch prior attempts since both of
# those were already unambiguously flat well before epoch 10).
#
# No collect_results.py step -- training-log-only diagnostic.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_9_w24_s14w12_nonneg_block_qat_acc1x_joint_relu_5ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"

SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
# Deliberately NOT set: ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE
# -- no slope map at all -> plain QuantReLU everywhere, no alpha.
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch schedule, early-stopped at 5 real epochs (diagnostic).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=5
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (5-epoch diagnostic, LR schedule of ${ENET_EPOCHS} epochs, plain ReLU -- no slope map)"
echo "Block bits file:       ${ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE}"
echo "Slope map file:        (none -- plain QuantReLU)"
echo "Warm-start checkpoint: ${ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT diagnostic): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines directly from this log to judge whether training recovered normally."
