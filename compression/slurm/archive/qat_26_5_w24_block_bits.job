#!/bin/bash
#SBATCH --job-name=qat_26_5_w24_block_bits
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=08:00:00
# See the WALLTIME WARNING below before submitting -- this --time is a
# placeholder, not a real estimate for 150 real epochs. A local docker
# smoke test (weak shared 4GB RTX 2050, NOT this partition's real GPU) timed
# epoch 0 (2 iterations) at ~73-75s/iteration for THIS architecture -- at
# that rate, 150 epochs x nnU-Net's default 250 iterations/epoch (37500
# total) would be ~776 HOURS (~32 days). Do not submit this as a single job
# without first either (a) getting a real per-iteration timing number on
# the actual target GPU, or (b) cutting ENET_ITERATIONS_PER_EPOCH down (the
# same lever hawq_23_1_qat_stage_bits.job already pulled, to 60/epoch, for
# exactly this reason) or (c) chaining multiple resumed jobs via nnU-Net's
# own --c flag (see resume_hawq_23_1_qat_stage_bits.job's pattern) -- this
# job does none of those automatically, per explicit request for a genuine
# 150-epoch/default-iterations run.
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# QAT (quantization-aware training) of the HAWQ-searched PER-BLOCK (not
# per-stage) W/A quantization scheme (compression/hawq/artifacts/block_bits_26_5_w24.json,
# one independent weight/activation bit-width per individual ENet bottleneck
# -- see compression/hawq/block_utils.py's enumerate_blocks) on
# nnUNetTrainerENet_26_5_w24's exact architecture (S5-SeparableDense with
# stage2/3 width bumped 32->24, see compression/slurm/
# stage_26_s5_6_probe_family_array.job), via nnUNetTrainerENetQuant26_5_w24Block
# (enet/nnunetv2/training/nnUNetTrainer/nnUNetTrainerENetQuant26_5_w24Block.py).
#
# WALLTIME WARNING: local docker smoke test (1 epoch/2 iterations, weak
# shared 4GB RTX 2050 -- NOT this partition's real GPU) timed epoch 0 at
# ~149s/2 iterations both cold- and warm-started (~73-75s/iteration) for
# THIS architecture. hawq_23_1_qat_stage_bits.job (same per-stage QAT idea,
# different architecture) separately measured ~21.6s/train-iteration on
# its own real HPC run and still deliberately cut ENET_ITERATIONS_PER_EPOCH
# from nnU-Net's 250 default down to 60 for walltime reasons. THIS job's own
# ENET_ITERATIONS_PER_EPOCH is left UNSET (real 250/epoch default), per
# explicit request for a genuine 150-epoch/default-iterations run -- at the
# local ~74s/iteration rate that's 150*250=37500 iterations, ~776 HOURS
# (~32 days), likely far past any realistic single-job allocation even
# accounting for a real HPC GPU being faster than a shared 4GB card. Do not
# submit this as-is without either (a) confirming a real per-iteration
# timing number on the actual target GPU first, (b) deliberately setting
# ENET_ITERATIONS_PER_EPOCH lower (the same lever hawq_23_1_qat_stage_bits.job
# already pulled), or (c) chaining multiple resumed jobs via nnU-Net's own
# --c flag (see resume_hawq_23_1_qat_stage_bits.job's pattern) -- this job
# does none of those automatically.
#
# Decomposed-nonneg-PReLU activation (QuantDecomposedLeakyAct, ENET26_5_W24_
# LEAKY_SLOPE_MAP_FILE below): 26_5_w24 is prelu_variant="standard" (REAL
# per-channel PReLU), NOT prelu_variant="nonneg_block" -- unlike
# nnUNetTrainerENetQuant23_1's own slope map (a genuinely TRAINED per-block
# scalar), this one is compression/post-quantization/extract_leaky_slope_map.py
# --prelu-variant standard's POST-HOC per-channel average, with no
# retraining behind it at all. This repo's own compression/results.csv
# (experiment_leaky_from_prelu_global/_perblock rows) already found that
# exact operation collapses this same S5.6 lineage's dice from 0.7985 to
# ~0.38-0.41 when evaluated WITHOUT retraining (see QuantENet26_5_w24.py's
# own module docstring for the full citation) -- QAT is specifically the
# setting where that flagged choice becomes defensible again, since every
# weight here gets a real chance (150 epochs of backprop, not zero) to
# re-adapt to the now-fixed per-block slope, not just plain PTQ calibration.
#
# Warm-started from 26_5_w24's own trained FP32 checkpoint
# (ENET26_5_W24_PRETRAINED_CHECKPOINT below) -- same warm-start-by-default
# choice hawq_23_1_qat_stage_bits.job made for its own architecture, for
# the same reason: QuantENet26_5_w24.from_pretrained's own strict=False
# name+shape transfer already sidesteps nnU-Net's generic -pretrained_weights
# flag's Brevitas scaling_impl.value quirk, so there's no technical reason
# to throw away 26_5_w24's own trained weights and cold-start instead.
#
# Confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c, ENET_DISABLE_CHECKPOINTING=1,
# killed before nnU-Net's own post-training full-validation pass rather than
# waiting it out -- Brevitas inference is also much slower per-case than
# FP32, and that pass isn't part of what a smoke test needs to verify):
# nnUNetTrainerENetQuant26_5_w24Block builds, warm-starts (721/919 keys
# transferred, 0 shape mismatches), and runs a real forward+backward+
# optimizer step (train_loss logged, checkpoint saved) without error, both
# cold-started and warm-started.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_5_w24_qat_block_bits"
TRAINER_CLASS="nnUNetTrainerENetQuant26_5_w24Block"

SOURCE_NET_NAME="nnUNetTrainerENet_26_5_w24"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_26_5_w24.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_5_w24.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_5_W24_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_5_W24_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_5_W24_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch budget, nnU-Net's real default 250 iterations/epoch --
# ENET_ITERATIONS_PER_EPOCH deliberately left UNSET, see WALLTIME WARNING
# above.
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "Block bits file:       ${ENET26_5_W24_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET26_5_W24_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET26_5_W24_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_5_W24_BLOCK_BITS_FILE" "$ENET26_5_W24_LEAKY_SLOPE_MAP_FILE" "$ENET26_5_W24_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        echo "  (run compression/hawq/block_sensitivity.py -> finn_block_costs.py -> ilp_search.py, and/or" >&2
        echo "   compression/post-quantization/extract_leaky_slope_map.py --prelu-variant standard, first)" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
SLOPE_MAP_JSON=$(python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage experiment_26_5_w24_qat_block_bits \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels 4,8,24,8,4 \
    --bottlenecks 4,8,8,2,1 \
    --decoder-type upsample_conv \
    --use-asymmetric 0 \
    --context-pattern dense_dilation \
    --separable-dilated 1 \
    --leaky-slope-map "$SLOPE_MAP_JSON" \
    --quant-bits 32 \
    --trainer-class "${TRAINER_CLASS}"
# --quant-bits 32 here is a deliberate placeholder (see compression/
# collect_results.py's own params/flops/bops handling): it builds a
# homogeneous-precision FP32 reference model purely to count params/FLOPs,
# NOT the real per-block-quantized architecture -- collect_results.py has
# no per-block-aware cost path yet. Real per-block params/bops/LUT/BRAM
# already live in compression/hawq/artifacts/finn_block_costs_26_5_w24.json /
# block_bits_26_5_w24.json / folding_block_26_5_w24.json -- pull from there,
# don't trust this row's own params/flops/bops columns.

echo "Done: ${RUN_NAME}."
