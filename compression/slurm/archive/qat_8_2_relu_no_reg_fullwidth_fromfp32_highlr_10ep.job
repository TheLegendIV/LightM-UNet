#!/bin/bash
#SBATCH --job-name=qat_8_2_relu_no_reg_fullwidth_fromfp32_highlr_10ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Alternative diagnostic to qat_8_2_relu_no_reg_fullwidth_25ep.job's own
# calibrate-then-fine-tune pipeline: this job SKIPS calibration entirely and
# warm-starts real QAT training DIRECTLY from the raw FP32 checkpoint
# (nnUNetTrainerENet_8_2_relu_no_reg_fullwidth), at a much higher LR
# (0.005, 5x the base 0.001 default) -- motivated by (a) the real HPC
# calibrated-warm-start run looking stuck at the default LR after 25 real
# epochs, and (b) this session's own local proxy test (compression/
# qat_smoke_8_2_relu_no_reg_fullwidth.py) showing LR=0.005 clearly
# unsticks training faster than default when warm-started from the
# CALIBRATED checkpoint. This job tests the more aggressive hybrid
# question directly on real HPC data: does a high-enough LR let training
# recover even WITHOUT calibration's own scale initialization at all, as a
# simpler one-step alternative to the two-step calibrate+fine-tune
# pipeline?
#
# Uses the SAME nnUNetTrainerCombinedQuantENet_8_2_relu_no_reg_fullwidth
# trainer + the SAME real HAWQ mixed per-stage bits (compression/hawq/
# stage_bits_8_2_relu_no_reg_fullwidth_minres.json) as the calibrated
# pipeline -- ENET_PRETRAINED_CHECKPOINT just points at the raw FP32
# checkpoint instead of a calibrated one, and calibration_mode() is never
# invoked at all in this job. Separate output folder from the calibrated
# run (does not touch/interfere with it).
#
# ENET_EPOCHS=150 sets the REAL PolyLR schedule length (same convention as
# every other diagnostic job this session); ENET_MAX_EPOCHS_TO_RUN=10 caps
# THIS submission to the first 10 epochs. Resume logic mirrors the sibling
# job's own already-fixed current_epoch-vs-ENET_EPOCHS gate (checkpoint_
# final.pth can exist at a PARTIAL epoch count, --c needed to continue, and
# the trainer's own load_checkpoint() override handles the Brevitas cuda/
# cpu re-materialization quirk on such a resume).
#
# Smoke-tested locally (1 epoch, docker, ENET_MAX_EPOCHS_TO_RUN=1, warm-
# starting directly from the real FP32 checkpoint, no calibration step at
# all) before this job was written.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerCombinedQuantENet_8_2_relu_no_reg_fullwidth"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_8_2_relu_no_reg_fullwidth"
RUN_NAME="8_2_relu_no_reg_fullwidth_qat_fromfp32_highlr"
STAGE_BITS_FILE="compression/hawq/artifacts/stage_bits_8_2_relu_no_reg_fullwidth_minres.json"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT -- run stage_8_2_relu_no_reg_fullwidth.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

echo "=== Real QAT training, NO calibration step -- warm-started directly from FP32, LR=0.005 ==="
export ENET_STAGE_BITS_FILE="$HOME/LightM-UNet/${STAGE_BITS_FILE}"
export ENET_PRETRAINED_CHECKPOINT="${FP32_CHECKPOINT}"
export ENET_LR=0.005
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=10
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real 150-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME 150-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real 150-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    python compression/collect_results.py \
        --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
        --stage 8_2_relu_no_reg_fullwidth_qat_fromfp32_highlr \
        --dataset-name "${DATASET_NAME}" \
        --dataset-id "${DATASET_ID}" \
        --channels 4,16,32,16,4 \
        --bottlenecks 4,8,8,2,1 \
        --decoder-type upsample_conv \
        --use-asymmetric 0 \
        --context-pattern dense_dilation \
        --separable-dilated 0 \
        --quant-bits 8 \
        --trainer-class "${TRAINER_CLASS}"
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
