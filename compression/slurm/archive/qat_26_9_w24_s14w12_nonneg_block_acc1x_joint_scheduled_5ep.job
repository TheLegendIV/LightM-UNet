#!/bin/bash
#SBATCH --job-name=qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_scheduled_5ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=00:45:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 5-epoch DIAGNOSTIC run, fourth attempt in the stuck-training investigation
# on this architecture's own acc1x_joint bit assignment. Prior attempts:
#   1. Real trained nonneg_block slope map, trainable_slope=True from
#      epoch 0 -- STUCK through epoch 10.
#   2. Same, but every slope started at 0.0 -- STUCK again.
#   3. No slope map at all (plain QuantReLU, no alpha anywhere) -- NOT
#      stuck (see qat_..._acc1x_joint_relu_5ep.job's own real HPC result).
#
# (3) pointed at QuantDecomposedLeakyAct's own mechanism (3 chained
# fake-quant ops per site vs plain QuantReLU's 1, at this architecture's
# often-2-bit activation widths) rather than trainable-vs-frozen-vs-init-
# value. A local smoke test of the exact scheduling mechanism THIS job
# uses (1 iteration/epoch toy scale, not a real result on its own) showed
# a strikingly clean version of that same story: epochs 0-1 in plain FP32
# (QuantDecomposedLeakyAct.quant_enabled=False, no fake-quant noise in the
# leaky path at all) had a healthy, improving pseudo-dice trajectory; the
# INSTANT quant_enabled flipped True at epoch 2, train_loss jumped and
# dice collapsed to 0.0 in that same epoch. Mechanically correct (fired
# exactly on schedule) and a strong directional match -- this real run is
# the first test at real batch/iteration counts.
#
# THIS RUN combines three independently-built levers (see
# nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock.py's own module
# docstring for the full mechanism of each):
#   - ENET26_9_..._QUANT_LEAKY_FROM_EPOCH=2 -- every QuantDecomposedLeakyAct
#     site runs in plain FP32 (exact alpha*x+(1-alpha)*relu(x) identity, no
#     fake-quant) for epochs 0-1, switches to the real quantized computation
#     from epoch 2 onward. Lets the network stabilize under normal weight/
#     activation quantization (elsewhere in the net) BEFORE also absorbing
#     the leaky path's own extra 3x-chained quantization noise.
#   - ENET26_9_..._UNFREEZE_SLOPE_EPOCH=2 -- alpha (real trained nonneg_block
#     scalar, NOT zeroed here) has requires_grad=False for epochs 0-1, True
#     from epoch 2 onward. Combined with the above: alpha stays fixed at
#     its real, already-meaningful value throughout the FP32 warm-up, then
#     both "quantize the leaky path" and "let gradients touch alpha" turn
#     on together at the same epoch (not staggered further -- keeping this
#     first real test to one transition point, not two).
#   - ENET26_9_..._ALPHA_LR_SCALE=0.1 -- once trainable (epoch 2+), alpha
#     gets its own optimizer param group at 0.1x the main LR (zero weight
#     decay) instead of sharing the main group's LR/decay -- softens
#     whatever gradient signal alpha receives right at the most sensitive
#     moment (transition epoch), on top of (not instead of) the above.
#
# SAME bit assignment as every prior attempt (block_bits_
# 26_9_w24_s14w12_nonneg_block_acc1x_joint.json, UNCHANGED) and the same
# FP32 warm-start checkpoint. Real trained slope map (compression/post-
# quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json), not zeroed --
# alpha is frozen at this real value during the FP32 warm-up anyway, so
# starting it at 0 would provide no benefit here (unlike attempt 2 above,
# where alpha was trainable AND quantized from epoch 0 simultaneously).
#
# Smoke-tested locally (1 epoch/2 iterations at these exact env var
# values, ENET_DISABLE_CHECKPOINTING=1): build + forward + backward +
# optimizer step, no error. The 4-epoch/1-iteration schedule-mechanism
# check described above (separate from this job's own formal smoke test)
# additionally confirmed the epoch-triggered transitions fire exactly on
# schedule and are not silently no-ops.
#
# No collect_results.py step -- training-log-only diagnostic.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_9_w24_s14w12_nonneg_block_qat_acc1x_joint_scheduled_5ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"

SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_QUANT_LEAKY_FROM_EPOCH=2
export ENET26_9_W24_S14W12_NONNEG_BLOCK_UNFREEZE_SLOPE_EPOCH=2
export ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE=0.1
# Full 150-epoch schedule, early-stopped at 5 real epochs (diagnostic).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=5
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (5-epoch diagnostic, LR schedule of ${ENET_EPOCHS} epochs)"
echo "quant_leaky_from_epoch=${ENET26_9_W24_S14W12_NONNEG_BLOCK_QUANT_LEAKY_FROM_EPOCH} unfreeze_slope_epoch=${ENET26_9_W24_S14W12_NONNEG_BLOCK_UNFREEZE_SLOPE_EPOCH} alpha_lr_scale=${ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE}"
echo "Block bits file:       ${ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT diagnostic): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines directly from this log to judge whether training recovered normally, and specifically whether it stays healthy PAST the epoch-2 transition."
