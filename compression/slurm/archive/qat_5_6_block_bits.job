#!/bin/bash
#SBATCH --job-name=qat_5_6_block_bits
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=10:00:00
# WALLTIME (corrected 2026-08-25 -- an earlier version of this comment cited
# qat_26_5_w24_block_bits.job's own LOCAL-docker-smoke-test-derived estimate,
# ~776 real hours -- NOT what actually happened on real HPC hardware).
# qat_26_5_w24_block_bits.job (same class family, same context_pattern=
# dense_dilation, same separable_dilated=1, same 150 epochs x 250 iterations/
# epoch) actually ran on this partition and completed ALL 150 epochs to
# checkpoint_final.pth WITHOUT needing a resume, within its own 08:00:00
# budget -- i.e. real HPC rate was <=(8h*3600s)/(150*250)=0.768s/iteration,
# not the ~73-75s/iteration the local smoke test measured (~100x slower
# than reality). S5.6's own stage2/3 is wider (32 vs 26_5_w24's narrowed
# 24), so expect a SOMEWHAT higher real per-iteration cost than that bound,
# not the same one -- this --time=10:00:00 (more than 26_5_w24's own
# 08:00:00) is the margin for that, but isn't guaranteed sufficient.
# resume_qat_5_6_block_bits.job is prepared as a safety net in case it
# isn't (same pattern as resume_qat_s19_block_bits.job/
# resume_qat_s19_block_bits_joint.job).
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# QAT (quantization-aware training) of the HAWQ-searched PER-BLOCK (not
# per-stage) W/A quantization scheme (compression/hawq/artifacts/block_bits_5_6.json,
# one independent weight/activation bit-width per individual ENet bottleneck
# -- see compression/hawq/block_utils.py's enumerate_blocks) on the classic,
# already-trained nnUNetTrainerENet_5_6_separable_dense_dilation ("S5.6")
# architecture, via nnUNetTrainerENetQuant5_6Block (enet/nnunetv2/training/
# nnUNetTrainer/nnUNetTrainerENetQuant5_6Block.py).
#
# WALLTIME WARNING: see the #SBATCH block above -- do not submit as-is
# without either (a) confirming a real per-iteration timing number on the
# actual target GPU first, (b) deliberately setting ENET_ITERATIONS_PER_EPOCH
# lower (the same lever hawq_23_1_qat_stage_bits.job/qat_26_5_w24_block_bits.job
# already pulled), or (c) chaining multiple resumed jobs via nnU-Net's own
# --c flag (see resume_qat_s19_block_bits.job's pattern) -- this job does
# none of those automatically, per this repo's own "genuine 150-epoch/
# default-iterations run" convention for a first attempt.
#
# NONNEG-PRELU FOR THE QAT, PER EXPLICIT REQUEST (decomposed-nonneg-PReLU
# activation, QuantDecomposedLeakyAct, ENET5_6_LEAKY_SLOPE_MAP_FILE below):
# S5.6 is prelu_variant="standard" (REAL per-channel PReLU), NOT
# prelu_variant="nonneg_block" -- unlike nnUNetTrainerENetQuantS19Block's own
# slope map (a genuinely TRAINED per-block scalar), this one is
# compression/post-quantization/extract_leaky_slope_map.py --prelu-variant
# standard's POST-HOC per-channel average (compression/post-quantization/
# slope_maps/5_6_separable_dense_dilation.json, confirmed identical to
# compression/results.csv's own pre-existing experiment_leaky_from_prelu_perblock
# row's recorded values for this exact checkpoint), with NO retraining
# behind it at all. This repo's own compression/results.csv (experiment_
# leaky_from_prelu_global/_perblock rows) already found that exact operation
# collapses this same S5.6 lineage's dice from 0.7985 to ~0.38-0.41 when
# evaluated WITHOUT retraining -- QAT is specifically the setting where that
# flagged choice becomes defensible again, since every weight here gets a
# real chance (150 epochs of backprop, not zero) to re-adapt to the
# now-fixed per-block slope, not just plain PTQ calibration (same reasoning
# qat_26_5_w24_block_bits.job's own header already gives for its own,
# narrower S5.6 descendant).
#
# Warm-started from S5.6's own trained FP32 checkpoint
# (ENET5_6_PRETRAINED_CHECKPOINT below) -- same warm-start-by-default choice
# every other per-block QAT job in this repo makes: QuantENet5_6Block.
# from_pretrained's own strict=False name+shape transfer already sidesteps
# nnU-Net's generic -pretrained_weights flag's Brevitas scaling_impl.value
# quirk, so there's no technical reason to throw away S5.6's own trained
# weights and cold-start instead.
#
# TRAINABLE SLOPE (2026-08-25, RESTART -- a first attempt at this run used
# the slope FROZEN, the ORIGINAL QuantDecomposedLeakyAct behavior; that
# attempt is being discarded): 27 real epochs on real HPC hardware showed
# train_loss falling steadily while Pseudo dice never moved off ~0.0 --
# worse than even the documented no-retrain floor (~0.38-0.41) this
# averaged map alone was known to produce. QuantENet5_6Block.py now passes
# trainable_slope=True at every encoder activation site (see
# QuantDecomposedLeakyAct's own docstring) -- the averaged value from
# ENET5_6_LEAKY_SLOPE_MAP_FILE is still the WARM-START initialization (same
# map, unchanged), but is no longer frozen, so gradients can correct a
# block's slope away from the average if the real per-channel distribution
# it was averaged from was too wide for one shared scalar to represent
# well. NOTE: 26_5_w24's own per-block QAT run (same architecture family,
# same forced-averaged-frozen-slope setup) completed successfully with a
# real dice of 0.6806 -- so frozen slopes alone do NOT fully explain S5.6's
# stuck-at-zero-dice failure; the per-block bit assignment itself may also
# be a contributing factor, not yet ruled out. This fix is a genuine change
# to test, not a confirmed complete solution.
#
# Confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c, ENET_VAL_ITERATIONS_PER_EPOCH=1,
# ENET_DISABLE_CHECKPOINTING=1): nnUNetTrainerENetQuant5_6Block builds with
# block_bits_5_6.json + trainable_slope=True, warm-starts from S5.6's own
# FP32 checkpoint_final.pth (721/820 keys transferred, 0 shape mismatches --
# fewer keys than the frozen-slope build's own 721/919 since one_minus_alpha
# is no longer a separately-stored buffer, computed dynamically instead),
# and completes a real forward+backward+optimizer step end to end
# ("Training done.", train_loss=3.5216, epoch time 94.92s).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="5_6_qat_block_bits"
TRAINER_CLASS="nnUNetTrainerENetQuant5_6Block"

SOURCE_NET_NAME="nnUNetTrainerENet_5_6_separable_dense_dilation"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_5_6.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/5_6_separable_dense_dilation.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET5_6_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET5_6_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET5_6_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch budget, nnU-Net's real default 250 iterations/epoch --
# ENET_ITERATIONS_PER_EPOCH deliberately left UNSET, see WALLTIME WARNING
# above.
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "Block bits file:       ${ENET5_6_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET5_6_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET5_6_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET5_6_BLOCK_BITS_FILE" "$ENET5_6_LEAKY_SLOPE_MAP_FILE" "$ENET5_6_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        echo "  (run compression/hawq/block_sensitivity.py -> finn_block_costs.py -> ilp_search.py, and/or" >&2
        echo "   compression/post-quantization/extract_leaky_slope_map.py --prelu-variant standard, first)" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
SLOPE_MAP_JSON=$(python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage experiment_5_6_qat_block_bits \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels 4,16,32,16,4 \
    --bottlenecks 4,8,8,2,1 \
    --decoder-type upsample_conv \
    --use-asymmetric 0 \
    --context-pattern dense_dilation \
    --separable-dilated 1 \
    --leaky-slope-map "$SLOPE_MAP_JSON" \
    --quant-bits 32 \
    --trainer-class "${TRAINER_CLASS}"
# --quant-bits 32 here is a deliberate placeholder (see compression/
# collect_results.py's own params/flops/bops handling): it builds a
# homogeneous-precision FP32 reference model purely to count params/FLOPs,
# NOT the real per-block-quantized architecture -- collect_results.py has
# no per-block-aware cost path yet. Real per-block params/bops/LUT/BRAM
# already live in compression/hawq/artifacts/finn_block_costs_5_6.json /
# block_bits_5_6.json / folding_block_5_6.json -- pull from there, don't
# trust this row's own params/flops/bops columns. As of 2026-08-25's
# bit-width-aware recalibration (finn_cost_model.py's own
# _LUT_ANCHOR_FACTORS/_BRAM_ANCHOR_FACTORS comment), folding_block_5_6.json's
# own hard-capped (--hard-lut 0.70 --hard-bram 0.80), pure-latency
# (--lut-weight 0 --bram-weight 0) folding result: LUT 70.0% (AT the cap,
# the binding constraint), BRAM_18K 18.1% (well under its own 80% cap,
# non-binding), 3,092,480 total cycles (~= per-image latency). block_bits_5_6.json
# is a --joint search result (no two-pass counterpart exists for S5.6 yet).

echo "Done: ${RUN_NAME}."
