#!/bin/bash
#SBATCH --job-name=stage_10_reginterleaved_separable_projected
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-1
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 10 -- a "breeding" probe: crosses two configs that sit at opposite
# ends of the same Pareto frontier (dice vs. cost) rather than extending
# either one further on its own.
#
#   S5-SeparableDense (5_6_separable_dense_dilation, dice=0.7985): dense_
#   dilation pattern (8 slots, no reg-bookend), separable_dilated=1 applied
#   to a DENSE (non-DSC) conv -- factors the dilated k x k into a (k,1)+
#   (1,k) pair where BOTH taps stay full-rank (not depthwise), so the
#   saved term is quadratic in internal_channels and dominates the (k,1)+
#   (1,k) split's own fixed overhead -- a real params/MACs win (unlike the
#   same factoring applied to an already-depthwise DSC conv, which stage
#   9.5 built, self-tested, and dropped: linear savings, linear overhead,
#   net wash-to-loss). Cheap (22,513 params) but modest dice.
#
#   S8-ReLU (8_2_relu, dice=0.8218, current sweep leader): dense_dilation_
#   reg_interleaved pattern (11 slots, reg-bookend every 4 dilated slots)
#   + dsc_no_projection=1 (full-channel-width DSC, no reduce/expand) +
#   plain ReLU. Best dice in the sweep, but 534,016 buffer elements --
#   the RegInterleaved-lineage no-projection cost the whole compression/
#   buffer-memory analysis was built around.
#
# Both tasks here combine the two: dense_dilation_reg_interleaved's
# bookend structure (S8's proven contribution) + separable_dilated on a
# DENSE conv, projection kept throughout (dsc_no_projection=0, use_dsc=0 --
# S5's proven contribution, NOT stage 9.5's dropped depthwise version).
# Verified this needs zero new ENet.py code -- every piece already exists
# individually, this is the first time they're composed together. The
# reg-bookend slots (indices 0/5/10) naturally stay plain dense 3x3
# (dilation=1 skips separable_dilated's own `dilation != 1` guard), no
# special-casing needed. Measured before training (untrained model, thop +
# utils.count_buffer_elements): 29,905 params / 189.3M MACs / 147,328
# buffer elements -- buffer memory lands in S5's territory (147,328 vs.
# S5's 141,184), not S8's (534,016), since buffer size is controlled by
# keeping the projection, not by which factorization runs inside it.
#
#   0: 10_1_reginterleaved_separable_projected -- PReLU (S5's own default).
#   1: 10_2_reginterleaved_separable_projected_relu -- ReLU (S8's own
#      choice, existing flag, no new code). Included as its own task
#      rather than assumed: stage 9's identical PReLU->ReLU swap on a
#      DIFFERENT projection-kept config (9_1) made things WORSE
#      (0.7836 -> 0.7684), the opposite of what the same swap did to S8 --
#      ReLU-vs-PReLU has not generalized consistently across this sweep,
#      so it gets measured here rather than assumed either way.
#
# Both confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c) to build and train
# (forward+backward+optimizer) without error, and structurally verified in
# ENet.py's own self-test ("Stage-10 reg_interleaved+separable_dilated
# hybrid self-test": bookend slots are a plain dense 3x3 Conv2d with
# groups=1, dilated slots are a dense (non-depthwise, groups=1) (3,1)+
# (1,3) Sequential, both keep their reduce/expand projection).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(10_1_reginterleaved_separable_projected 10_2_reginterleaved_separable_projected_relu)
USE_PRELU_ARR=(1 0)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- reg_interleaved bookend + dense separable_dilated,
#    projection kept -----------------------------------------------------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,11,11,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation_reg_interleaved"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU="${USE_PRELU_ARR[$TASK_ID]}"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SEPARABLE_DILATED=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_USE_PRELU=${ENET_USE_PRELU}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth (written once, at the very end of a finished
# num_epochs-epoch run) counts as "already trained" -- checkpoint_best.pth
# gets written as early as epoch 0, see stage_8's own job file for the
# incident this guards against.
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 10_reginterleaved_separable_projected \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --separable-dilated "${ENET_SEPARABLE_DILATED}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
