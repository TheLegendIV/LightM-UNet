#!/bin/bash
#SBATCH --job-name=stage_2_special_ops
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-3
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 2_special_ops -- special-op ablation on the new 4-class objective
# (LAD/RCA/LCX/LM on Dataset509_ARCADE_1x1_4c), one flag flipped per task
# off the U4 cell of stage_1_naive_baseline_array.job (CHANNELS=4,16,32,16,4,
# BOTTLENECKS=4,8,8,2,1 native, DECODER_TYPE=upsample_conv, USE_PRELU=0,
# dilated/asymmetric/strided=1, dsc=0) -- that U4 run is the baseline every
# probe below compares against and is NOT retrained here (already covered
# by stage_1_naive_baseline_array.job's task 2). U4's channels happen to
# already be symmetric (f_i==f5==4, f1==f4==16), so no channel changes are
# needed to make the max-unpool probe valid.
#
# Each probe flips exactly ONE knob away from the U4 reference; every other
# knob stays pinned at the reference value. Hypotheses (see also the
# session's ablation-probe table):
#   0: prelu        -- USE_PRELU 0->1. H: PReLU-vs-ReLU gap may not be
#      constant across width -- may differ from the known binary-run
#      full-width (Baseline) number when measured at U4 specifically.
#      Large gap here -> case for the PReLU custom op (cheap, compiler-
#      level, not RTL). Small/similar gap -> ReLU substitution confirmed
#      safe, no further action.
#   1: maxunpool    -- DECODER_TYPE upsample_conv->max_unpool. H: full
#      pre-pool recall may help most at LM/bifurcation-adjacent classes
#      specifically. Large gap concentrated in LM/LAD/LCX confusion ->
#      build the scatter-unit RTL (index-transport already de-risked).
#      Small/uniform gap -> keep upsample_conv, cite this as justification.
#   2: no_dilated   -- USE_DILATED 1->0 (dilated bottlenecks replaced with
#      plain 3x3). H: load-bearing at binary (-2.3%); expect similar or
#      larger loss at 4-class given LM needs multi-scale context. Coming in
#      above curve unexpectedly would be surprising -- investigate before
#      trusting, likely a bug rather than a real finding.
#   3: no_asymmetric -- USE_ASYMMETRIC 1->0 (asymmetric 5x5 bottlenecks
#      replaced with regular). H: replicate the unexplained binary +0.3%
#      gain; test if it transfers to 4-class. Beats curve -> asymmetric
#      convs are actively harmful here, drop from all downstream probes,
#      free the parameter budget elsewhere. Doesn't transfer/reverses ->
#      binary finding was task-specific, investigate the original "todo:
#      why" before generalizing.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

# name, use_prelu, decoder_type, use_dilated, use_asymmetric
NAMES=(prelu maxunpool no_dilated no_asymmetric)
USE_PRELU=(1 0 0 0)
DECODER_TYPES=(upsample_conv max_unpool upsample_conv upsample_conv)
USE_DILATED=(1 1 0 1)
USE_ASYMMETRIC=(1 1 1 0)

TASK_ID=${SLURM_ARRAY_TASK_ID}
RUN_NAME="2_special_ops_${NAMES[$TASK_ID]}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- U4 reference, one flag flipped per task ----------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_CONTEXT_PATTERN="default"
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_USE_PRELU="${USE_PRELU[$TASK_ID]}"
export ENET_DECODER_TYPE="${DECODER_TYPES[$TASK_ID]}"
export ENET_USE_DILATED="${USE_DILATED[$TASK_ID]}"
export ENET_USE_ASYMMETRIC="${USE_ASYMMETRIC[$TASK_ID]}"
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_USE_PRELU=${ENET_USE_PRELU} ENET_DECODER_TYPE=${ENET_DECODER_TYPE}"
echo "ENET_USE_DILATED=${ENET_USE_DILATED} ENET_USE_ASYMMETRIC=${ENET_USE_ASYMMETRIC}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 2_special_ops \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
