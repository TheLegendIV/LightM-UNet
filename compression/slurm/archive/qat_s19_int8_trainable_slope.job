#!/bin/bash
#SBATCH --job-name=qat_s19_int8_trainable_slope
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=01:00:00
# DELIBERATELY SHORT (2026-08-25): this is a diagnostic ablation, not a
# publishable-dice run -- see the module comment below. 5 epochs x 250
# iterations/epoch = 1,250 iterations; at the ~1.07s/iteration real rate
# qat_s19_block_bits.job's own header measured on this partition, that's
# ~22 real minutes, comfortably inside this budget with margin for the
# post-training Dice check. 5 epochs is enough to see whether dice moves
# at all off this config's healthy ~0.51 PTQ starting point -- both the
# stuck joint run (exact 0.0 for 21 straight epochs) and the successful
# two-pass run (already climbing by epoch 2) resolved their fate well
# within their first 5 epochs.
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# ABLATION: isolates whether "trainable_slope=True" (see QuantENet.py's
# QuantDecomposedLeakyAct / QuantENetS19Block.py's 2026-08-25 restart
# comment) is itself sufficient/necessary for S19 per-block QAT to escape
# its near-zero PTQ starting point, INDEPENDENT of any low-bit per-block
# quantization noise.
#
# WHY THIS TEST: qat_s19_block_bits_joint.job's real HPC run (FROZEN slope,
# the pre-restart code) got stuck at a literal, unmoving Pseudo dice of
# [0.0, 0.0, 0.0, 0.0] for 21 straight real epochs while train_loss fell
# steadily -- unlike its two-pass sibling (qat_s19_block_bits.job), which
# already had nonzero, growing dice by epoch 2 and passed EMA=0.5 by epoch
# 22 under the SAME (frozen-slope) code. Two local diagnostics this same
# session ruled out the simplest explanations:
#   1. PTQ-only Dice (straight from the FP32 checkpoint + real block bits +
#      calibration, ZERO QAT steps) is ~0 for EVERY per-block config tried
#      so far, including the two-pass config that went on to reach a real
#      dice of 0.7458 -- so starting collapsed is universal, not specific
#      to the stuck configs.
#   2. A per-block activation-variance probe (compression/hawq/
#      diagnose_dead_blocks.py) found NO dead/saturated block in the joint
#      config's collapsed PTQ state -- every block has healthy variance,
#      actually higher than the two-pass config's, throughout the network.
#      So this isn't an information-destroying dead-unit collapse either.
#
# This job controls for the one remaining confound the "restart all, fix
# it" trainable-slope change introduced: instead of testing trainable_slope
# on a LOW-BIT per-block assignment (where quantization noise could itself
# be what makes recovery hard, independent of the slope), this uses a
# UNIFORM INT8 (W8A8, compression/hawq/artifacts/block_bits_s19_int8.json --
# every one of S19's 37 blocks set to 8/8, no ILP search involved) bit
# assignment, which local diagnostics confirm is NOT collapsed at PTQ time:
# compression/hawq/diagnose_ptq_collapse.py-style check on this exact file
# gave mean_foreground_dice=0.5124 straight from calibration (vs. the FP32
# source's own 0.6880) -- a normal, healthy INT8 PTQ starting point, unlike
# the ~0.0 every low-bit config starts from.
#
# INTERPRETATION once this finishes:
#   - If this INT8+trainable-slope run trains normally (dice climbs steadily
#     from its healthy ~0.51 starting point, no stuck-at-exact-0.0 plateau):
#     trainable_slope is not itself broken, and the earlier joint/S5.6
#     failures are a property of the LOW-BIT per-block assignment
#     (bit-width-driven optimization difficulty), not the slope mechanism.
#   - If this run ALSO gets stuck near its ~0.51 starting point or regresses
#     toward 0: something about trainable_slope itself (or the cold-restart/
#     optimizer-construction path it forces) is the actual problem,
#     independent of bit-width -- would need to be isolated further (e.g.
#     compare against a trainable_slope=False INT8 run).
#
# Uses nnUNetTrainerENetQuantS19Block (same trainer class as both the
# two-pass and joint per-block runs) -- only ENET_S19_BLOCK_BITS_FILE
# differs, plus trainable_slope=True is now unconditionally wired into
# QuantENetS19Block.py's encoder call sites (no separate flag to set here).
#
# WARM START: from S19's own FP32 checkpoint_final.pth (same source
# qat_s19_block_bits.job's own two-pass run used) -- NOT from either
# per-block QAT checkpoint, to keep this a clean, independent control
# rather than inheriting anything from the runs under investigation.
#
# Decomposed nonneg-PReLU activation (ENET_S19_LEAKY_SLOPE_MAP_FILE below):
# same slope map as every other S19 QAT job (identical architecture/
# prelu_variant, only the bit-widths differ) -- NOT optional, see
# qat_s19_block_bits.job's own header for the documented incident of
# skipping it.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="s19_qat_int8_trainable_slope"
TRAINER_CLASS="nnUNetTrainerENetQuantS19Block"

SOURCE_NET_NAME="nnUNetTrainerENet_19_reginterleaved_separable_nonneg_block_double_mid"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_s19_int8.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/19_reginterleaved_separable_nonneg_block_double_mid.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET_S19_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_S19_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET_S19_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Deliberately short: 5 epochs is enough to see whether the "stuck at
# exact 0.0" plateau reproduces (the joint run stayed there for 21+ epochs
# straight; the two-pass run had already broken away from ~0 by epoch 2) --
# see the module comment above. Not meant to reach a final/publishable
# dice number.
export ENET_EPOCHS=5
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (diagnostic ablation, ${ENET_EPOCHS} epochs)"
echo "Block bits file:       ${ENET_S19_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET_S19_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET_S19_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET_S19_BLOCK_BITS_FILE" "$ENET_S19_LEAKY_SLOPE_MAP_FILE" "$ENET_S19_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT ablation): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Post-training Dice check ==="
cd "$HOME/LightM-UNet"
python -c "
import torch, json
import sys
sys.path.insert(0, 'enet')
from nnunetv2.nets.QuantENetS19Block import QuantENetS19Block, OUT_CHANNELS
sys.path.insert(0, 'compression/hawq')
from eval_dice import evaluate
with open('${BLOCK_BITS_FILE}') as f: bits = json.load(f)
with open('${SLOPE_MAP_FILE}') as f: slope_map = json.load(f)
ckpt = torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)
model = QuantENetS19Block(bits['stage_weight_bits'], bits['stage_act_bits'], slope_map)
model.load_state_dict(ckpt['network_weights'], strict=False)
device = 'cuda' if torch.cuda.is_available() else 'cpu'
model.to(device)
with open('data/nnUNet_preprocessed/${DATASET_NAME}/splits_final.json') as f:
    val_cases = json.load(f)[0]['val']
result = evaluate(model, val_cases, device, OUT_CHANNELS)
print(json.dumps(result, indent=2))
"

echo "Done: ${RUN_NAME}."
