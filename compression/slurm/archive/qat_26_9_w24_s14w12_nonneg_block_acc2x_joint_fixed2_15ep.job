#!/bin/bash
#SBATCH --job-name=qat_26_9_w24_s14w12_nonneg_block_acc2x_joint_fixed2_15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=01:30:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 15-epoch DIAGNOSTIC run, retry after qat_26_9_w24_s14w12_nonneg_block_
# acc1x_joint_15ep.job's own real HPC run came back STUCK (pseudo-dice
# flat at 0.0 through epoch 10) -- the exact same stuck-training pathology
# S19/S5.6 hit with their own unconstrained joint searches.
#
# ROOT CAUSE (confirmed via block_sensitivity_26_9_w24_s14w12_nonneg_block.json):
# down1's weight sensitivity at W2 (5.54) is ~9.4x the next-highest block
# (up4, 0.59) -- and on the activation side, regular5.0 (1.17), final
# (1.10), and initial (1.10) all sit far above every other block (~0.06-0.3
# range), with up5 elevated too (0.67). Same 5-block outlier set
# (initial/down1/final/regular5.0/up5) that dominated ilp_search.py's own
# global min-max _normalize() for S19/S5.6, compressing every other
# block's real sensitivity signal toward zero.
#
# FIX: re-solved with --fix-bits initial=8 --fix-bits down1=8 --fix-bits
# final=8 --fix-bits regular5.0=8 --fix-bits up5=8 (excludes those 5 from
# BOTH the ILP's decision variables AND _normalize()'s range entirely, not
# a post-hoc overwrite) -- same "fixed2" mechanism that fixed S19
# (dice=0.7481) and S5.6 (dice=0.7732). Used --sensitivity-weight 2.0
# (acc2x), matching the ACTUAL recipe that worked for both of those (not
# acc1x -- acc1x+fixed2 was tried first here and gave an IDENTICAL result
# to acc2x+fixed2, so the weight choice made no difference in this
# specific case, but acc2x is kept for naming/recipe parity with the
# validated precedent).
#
# NOTE ON THE RESULT ITSELF: block_bits_26_9_w24_s14w12_nonneg_block_
# acc2x_joint_fixed2.json is NOT as diverse as S19/S5.6's own fixed2
# results -- all 24 free (non-fixed) blocks landed on a FLAT W4A4, only
# the 5 pinned blocks differ (W8A8). Structural build+forward verified
# locally (no error). Whether flat-but-safe W4A4 elsewhere is enough to
# avoid the stuck-training pathology is exactly what THIS diagnostic run
# is for -- not assumed in advance.
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=15 (NOT ENET_EPOCHS=15), same
# LR-schedule-preservation rule as every other diagnostic job.
#
# WARM START / SLOPE MAP: same as the acc1x_joint_15ep attempt --
# 26_9_w24_s14w12_nonneg_block's own FP32 checkpoint_best.pth +
# compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json
# (real trained nonneg_block scalars, not a lossy post-hoc average).
#
# No collect_results.py step -- training-log-only diagnostic.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_9_w24_s14w12_nonneg_block_qat_acc2x_joint_fixed2_15ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"

SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_26_9_w24_s14w12_nonneg_block_acc2x_joint_fixed2.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch schedule, early-stopped at 15 real epochs (diagnostic).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=15
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (15-epoch diagnostic, LR schedule of ${ENET_EPOCHS} epochs)"
echo "Block bits file:       ${ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT diagnostic): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines directly from this log to judge whether training recovered normally."
