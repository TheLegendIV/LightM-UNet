#!/bin/bash
#SBATCH --job-name=qat_5_6_acc2x_fixed2
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=10:00:00
# FULL 150-epoch run (promoted from a 10-epoch diagnostic once S19's own
# analogous fix already showed a real, strong result -- Mean Validation
# Dice 0.5714 at epoch 10, no collapse). Same budget qat_5_6_block_bits.job
# itself used (<=0.768s/iteration real rate x 150 epochs x 250
# iterations/epoch, completed within 08:00:00 without a resume there --
# 10:00:00 here for margin given this bit assignment's own real per-epoch
# times aren't yet measured past epoch 10).
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# FULL RUN, follow-up to qat_5_6_acc2x_fixed.job, which stayed FULLY stuck (Mean
# Validation Dice = 0.0 exactly, after only a tiny epoch-2 blip). Root
# cause traced by comparing against S19's own analogous run (which DID
# work, Mean Validation Dice = 0.5714): `up5`'s activation sensitivity is
# an extreme outlier (0.895, ~8x the next-highest of the 25 free blocks)
# that was NEVER included in the original --fix-bits set (that set was
# chosen by analogy to S19's own diagnosed WEIGHT-axis outlier, down1 --
# nobody had independently checked S5.6's own activation-axis sensitivity
# landscape). With up5 still in the free pool, its outlier value dominated
# _normalize()'s global min-max range for the activation axis, squashing
# every other free block's real signal and letting the LUT/BRAM cost
# penalty push 18/25 free blocks down to the cheap A2 option.
#
# FIX: compression/hawq/artifacts/block_bits_5_6_acc2x_fixed2.json pins 5 blocks now
# (initial/down1/final/regular5.0/up5, all W8A8) instead of 4. Result:
# the context stage's activations now land at a uniform A4 -- NOT the
# previous fixed variant's mostly-A2 pattern -- much closer to S19's own
# healthy uniform result.
#
# TRAINABLE SLOPE: QuantENet5_6Block.py has no frozen/trainable toggle yet
# (unlike QuantENetS19Block.py) -- unconditionally trainable_slope=True,
# same as every other S5.6 job. Already proven irrelevant on any bit
# assignment tried this session (S19 side) -- no reason to expect
# otherwise here.
#
# WARM START: S5.6's own FP32 checkpoint_final.pth.
#
# Confirmed via local docker check: from_pretrained transfers 721/820
# keys (0 shape mismatches), matching every other S5.6 job.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="5_6_qat_acc2x_fixed2"
TRAINER_CLASS="nnUNetTrainerENetQuant5_6Block"

SOURCE_NET_NAME="nnUNetTrainerENet_5_6_separable_dense_dilation"
BLOCK_BITS_FILE="compression/hawq/artifacts/block_bits_5_6_acc2x_fixed2.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/5_6_separable_dense_dilation.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET5_6_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET5_6_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET5_6_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch budget, nnU-Net's real default 250 iterations/epoch --
# ENET_ITERATIONS_PER_EPOCH deliberately left UNSET.
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (full ${ENET_EPOCHS}-epoch run)"
echo "Block bits file:       ${ENET5_6_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET5_6_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET5_6_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET5_6_BLOCK_BITS_FILE" "$ENET5_6_LEAKY_SLOPE_MAP_FILE" "$ENET5_6_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT ablation): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Post-training Dice check ==="
cd "$HOME/LightM-UNet"
python -c "
import torch, json
import sys
sys.path.insert(0, 'enet')
from nnunetv2.nets.QuantENet5_6Block import QuantENet5_6Block, OUT_CHANNELS
sys.path.insert(0, 'compression/hawq')
from eval_dice import evaluate
with open('${BLOCK_BITS_FILE}') as f: bits = json.load(f)
with open('${SLOPE_MAP_FILE}') as f: slope_map = json.load(f)
ckpt = torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)
model = QuantENet5_6Block(bits['stage_weight_bits'], bits['stage_act_bits'], slope_map)
model.load_state_dict(ckpt['network_weights'], strict=False)
device = 'cuda' if torch.cuda.is_available() else 'cpu'
model.to(device)
with open('data/nnUNet_preprocessed/${DATASET_NAME}/splits_final.json') as f:
    val_cases = json.load(f)[0]['val']
result = evaluate(model, val_cases, device, OUT_CHANNELS)
print(json.dumps(result, indent=2))
"

echo "=== Collecting results into compression/results.csv ==="
SLOPE_MAP_JSON=$(python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage experiment_5_6_qat_acc2x_fixed2 \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels 4,16,32,16,4 \
    --bottlenecks 4,8,8,2,1 \
    --decoder-type upsample_conv \
    --use-asymmetric 0 \
    --context-pattern dense_dilation \
    --separable-dilated 1 \
    --leaky-slope-map "$SLOPE_MAP_JSON" \
    --quant-bits 32 \
    --trainer-class "${TRAINER_CLASS}"
# --quant-bits 32 here is a deliberate placeholder, same rationale as
# every other per-block S5.6 job's own note -- real per-block params/
# bops/LUT/BRAM live in compression/hawq/artifacts/finn_block_costs_5_6.json /
# block_bits_5_6_acc2x_fixed2.json, not this row's own params/flops/bops
# columns.

echo "Done: ${RUN_NAME}."
