#!/bin/bash
#SBATCH --job-name=stage_22_dsc_projected_nonneg_block
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-2
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 22 -- repeats the S5-SeparableDense -> S17 -> S18 -> S19 "convert to
# nonneg_block, then claw back the resulting dice loss with reg-consolidation
# capacity" recipe, but starting from S9.1 (9_1_dense_dilation_dsc_projected)
# instead of S5.6. S9.1 is the cheaper, unexplored-for-nonneg_block family:
# use_dsc=1 (real depthwise-separable convs at internal_channels, projection
# KEPT), not separable_dilated=1's (3,1)+(1,3) factoring -- 17,610 params /
# 192.0M MACs / 139,264 buffer elements at PReLU (dice 0.7836), already
# cheaper than S17 (21,468p/296M/141,184, dice 0.7824) before any conversion.
# None of the three existing nonneg_block-vs-PReLU/ReLU matched pairs
# (S12.1/S17, S10.2/S18, S20/S19) used this use_dsc=1 mechanism, so this is
# a genuinely new data point on whether the conversion cost/recovery pattern
# generalizes across architecture families, not a repeat of known results.
#
#   0: 22_1_dsc_projected_nonneg_block -- S9.1's exact recipe (context_pattern
#      =dense_dilation, use_dsc=1, dsc_no_projection=0, bottlenecks=4,8,8,2,1,
#      8 dilated slots) with prelu_variant=nonneg_block substituted for
#      standard PReLU. Direct analogue of S5.6 -> S17.
#   1: 22_2_dsc_projected_reginterleaved_nonneg_block -- adds the
#      dense_dilation_reg_interleaved context pattern (11 slots: reg-bookended
#      dilation cycles) on top of task 0, bottlenecks=4,11,11,2,1. Direct
#      analogue of S10.1/S10.2 -> S18. The {"reg_bottleneck": True} sentinel
#      this pattern relies on is already confirmed to work under
#      use_dsc=1/dsc_no_projection=0 (S9.3's own dense_dilation_reg_trailing
#      run forced the same "genuine monolithic RegularBottleneck, not
#      DSC-factored" handling through _make_context_stage's plain/projected
#      loop -- see stage_9's own job file) -- no new ENet.py code needed.
#   2: 22_3_dsc_projected_reginterleaved_double_mid_nonneg_block -- adds
#      DENSE_DILATION_REG_INTERLEAVED_DOUBLE_MID_PATTERN on top of task 1
#      (doubles the one truly-interior reg slot, 12 slots total),
#      bottlenecks=4,12,12,2,1. Direct analogue of S18 -> S19. ENet.py's own
#      module comment on this pattern is explicit that it's only meaningful
#      "under dsc_no_projection=False (S10's own recipe -- DSC WITH
#      projection kept, or no DSC at all)" -- exactly S9.1's setting, so this
#      is a designed-for combination, not an untested one.
#
# All three: cold start (no -pretrained_weights, no ENET_NONNEG_BLOCK_INIT_MAP
# -- same rationale as S17: isolates the architecture/pattern's own effect
# on the nonneg_block conversion, not warm-start's), channels=4,16,32,16,4,
# decoder_type=upsample_conv, use_dilated=1, use_asymmetric=0, use_strided=1,
# use_dsc=1, dsc_no_projection=0, separable_dilated left at its default 0
# (S9.1 never used separable_dilated -- that factoring belongs to the
# S5/S17/S18/S19 lineage, not this one).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(22_1_dsc_projected_nonneg_block 22_2_dsc_projected_reginterleaved_nonneg_block
              22_3_dsc_projected_reginterleaved_double_mid_nonneg_block)
BOTTLENECKS_ARR=("4,8,8,2,1" "4,11,11,2,1" "4,12,12,2,1")
CONTEXT_PATTERN_ARR=(dense_dilation dense_dilation_reg_interleaved dense_dilation_reg_interleaved_double_mid)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S9.1's recipe, nonneg_block, growing context -----
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="${BOTTLENECKS_ARR[$TASK_ID]}"
export ENET_CONTEXT_PATTERN="${CONTEXT_PATTERN_ARR[$TASK_ID]}"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_PRELU_VARIANT="nonneg_block"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_BOTTLENECKS=${ENET_BOTTLENECKS} ENET_CONTEXT_PATTERN=${ENET_CONTEXT_PATTERN}"
echo "ENET_PRELU_VARIANT=${ENET_PRELU_VARIANT} (cold start -- no -pretrained_weights, no ENET_NONNEG_BLOCK_INIT_MAP)"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth counts as "already trained" -- see stage_9's own
# job file for the incident (a crashed run's early checkpoint_best.pth
# silently collected as if finished) this guards against.
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} (cold start, no pretrained weights) ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 22_dsc_projected_nonneg_block \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --prelu-variant "${ENET_PRELU_VARIANT}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
