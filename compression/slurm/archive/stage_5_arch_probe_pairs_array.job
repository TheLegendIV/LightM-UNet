#!/bin/bash
#SBATCH --job-name=stage_5_arch_probe_pairs
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-7
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 5 -- architecture-probe PAIRS: combine two stage_4 flags at once,
# off the same U4 reference cell as stage_4 (CHANNELS=4,16,32,16,4 except
# where noted, BOTTLENECKS=4,8,8,2,1 native, DECODER_TYPE=upsample_conv,
# USE_PRELU=1, USE_ASYMMETRIC=0, dilated/strided=1, dsc=0 -- identical
# policy to stage_4_arch_probes_array.job). Goal: cross the individually-
# strongest stage_4 findings (dense_dilation's dice, merge_dilated_pairs'
# and dsc_no_projection's MAC reduction, separable_dilated's Pareto win,
# E1Shape's shape, shallow_dilation_wide's cheap reach) to see whether
# their gains compose or cannibalize each other.
#
#   0: 5_1_dscnoprojection_dense_dilation -- ENET_DSC_NO_PROJECTION=1 +
#      ENET_CONTEXT_PATTERN=dense_dilation. Already composed cleanly with
#      NO new ENet.py code -- dsc_no_projection's DSCNoProjectionBottleneck
#      already reads whatever context_pattern selected (see ENet.py's
#      _make_context_stage), it just never looked at dense_dilation's
#      denser schedule before. Combines DscNoProjection's MAC reduction
#      (224.8M, the lowest of any stage_4 probe) with DenseDilation's dice
#      (0.7960, the highest).
#   1: 5_2_dense_dilation_shallow_wide_dense -- ENET_CONTEXT_PATTERN=
#      dense_dilation + ENET_SHALLOW_DILATION_WIDE=1 +
#      ENET_SHALLOW_DILATION_DENSE=1. Needed NEW code: shallow_dilation_wide
#      was alternating [regular, dilated(32)]; shallow_dilation_dense is a
#      new modifier flag that swaps it (and shallow_dilation's rate-16
#      variant) for an every-slot-dilated pattern instead -- see ENet.py's
#      SHALLOW_DILATION_WIDE_DENSE_PATTERN. Pushes dilation aggressively in
#      EVERY stage (stage1/2/3/4), not just stage2/3.
#   2: 5_3_dense_dilation_merge_pairs -- ENET_CONTEXT_PATTERN=dense_dilation
#      + ENET_MERGE_DILATED_PAIRS=1. Needed a real bugfix: MergedContext-
#      Bottleneck's op1 (the pairing's "first" half) silently ignored any
#      "dilation" key in its own kwargs before this stage -- harmless under
#      the default pattern (op1 is always plain-or-asymmetric there) but
#      wrong under dense_dilation, where op1 is ALSO a dilated slot (no
#      plain slots left to pair against). Fixed via a shared
#      _dilatable_conv_block helper now used by both op1 and op2, so a
#      merged pair can be (dilated, dilated) -- e.g. (2,4) or (8,16) --
#      not just (plain-or-asymmetric, dilated). Combines MergeDilatedPairs'
#      MAC halving (206.7M at the default pattern) with DenseDilation's
#      dice.
#   3: 5_4_dense_dilation_e1shape -- ENET_CONTEXT_PATTERN=dense_dilation +
#      CHANNELS=4,16,28,16,4. Composed cleanly, no new code (channels and
#      context_pattern are independent constructor args).
#   4: 5_5_dscnoprojection_e1shape -- ENET_DSC_NO_PROJECTION=1 +
#      CHANNELS=4,16,28,16,4. Composed cleanly, no new code.
#   5: 5_6_separable_dense_dilation -- ENET_SEPARABLE_DILATED=1 +
#      ENET_CONTEXT_PATTERN=dense_dilation. Composed cleanly, no new code --
#      RegularBottleneck's separable_dilated branch already fires per-slot
#      on `dilation != 1`, so under dense_dilation (every slot dilated) it
#      now factors all 8 context-stage slots instead of the default
#      pattern's 4. Targets DenseDilation's main open question directly:
#      can its accuracy be kept while cutting the MACs its extra dilated
#      slots cost, by (3,1)+(1,3)-factoring EVERY one of them.
#   6: 5_7_merge_pairs_separable -- ENET_MERGE_DILATED_PAIRS=1 +
#      ENET_SEPARABLE_DILATED=1 (default context_pattern -- no structural
#      conflict with dense_dilation's op1-pairing case, so no new code
#      needed beyond 5.3's op1/op2 refactor already threading
#      separable_dilated through both halves). Stacks two independently-
#      positive stage_4 Pareto wins (MergeDilatedPairs: 206.7M MACs / 0.7567
#      dice; SeparableDilated: 323.4M MACs / 0.7615 dice).
#   7: 5_8_shallow_wide_merge_pairs -- ENET_SHALLOW_DILATION_WIDE=1 +
#      ENET_MERGE_DILATED_PAIRS=1. Composed cleanly, no new code -- the two
#      flags touch disjoint stages (shallow_dilation_wide: stage1/regular4;
#      merge_dilated_pairs: stage2/stage3).
#
# All 8 pairs confirmed via local docker smoke test (nnUNetv2_train, 1
# epoch/2 iterations against Dataset509_ARCADE_1x1_4c) to build and train
# without error, AND structurally verified in ENet.py's own self-test
# (exact per-block dilation rates / block counts / op1-op2 factoring
# checked for all 8, not just "it built" -- see ENet.py's "Stage 5
# architecture-probe-PAIRS self-test").

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(5_1_dscnoprojection_dense_dilation 5_2_dense_dilation_shallow_wide_dense
              5_3_dense_dilation_merge_pairs 5_4_dense_dilation_e1shape 5_5_dscnoprojection_e1shape
              5_6_separable_dense_dilation 5_7_merge_pairs_separable 5_8_shallow_wide_merge_pairs)
CHANNELS_ARR=("4,16,32,16,4" "4,16,32,16,4" "4,16,32,16,4" "4,16,28,16,4"
              "4,16,28,16,4" "4,16,32,16,4" "4,16,32,16,4" "4,16,32,16,4")
CONTEXT_PATTERN_ARR=(dense_dilation dense_dilation dense_dilation dense_dilation
                      default dense_dilation default default)
DSC_NO_PROJECTION_ARR=(1 0 0 0 1 0 0 0)
SHALLOW_DILATION_WIDE_ARR=(0 1 0 0 0 0 0 1)
SHALLOW_DILATION_DENSE_ARR=(0 1 0 0 0 0 0 0)
MERGE_DILATED_PAIRS_ARR=(0 0 1 0 0 0 1 1)
SEPARABLE_DILATED_ARR=(0 0 0 0 0 1 1 0)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- U4 reference (or E1Shape), two things changed ----
export ENET_CHANNELS="${CHANNELS_ARR[$TASK_ID]}"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_CONTEXT_PATTERN="${CONTEXT_PATTERN_ARR[$TASK_ID]}"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SHALLOW_DILATION=0
export ENET_SEPARABLE_DILATED="${SEPARABLE_DILATED_ARR[$TASK_ID]}"
export ENET_MERGE_DILATED_PAIRS="${MERGE_DILATED_PAIRS_ARR[$TASK_ID]}"
export ENET_DSC_DILATED_ONLY=0
export ENET_DOUBLE_PROJECTIONS=0
export ENET_TWO_BLOCK_SKIP=0
export ENET_DSC_NO_PROJECTION="${DSC_NO_PROJECTION_ARR[$TASK_ID]}"
export ENET_SHALLOW_DILATION_WIDE="${SHALLOW_DILATION_WIDE_ARR[$TASK_ID]}"
export ENET_SHALLOW_DILATION_DENSE="${SHALLOW_DILATION_DENSE_ARR[$TASK_ID]}"
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS} ENET_CONTEXT_PATTERN=${ENET_CONTEXT_PATTERN}"
echo "ENET_DSC_NO_PROJECTION=${ENET_DSC_NO_PROJECTION} ENET_SHALLOW_DILATION_WIDE=${ENET_SHALLOW_DILATION_WIDE} ENET_SHALLOW_DILATION_DENSE=${ENET_SHALLOW_DILATION_DENSE}"
echo "ENET_MERGE_DILATED_PAIRS=${ENET_MERGE_DILATED_PAIRS} ENET_SEPARABLE_DILATED=${ENET_SEPARABLE_DILATED}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 5_arch_probe_pairs \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --shallow-dilation "${ENET_SHALLOW_DILATION}" \
    --separable-dilated "${ENET_SEPARABLE_DILATED}" \
    --merge-dilated-pairs "${ENET_MERGE_DILATED_PAIRS}" \
    --dsc-dilated-only "${ENET_DSC_DILATED_ONLY}" \
    --double-projections "${ENET_DOUBLE_PROJECTIONS}" \
    --two-block-skip "${ENET_TWO_BLOCK_SKIP}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --shallow-dilation-wide "${ENET_SHALLOW_DILATION_WIDE}" \
    --shallow-dilation-dense "${ENET_SHALLOW_DILATION_DENSE}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
