#!/bin/bash
#SBATCH --job-name=stage_18_reginterleaved_separable_nonneg_block
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Stage 18 -- S10-ReginterleavedSeparable (10_2_reginterleaved_separable_
# projected_relu, dice=0.7900, ReLU) with its activation swapped for
# prelu_variant="nonneg_block" (ONE learnable non-negative scalar shared
# across every activation site in a block -- true parameter tying, see
# ENet.py's Stage-13 self-test), trained fully COLD -- no -pretrained_weights,
# no ENET_NONNEG_BLOCK_INIT_MAP. Everything else identical to S10: channels=
# 4,16,32,16,4, bottlenecks=4,11,11,2,1, context_pattern=dense_dilation_reg_
# interleaved, separable_dilated=1 (dense (3,1)+(1,3) factoring, projection
# kept -- dsc_no_projection=0, use_dsc=0).
#
# Deliberately cold, not warm-started like S13 was: S13's warm start (from
# S5-SeparableDense's own checkpoint) gives it an effectively ~300-epoch
# training budget (150 pretrain + 150 fine-tune) against every other
# config's 150, an unfair comparison flagged after the fact (see S17's own
# job file, which ran the same cold-start-vs-S13 isolation on a different
# base architecture and found a real -0.018 dice gap attributable to the
# warm start alone). This job answers the same "is nonneg_block leaky worth
# it" question for S10's architecture specifically, on a level footing.
#
# S10 is the FINN-relevant reference here (per its own stage_10 job file:
# both its own PReLU/ReLU variants keep the projection at stage2/3 and use
# a dense, non-DSC separable factoring -- no exotic no-projection buffer
# blowup, no depthwise-vs-dense ambiguity). This tests whether trading
# ReLU for a genuinely FINN-deployable single learnable LeakyReLU slope per
# block buys back some of ReLU's dice loss vs PReLU, without the warm-start
# confound.
#
# Confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c) to build and train
# (forward+backward+optimizer) without error. No new ENet.py code needed --
# prelu_variant="nonneg_block" already applies generically wherever
# use_prelu=True is set, independent of context_pattern (verified in
# ENet.py's own Stage-13 self-test, which built it standalone).
#
# Single run, not an array -- one architecture, activation swapped, warm
# start removed.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="18_reginterleaved_separable_nonneg_block"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S10's exact recipe, nonneg_block activation, cold
#    start (no -pretrained_weights, no ENET_NONNEG_BLOCK_INIT_MAP) --------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,11,11,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation_reg_interleaved"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_PRELU_VARIANT="nonneg_block"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SEPARABLE_DILATED=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "ENET_PRELU_VARIANT=${ENET_PRELU_VARIANT} (cold start -- no -pretrained_weights, no ENET_NONNEG_BLOCK_INIT_MAP)"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth (written once, at the very end of a finished
# num_epochs-epoch run) counts as "already trained" -- checkpoint_best.pth
# gets written as early as epoch 0, see stage_8's own job file for the
# incident this guards against.
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} (cold start, no pretrained weights) ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv (structural nonneg_block dice, block-tied but not yet frozen to leaky) ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 18_reginterleaved_separable_nonneg_block \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --separable-dilated "${ENET_SEPARABLE_DILATED}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --prelu-variant "${ENET_PRELU_VARIANT}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}. Next (manual, not part of this job): if this beats S10-ReLU, convert the trained checkpoint's per-block scalars to a fixed LeakyReLU via ENet.py's apply_leaky_slope_overrides + collect_prelu_block_means for the final FINN-deployable dice number (same procedure S13's job description used)."
