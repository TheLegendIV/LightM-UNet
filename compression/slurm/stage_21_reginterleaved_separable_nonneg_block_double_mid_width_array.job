#!/bin/bash
#SBATCH --job-name=stage_21_reginterleaved_separable_nonneg_block_double_mid_width
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-1
# 21_3_original (ENet-Original width, 16,64,128,64,16) disabled for now per
# explicit request -- U2/U8 run first. Re-enable by changing this to
# --array=0-2 once U2/U8 are done.
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 21 -- channel-width sweep of S19's exact architecture
# (dense_dilation_reg_interleaved_double_mid: the doubled-interior-reg-
# bookend "final test" pattern, separable_dilated=1, dsc_no_projection=0/
# projection kept, prelu_variant=nonneg_block leaky, cold start), at
# U2/U8/ENet-Original channel widths. U4 (S19 itself, channels=4,16,32,16,4,
# dice=0.7931) is already measured -- not repeated here.
#
# Motivated directly by the earlier discussion of proving S19's dice-vs-
# params tradeoff actually beats stage_1_naive_baseline_array.job's own
# channel-width compression curve (Baseline/U2/U4/U8/U16/E1) at MULTIPLE
# points along the curve, not just the one U4-width comparison already
# available in compression/results/all_configs_dice_vs_params.png. U8 and
# Baseline were picked specifically because they land EXACTLY on
# stage_1_naive_baseline's own x-axis points (same channel tuples), for a
# direct same-capacity comparison; U2 fills the gap between them.
#
# Channel values reused verbatim from stage_1_naive_baseline_array.job's
# own real recipe (not re-derived):
#   0: 21_1_u2       -- channels=8,32,64,32,8    (uniform /2)
#   1: 21_2_u8       -- channels=4,8,16,8,4      (uniform /8, floored to 4 --
#                        matches stage_1's own U8 point exactly)
#   2: 21_3_original -- channels=16,64,128,64,16 (ENet paper's own channel
#                        widths -- stage_1's own "Baseline" point /
#                        stage_3_transfer_original's channels)
#
# Everything else fixed at S19's own recipe: bottlenecks=4,12,12,2,1,
# decoder_type=upsample_conv, use_asymmetric=0, use_dilated=1, use_strided=1,
# use_dsc=0, separable_dilated=1, dsc_no_projection=0, context_pattern=
# dense_dilation_reg_interleaved_double_mid, use_prelu=1, prelu_variant=
# nonneg_block. Cold-started (no -pretrained_weights), matching S17-S20's
# own established convention on this branch (warm start was flagged earlier
# as an unfair ~2x-epoch-budget comparison, see S17's own job file).
#
# No new ENet.py code needed -- channels is already a free axis on every
# existing flag combination; bottlenecks_per_stage/context_pattern/
# separable_dilated/prelu_variant are unaffected by channel width. Confirmed
# via local docker smoke test (nnUNetv2_train, 1 epoch/2 iterations against
# Dataset509_ARCADE_1x1_4c) at all 3 widths to build and train
# (forward+backward+optimizer) without error.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(21_1_u2 21_2_u8)  # 21_3_original disabled for now, see --array note above
TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"

case "$CONFIG_NAME" in
  21_1_u2)       CHANNELS="8,32,64,32,8" ;;
  21_2_u8)       CHANNELS="4,8,16,8,4" ;;
  21_3_original) CHANNELS="16,64,128,64,16" ;;
esac

RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S19's exact recipe, channel width swept ---------
export ENET_CHANNELS="${CHANNELS}"
export ENET_BOTTLENECKS="4,12,12,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation_reg_interleaved_double_mid"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_PRELU_VARIANT="nonneg_block"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SEPARABLE_DILATED=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
# Only checkpoint_final.pth (written once, at the very end of a finished
# num_epochs-epoch run) counts as "already trained" -- checkpoint_best.pth
# gets written as early as epoch 0, see stage_8's own job file for the
# incident this guards against.
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 21_reginterleaved_separable_nonneg_block_double_mid_width \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --separable-dilated "${ENET_SEPARABLE_DILATED}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --prelu-variant "${ENET_PRELU_VARIANT}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
