#!/bin/bash
#SBATCH --job-name=qat_26_9_w24_s14w12_nonneg_block_acc1x_joint_15ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=01:30:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 15-epoch DIAGNOSTIC run (not a full 150-epoch QAT commitment yet) --
# checks whether real per-block QAT recovers a normal training trajectory
# (nonzero pseudo-dice by ~epoch 2-4) on 26_9_w24_s14w12_nonneg_block's own
# UNCONSTRAINED joint acc1x ILP bit assignment (block_bits_
# 26_9_w24_s14w12_nonneg_block_acc1x_joint.json, no --fix-bits exclusion --
# same "did the search naturally avoid the down1/up5 outlier-normalization
# problem" question S19/S5.6/26_5_w24 all had to answer for their own
# unconstrained acc1x/acc2x searches). Real per-layer folding for this
# exact bit assignment was already verified feasible at the strict 70/80
# LUT/BRAM cap (folding_block_26_9_w24_s14w12_nonneg_block_acc1x_joint_
# 70_80_relaxed.json, 2,322,432 cycles = 23.2ms @ 100MHz) -- this job is
# the first real-training check before committing to the expensive full
# 150-epoch run.
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=15 (NOT ENET_EPOCHS=15) so
# PolyLRScheduler's own decay curve matches what the eventual full
# 150-epoch run would use -- never cut ENET_EPOCHS itself, see this
# session's own LR-schedule-compression bug writeup.
#
# QuantENet26_9_w24_s14w12_nonneg_block / nnUNetTrainerENetQuant26_9_w24_
# s14w12_nonneg_blockBlock (new files, mirroring QuantENet26_5_w24.py /
# nnUNetTrainerENetQuant26_5_w24Block.py exactly, just this architecture's
# own CHANNELS=4,12,24,12,4): self-tested locally (homogeneous W8A8
# build+forward, missing-block-key validation, leaky_slope_map wiring,
# topology parity vs ENet.py -- all PASSED), and from_pretrained verified
# against the real FP32 checkpoint + real ILP bits: 721/820 keys
# transferred, 0 shape mismatches (same ratio every other trainable_slope
# per-block QuantENet file in this repo shows).
#
# SLOPE MAP: unlike 26_5_w24's own lossy post-hoc-averaged "standard"
# PReLU map, this checkpoint was trained directly with prelu_variant=
# "nonneg_block" -- compression/post-quantization/slope_maps/
# 26_9_w24_s14w12_nonneg_block.json holds each block's own REAL trained
# scalar (extract_leaky_slope_map.py --prelu-variant nonneg_block,
# strict=True load confirmed), same safe-default situation as S19/23_1's
# own slope maps, not 26_5_w24's flagged-but-defensible-under-QAT case.
#
# WARM START: 26_9_w24_s14w12_nonneg_block's own FP32 checkpoint_best.pth.
#
# Smoke-tested locally (1 epoch / 2 iterations, ENET_DISABLE_CHECKPOINTING=1)
# before submission: build + forward + backward + optimizer step, no error.
#
# No collect_results.py step here -- this is a training-log-only
# diagnostic (real per-epoch Pseudo dice trajectory read directly from the
# Slurm log), not a full test-set evaluation. Promote to a real 150-epoch
# run (own job, with collect_results.py) once this confirms the
# trajectory recovers normally.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="26_9_w24_s14w12_nonneg_block_qat_acc1x_joint_15ep"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"

SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch schedule, early-stopped at 15 real epochs (diagnostic).
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=15
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (15-epoch diagnostic, LR schedule of ${ENET_EPOCHS} epochs)"
echo "Block bits file:       ${ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE" "$ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT diagnostic): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."
fi

echo "Done: ${RUN_NAME}. Read the per-epoch Pseudo dice lines directly from this log to judge whether training recovered normally."
