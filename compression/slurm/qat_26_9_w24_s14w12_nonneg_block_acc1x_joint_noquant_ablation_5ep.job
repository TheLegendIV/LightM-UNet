#!/bin/bash
#SBATCH --job-name=qat_26_9_noquant_ablation_5ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=03:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# 3-step ablation, 5-epoch DIAGNOSTIC runs each, all on the SAME bit
# assignment every stuck attempt on record uses (block_bits_26_9_w24_
# s14w12_nonneg_block_acc1x_joint.json, real per-block bits, genuine
# 2-bit sites intact -- UNCHANGED).
#
# Local cheap-GPU-proxy testing this session isolated the compounding-
# quantizer-chain theory as NOT the dominant cause of this architecture's
# stuck QAT: QuantFusedLeakyAct (a single-output-quantizer alternative to
# QuantDecomposedLeakyAct's 3-chained pre_quant/act_pos/out_quant, same
# LeakyReLU(x,a)=a*x+(1-a)*ReLU(x) identity, built this session) STILL
# collapsed on this exact bit assignment, same signature as the 3-chained
# version (one class creeps to ~0.05-0.06, others flat near-zero). A
# matched plain-QuantReLU run (no leaky mechanism at all, same bits) was
# run alongside for direct comparison -- see that run's own log for the
# result this ablation's own hypothesis rests on.
#
# This ablation tests a DIFFERENT, more radical lever than either
# decomposition: QuantDecomposedLeakyAct's own quant_enabled=False bypass
# (see QuantENet.py's own docstring) skips pre_quant/act_pos/out_quant
# ENTIRELY, computing the exact algebraic identity in plain float -- NOT
# just algebraically equivalent to ReLU at alpha=0 (as the already-tried-
# and-already-collapsed zero-slope-WITH-quantization-active attempts were,
# see zeroslope_15ep.job's own header), but NUMERICALLY identical: zero
# quantization noise enters this site's own computation at all. The
# rationale for trying this despite the fused-quantizer result above:
# hardware/finn_enet_build_decomposed_prelu.py's own step_fuse_leaky_relu_
# to_threshold proves the real deployed hardware for a DECOMPOSED site is
# just one MultiThreshold regardless -- so training with ZERO quantization
# noise at these sites specifically, then reconstructing+calibrating (not
# retraining) pre_quant/act_pos/out_quant fresh from the finished
# checkpoint purely for export, is a legitimate path if this trains well
# (real FINN-export verification for that reconstruction is separate,
# later work, not done here or in this job).
#
# Rather than one HPC allocation per single change, this job runs 4
# variants BACK TO BACK in one submission (each independent, each
# warm-started fresh from the same FP32 checkpoint, each 5 epochs):
#   0. REFERENCE: plain QuantReLU everywhere, no leaky mechanism at all
#      (no slope map file set at all -- QuantENet.py's own convention:
#      negative_slope=None falls back to plain _quant_act/QuantReLU for
#      every block). Matches the local cheap-GPU-proxy run this same
#      session ran alongside the fused-quantizer test for direct
#      comparison, and the trainer's own investigation-history docstring's
#      "THIRD attempt... plain QuantReLU everywhere, no alpha... did NOT
#      get stuck" real HPC precedent -- this reruns that exact reference
#      point on the SAME 5-epoch/full-iteration footing as the 3 variants
#      below, for direct comparability.
#   1. quant_enabled=False only (QUANT_LEAKY_FROM_EPOCH set past this run's
#      own length -- never turns on), REAL trained nonneg_block slope map
#      (unchanged from every other non-zeroed run this session).
#   2. Same as 1, PLUS ALPHA_LR_SCALE=0.1 (damping) -- already shown this
#      session (matched Run2-vs-Run3 pair, pruned+top5w8a8+internal8
#      config) to make things slightly WORSE, not better, when quantization
#      IS active; untested combined with quant_enabled=False.
#   3. Same as 2, PLUS the zeroed slope map (compression/post-quantization/
#      slope_maps/26_9_w24_s14w12_nonneg_block_zeroed.json) instead of the
#      real trained one -- every block's slope starts at exactly 0.0
#      (genuinely equivalent to ReLU at epoch 0 THIS time, since
#      quant_enabled=False means there's no quantization noise left to
#      make that equivalence only algebraic-not-numerical, unlike the
#      already-collapsed zero-slope-WITH-quantization attempts).
#
# ENET_EPOCHS=150 + ENET_MAX_EPOCHS_TO_RUN=5 each, same LR-schedule-
# preservation rule as every other diagnostic job this session. No
# ENET_ITERATIONS_PER_EPOCH/ENET_VAL_ITERATIONS_PER_EPOCH override -- full
# real per-epoch iteration count, this is a real HPC diagnostic run, not
# the local cheap-GPU-proxy's own reduced-iteration approximation.
#
# WARM START (all 3): 26_9_w24_s14w12_nonneg_block's own FP32
# checkpoint_best.pth, same source every other QAT job this session uses.
#
# No collect_results.py step for any of the 3 -- training-log-only
# diagnostic, same convention as zeroslope_15ep.job.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerENetQuant26_9_w24_s14w12_nonneg_blockBlock"
SOURCE_NET_NAME="nnUNetTrainerENet_26_9_w24_s14w12_nonneg_block"
BLOCK_BITS_FILE="compression/hawq/block_bits_26_9_w24_s14w12_nonneg_block_acc1x_joint.json"
REAL_SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block.json"
ZEROED_SLOPE_MAP_FILE="compression/post-quantization/slope_maps/26_9_w24_s14w12_nonneg_block_zeroed.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- Common HAWQ per-block QAT knobs (identical for every variant below) ----
export ENET26_9_W24_S14W12_NONNEG_BLOCK_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET26_9_W24_S14W12_NONNEG_BLOCK_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=5
# QUANT_LEAKY_FROM_EPOCH and LEAKY_INTERNAL_BITS are set PER VARIANT below
# (run_variant's own 4th/5th args), NOT here -- the quant_enabled=False
# variants need it set past this run's own length (never turns on), but
# the internal_bit_width=8 reference variant needs the STANDARD
# quantized-from-epoch-0 behavior (unset/0), not the bypass.

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"

echo "=== Checking required input files exist ==="
for f in "$HOME/LightM-UNet/${BLOCK_BITS_FILE}" "$HOME/LightM-UNet/${REAL_SLOPE_MAP_FILE}" \
         "$HOME/LightM-UNet/${ZEROED_SLOPE_MAP_FILE}" "$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== GPU info ==="
nvidia-smi

run_variant() {
    local run_name="$1"
    local slope_map_file="$2"
    local alpha_lr_scale="$3"
    local out_folder="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${run_name}__nnUNetPlans__2d/fold_0"

    if [ -n "$slope_map_file" ]; then
        export ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${slope_map_file}"
    else
        # No slope map at all -- QuantENet.py's own convention:
        # negative_slope=None everywhere falls back to plain QuantReLU for
        # every block (REFERENCE variant, no leaky mechanism at all).
        unset ENET26_9_W24_S14W12_NONNEG_BLOCK_LEAKY_SLOPE_MAP_FILE
    fi
    if [ -n "$alpha_lr_scale" ]; then
        export ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE="$alpha_lr_scale"
    else
        unset ENET26_9_W24_S14W12_NONNEG_BLOCK_ALPHA_LR_SCALE
    fi
    export ENET_OUTPUT_FOLDER="$out_folder"

    echo "############################################"
    echo "### VARIANT: ${run_name} ###"
    echo "### slope_map=${slope_map_file:-none (plain QuantReLU)}  alpha_lr_scale=${alpha_lr_scale:-1.0 (no damping)} ###"
    echo "############################################"

    if [ -f "${out_folder}/checkpoint_final.pth" ]; then
        echo "checkpoint_final.pth already exists at ${out_folder} -- skipping training."
    else
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    fi
    echo "Done: ${run_name}."
}

run_variant "acc1x_joint_plain_relu_reference_5ep"         ""                       ""
run_variant "acc1x_joint_noquant_5ep"                      "$REAL_SLOPE_MAP_FILE"   ""
run_variant "acc1x_joint_noquant_damped_5ep"                "$REAL_SLOPE_MAP_FILE"   "0.1"
run_variant "acc1x_joint_noquant_damped_zeroslope_5ep"      "$ZEROED_SLOPE_MAP_FILE" "0.1"

echo "ALL 3 VARIANTS DONE. Read each variant's own per-epoch Pseudo dice lines directly from this log to judge recovery."
