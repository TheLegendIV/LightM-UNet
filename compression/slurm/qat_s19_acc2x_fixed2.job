#!/bin/bash
#SBATCH --job-name=qat_s19_acc2x_fixed2
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=11:00:00
# FULL 150-epoch run (promoted from a 10-epoch diagnostic ablation once
# that ablation's own early trajectory looked genuinely strong -- Mean
# Validation Dice 0.5714 already at epoch 10, no collapse at all). Same
# ~1.07s/iteration real rate qat_s19_block_bits.job's own header measured
# on this partition x 150 epochs x 250 iterations/epoch (37,500 total) =
# ~11.1 real hours -- same budget that job itself needed (with a short
# resume for its last ~15 epochs); resume_qat_s19_acc2x_fixed2.job would
# be the fallback if this isn't enough either (mirror
# resume_qat_s19_block_bits.job's pattern if needed).
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# FULL RUN, follow-up to qat_s19_acc2x_fixed.job, which already ran and WORKED
# (Mean Validation Dice = 0.5714 after only 10 epochs, dice already
# [0.41, 0.62, 0.36, 0.58] by epoch 0 -- no collapse at all, a real fix).
# That job's --fix-bits set (initial/down1/final/regular5.0) was chosen by
# analogy to S19's own diagnosed outliers. This job adds ONE more: `up5`.
#
# WHY: comparing S19's cross-run to S5.6's own analogous run
# (qat_5_6_acc2x_fixed.job, which stayed FULLY stuck at exact Mean
# Validation Dice = 0.0), the difference traced to `up5`'s activation
# sensitivity being an extreme outlier STILL LEFT in the free-block pool
# for both architectures (S19: 0.848, ~4x the next-highest free block;
# S5.6: 0.895, ~8x) -- up5 is the last upsampling block before `final` in
# both nets, architecturally the same role. It wasn't included in the
# original --fix-bits set because that set was chosen by analogy to S19's
# diagnosed weight-axis outlier (down1), not from an independent check of
# the activation axis. Removing it from the pool too changed S19's own
# free-block choices further (regular1.0-3's activations moved up to A8),
# and gave S5.6 a MUCH healthier pattern (context stage activations at A4
# uniformly, not the previous fixed variant's 18/25-blocks-at-A2).
#
# Bit file: compression/hawq/block_bits_s19_acc2x_fixed2.json (5 blocks
# pinned: initial/down1/final/regular5.0/up5, all W8A8; 32 free blocks
# re-solved at --sensitivity-weight 2.0 with those 5 removed from both the
# ILP's decision variables AND _normalize()'s global min-max range).
#
# TRAINABLE SLOPE: explicitly FROZEN (ENET_S19_TRAINABLE_SLOPE=0), same as
# qat_s19_acc2x_fixed.job -- already proven irrelevant on any bit
# assignment tried this session.
#
# WARM START: S19's own FP32 checkpoint_final.pth.
#
# Confirmed via local docker check: from_pretrained transfers 873/1119
# keys (0 shape mismatches, expected for frozen-slope), matching every
# other from-FP32 S19 job.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="s19_qat_acc2x_fixed2"
TRAINER_CLASS="nnUNetTrainerENetQuantS19Block"

SOURCE_NET_NAME="nnUNetTrainerENet_19_reginterleaved_separable_nonneg_block_double_mid"
BLOCK_BITS_FILE="compression/hawq/block_bits_s19_acc2x_fixed2.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/19_reginterleaved_separable_nonneg_block_double_mid.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET_S19_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_S19_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET_S19_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
export ENET_S19_TRAINABLE_SLOPE=0
# Full 150-epoch budget, nnU-Net's real default 250 iterations/epoch --
# ENET_MAX_EPOCHS_TO_RUN deliberately UNSET (this is a real run now, not a
# truncated diagnostic).
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (full ${ENET_EPOCHS}-epoch run)"
echo "Block bits file:       ${ENET_S19_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET_S19_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET_S19_PRETRAINED_CHECKPOINT}"
echo "Trainable slope:       ${ENET_S19_TRAINABLE_SLOPE}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET_S19_BLOCK_BITS_FILE" "$ENET_S19_LEAKY_SLOPE_MAP_FILE" "$ENET_S19_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT ablation): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Post-training Dice check ==="
cd "$HOME/LightM-UNet"
python -c "
import torch, json
import sys
sys.path.insert(0, 'enet')
from nnunetv2.nets.QuantENetS19Block import QuantENetS19Block, OUT_CHANNELS
sys.path.insert(0, 'compression/hawq')
from eval_dice import evaluate
with open('${BLOCK_BITS_FILE}') as f: bits = json.load(f)
with open('${SLOPE_MAP_FILE}') as f: slope_map = json.load(f)
ckpt = torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)
model = QuantENetS19Block(bits['stage_weight_bits'], bits['stage_act_bits'], slope_map, trainable_slope=False)
model.load_state_dict(ckpt['network_weights'], strict=False)
device = 'cuda' if torch.cuda.is_available() else 'cpu'
model.to(device)
with open('data/nnUNet_preprocessed/${DATASET_NAME}/splits_final.json') as f:
    val_cases = json.load(f)[0]['val']
result = evaluate(model, val_cases, device, OUT_CHANNELS)
print(json.dumps(result, indent=2))
"

echo "=== Collecting results into compression/results.csv ==="
SLOPE_MAP_JSON=$(python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage experiment_s19_qat_acc2x_fixed2 \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels 4,16,32,16,4 \
    --bottlenecks 4,12,12,2,1 \
    --decoder-type upsample_conv \
    --use-asymmetric 0 \
    --context-pattern dense_dilation_reg_interleaved_double_mid \
    --separable-dilated 1 \
    --leaky-slope-map "$SLOPE_MAP_JSON" \
    --quant-bits 32 \
    --trainer-class "${TRAINER_CLASS}"
# --quant-bits 32 here is a deliberate placeholder, same rationale as
# every other per-block job's own note -- real per-block params/bops/
# LUT/BRAM live in compression/hawq/finn_block_costs_23_1.json /
# block_bits_s19_acc2x_fixed2.json, not this row's own params/flops/bops
# columns.

echo "Done: ${RUN_NAME}."
