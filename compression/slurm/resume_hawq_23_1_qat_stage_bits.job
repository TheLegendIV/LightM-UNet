#!/bin/bash
#SBATCH --job-name=resume_hawq_23_1_qat_stage_bits
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Continuation of hawq_23_1_qat_stage_bits.job: that job's --time=06:00:00
# walltime ran out mid-epoch 89/150 (see training_log_2026_8_19_17_59_20.txt
# under nnUNetTrainerENetQuant23_1__nnUNetPlans__2d/fold_0 -- nnU-Net's log
# file path is fixed at __init__ time from the trainer's DEFAULT output
# folder, before ENET_OUTPUT_FOLDER's override applies, so the log for every
# run of this config lands there instead of under the
# _hawq_23_1_qat_stage_bits folder; checkpoints themselves are unaffected
# since they're written after the override).
#
# Same stale-checkpoint_latest.pth issue as resume_3a_quant_O4_int8_no_asym.job
# (see that job's header comment for the general explanation): this config's
# debug.json has save_every=50, so checkpoint_latest.pth only refreshes on
# epoch-boundary multiples of 50 (last write was after epoch 49 completed)
# while checkpoint_best.pth updates on every new-best-EMA epoch and had
# already reached epoch 88 (last "Yayy! New best EMA pseudo Dice" in the log
# before the walltime cutoff). nnUNetv2_train --c always prefers
# checkpoint_latest.pth when present, so resuming as-is would silently throw
# away epochs 50-88. Unlike that precedent job, this one does NOT hardcode
# the epoch numbers -- it compares each checkpoint's stored 'current_epoch'
# at submit time and promotes checkpoint_best.pth over checkpoint_latest.pth
# (archiving the stale file first) only if it's actually further along, so
# this script stays correct even if it's reused after a differently-timed
# cutoff.
#
# IMPORTANT: every ENET_* knob below must stay byte-identical to the
# original job (mismatched channels/bottlenecks/decoder/quant-bits would
# break state_dict loading; a different ENET_EPOCHS would change the
# PolyLRScheduler's endpoint -- lr = initial_lr*(1-epoch/num_epochs)**0.9,
# recomputed fresh from current_epoch on every call, nnUNetTrainer.py:876 --
# and silently invalidate the "continuation" property). In particular this
# resumes the ORIGINAL cold-started, 150-epoch/250-iterations-per-epoch run
# (RUN_NAME=hawq_23_1_qat_stage_bits as committed at the time this job died)
# -- NOT whatever warm-start/40-epoch config the working tree may have moved
# on to since; that's a different experiment with an incompatible schedule
# and would need its own fresh (non-resumed) job.
#
# Confirmed via local docker smoke test (container 6d63c8c35dac): the
# checkpoint_best.pth vs checkpoint_latest.pth 'current_epoch' comparison
# promotes correctly, and nnUNetv2_train --c resumes end-to-end from the
# promoted checkpoint (network/optimizer/current_epoch/EMA/logger state all
# restored, training proceeds from the resumed epoch).

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="hawq_23_1_qat_stage_bits"
TRAINER_CLASS="nnUNetTrainerENetQuant23_1"

STAGE_BITS_FILE="compression/hawq/stage_bits_23_1.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/23_1_s19_warmstart_4c.json"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-stage QAT knobs (must match the original job -- see header) ----
export ENET23_1_STAGE_BITS_FILE="$HOME/LightM-UNet/${STAGE_BITS_FILE}"
export ENET23_1_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME} (resume)"
echo "Stage bits file: ${ENET23_1_STAGE_BITS_FILE}"
echo "Slope map file:  ${ENET23_1_LEAKY_SLOPE_MAP_FILE}"
echo "Output folder:   ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

echo "=== Checking required input files exist ==="
for f in "$ENET23_1_STAGE_BITS_FILE" "$ENET23_1_LEAKY_SLOPE_MAP_FILE"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        echo "  (run compression/hawq/ilp_search.py / extract_leaky_slope_map.py first)" >&2
        exit 1
    fi
done

echo "=== Checking training state for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists -- training already reached ${ENET_EPOCHS} epochs, skipping straight to the Dice check."
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "=== Checking whether checkpoint_best.pth is further along than checkpoint_latest.pth ==="
    python3 - <<PYEOF
import os
import shutil
import torch

folder = "${ENET_OUTPUT_FOLDER}"
latest = os.path.join(folder, "checkpoint_latest.pth")
best = os.path.join(folder, "checkpoint_best.pth")

if os.path.isfile(latest) and os.path.isfile(best):
    latest_epoch = torch.load(latest, map_location="cpu", weights_only=False)["current_epoch"]
    best_epoch = torch.load(best, map_location="cpu", weights_only=False)["current_epoch"]
    print(f"checkpoint_latest.pth resumes at epoch {latest_epoch}")
    print(f"checkpoint_best.pth   resumes at epoch {best_epoch}")
    if best_epoch > latest_epoch:
        archived = os.path.join(folder, f"checkpoint_latest_epoch{latest_epoch}_preresume.pth")
        print(f"checkpoint_best.pth is further along -- archiving stale checkpoint_latest.pth "
              f"to {os.path.basename(archived)} and promoting checkpoint_best.pth to checkpoint_latest.pth")
        shutil.copy2(latest, archived)
        shutil.copy2(best, latest)
    else:
        print("checkpoint_latest.pth is already at or past checkpoint_best.pth's epoch -- leaving as-is")
elif os.path.isfile(best):
    print("No checkpoint_latest.pth found, but checkpoint_best.pth exists -- promoting it.")
    shutil.copy2(best, latest)
else:
    print("No checkpoint_best.pth found -- resuming from checkpoint_latest.pth as-is.")
PYEOF

    echo "=== Resuming training (QAT) from checkpoint_latest.pth: ${RUN_NAME} ==="
    cd "$HOME/LightM-UNet/enet"
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
else
    echo "ERROR: no checkpoint_latest.pth, checkpoint_best.pth, or checkpoint_final.pth at ${ENET_OUTPUT_FOLDER} -- nothing to resume from." >&2
    exit 1
fi

echo "=== Post-training Dice check (compression/hawq/eval_dice.py, adapted usage) ==="
cd "$HOME/LightM-UNet"
python -c "
import torch, json
from nnunetv2.nets.QuantENet23_1 import QuantENet23_1, OUT_CHANNELS
import sys
sys.path.insert(0, 'compression/hawq')
from eval_dice import evaluate
with open('${STAGE_BITS_FILE}') as f: bits = json.load(f)
with open('${SLOPE_MAP_FILE}') as f: slope_map = json.load(f)
ckpt = torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)
model = QuantENet23_1(bits['stage_weight_bits'], bits['stage_act_bits'], slope_map)
model.load_state_dict(ckpt['network_weights'], strict=False)
device = 'cuda' if torch.cuda.is_available() else 'cpu'
model.to(device)
with open('data/nnUNet_preprocessed/${DATASET_NAME}/splits_final.json') as f:
    val_cases = json.load(f)[0]['val']
result = evaluate(model, val_cases, device, OUT_CHANNELS)
print(json.dumps(result, indent=2))
"

echo "Done: ${RUN_NAME}."
