#!/bin/bash
#SBATCH --job-name=stage_8_reginterleaved_isolation
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --array=0-3
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# Stage 8 -- RegInterleaved (nnUNetTrainerENet_6_1_reg_interleaved,
# dice=0.8167, best in the sweep) is now the default reference for this
# stage: CHANNELS=4,16,32,16,4, BOTTLENECKS=4,11,11,2,1, DECODER_TYPE=
# upsample_conv, USE_ASYMMETRIC=0, dilated/strided=1, dsc_no_projection=1,
# CONTEXT_PATTERN=dense_dilation_reg_interleaved -- all four tasks here
# keep every one of those, changing exactly one thing each.
#
#   0: 8_1_dscnoproj_context_only -- ENET_DSC_NO_PROJECTION_CONTEXT_ONLY=1
#      (new ENet.py flag). RegInterleaved's dsc_no_projection currently
#      applies network-wide: stage2/3's dilated slots AND regular1/
#      regular4/regular5 all become DSCNoProjectionBottleneck (no reduce/
#      expand). This narrows that to stage2/3 only -- regular1/4/5 revert
#      to normal projected bottlenecks (non-DSC, since the global use_dsc
#      flag stays off) -- to isolate whether the no-projection savings
#      specifically come from the dilated bottlenecks (stage2/3, "the
#      smallest bottlenecks" spatially, at 1/8 resolution) or from
#      applying it everywhere. Structurally verified (ENet.py's own
#      self-test) to be strictly cheaper than the unscoped version: a
#      DSCNoProjectionBottleneck run at full channel width with no squeeze
#      is actually MORE expensive than a projected reduce->3x3->expand at
#      regular1/4/5's narrow widths, so reverting them is a net params win
#      even before training -- this task checks whether it's also a net
#      accuracy win (or loss).
#   1: 8_2_relu -- ENET_USE_PRELU=0 (existing flag, no new code). Plain
#      ReLU instead of PReLU in the encoder, same as section 1d's original
#      PReLU-encoder/ReLU-decoder ablation, now re-run against the
#      RegInterleaved reference specifically.
#   2: 8_3_reg_bookend_dsc -- ENET_REG_BOOKEND_DSC=1 (new ENet.py flag).
#      DENSE_DILATION_REG_INTERLEAVED_PATTERN's reg-bookend slots
#      (stage2/3 indices 0/5/10) currently use a full-rank (non-DSC)
#      RegularBottleneck. This factors them into DSC WITH the projection
#      kept (RegularBottleneck's own use_dsc=True path) -- testing whether
#      the same depthwise-separable factoring that (with NO projection)
#      helps the dilated slots also pays off on the non-dilated bookends
#      once projection is retained. Structurally cheaper than the
#      full-rank version (verified in ENet.py's self-test).
#   3: 8_4_dscnoproj_context_only_dsc -- ENET_DSC_NO_PROJECTION_CONTEXT_ONLY=1
#      + ENET_USE_DSC=1 (both existing flags, no new code -- pure
#      composition). Same scope-narrowing as task 0, but regular1/4/5 now
#      build via RegularBottleneck's own use_dsc=True path (DSC WITH the
#      projection kept) instead of task 0's full-rank projected version.
#      Directly measured (not assumed) to be the cheapest of all four
#      regular1/4/5 treatments on BOTH axes -- 36394 params / 289.1M MACs,
#      vs. task 0's 36945 params / 325.1M MACs and the unscoped base's
#      37880 params / 299.9M MACs. An earlier version of this task list
#      dropped this combination as "redundant with task 0" on the
#      assumption that projected-DSC would just be a smaller step in the
#      same direction as projected-full-rank -- that assumption was wrong
#      (measuring it directly shows it isn't even between the other two on
#      cost, it's cheaper than both), so it's back in as its own task.
#
# All 4 confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations against Dataset509_ARCADE_1x1_4c) to build and train without
# error, and structurally verified in ENet.py's own self-test ("Stage-8
# RegInterleaved-isolation self-test": exact per-slot bottleneck class,
# presence/absence of reduce/expand projection, and params-strictly-less-
# than-baseline checks for both new flags, not just "it built").

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

CONFIG_NAMES=(8_1_dscnoproj_context_only 8_2_relu 8_3_reg_bookend_dsc 8_4_dscnoproj_context_only_dsc)
USE_PRELU_ARR=(1 0 1 1)
DSC_NO_PROJECTION_CONTEXT_ONLY_ARR=(1 0 0 1)
REG_BOOKEND_DSC_ARR=(0 0 1 0)
USE_DSC_ARR=(0 0 0 1)

TASK_ID=${SLURM_ARRAY_TASK_ID}
CONFIG_NAME="${CONFIG_NAMES[$TASK_ID]}"
RUN_NAME="${CONFIG_NAME}"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- RegInterleaved reference, one thing changed ------
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,11,11,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation_reg_interleaved"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU="${USE_PRELU_ARR[$TASK_ID]}"
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC="${USE_DSC_ARR[$TASK_ID]}"
export ENET_DSC_NO_PROJECTION=1
export ENET_DSC_NO_PROJECTION_CONTEXT_ONLY="${DSC_NO_PROJECTION_CONTEXT_ONLY_ARR[$TASK_ID]}"
export ENET_REG_BOOKEND_DSC="${REG_BOOKEND_DSC_ARR[$TASK_ID]}"
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "ENET_USE_PRELU=${ENET_USE_PRELU} ENET_DSC_NO_PROJECTION_CONTEXT_ONLY=${ENET_DSC_NO_PROJECTION_CONTEXT_ONLY} ENET_REG_BOOKEND_DSC=${ENET_REG_BOOKEND_DSC} ENET_USE_DSC=${ENET_USE_DSC}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for an existing checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then
    echo "Checkpoint already exists at ${ENET_OUTPUT_FOLDER} -- skipping training, going straight to collect_results.py."
else
    echo "=== Start training: ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 8_reginterleaved_isolation \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --dsc-no-projection-context-only "${ENET_DSC_NO_PROJECTION_CONTEXT_ONLY}" \
    --reg-bookend-dsc "${ENET_REG_BOOKEND_DSC}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME}."
