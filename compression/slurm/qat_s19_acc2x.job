#!/bin/bash
#SBATCH --job-name=qat_s19_acc2x
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=11:00:00
# WALLTIME: same architecture/compute graph as qat_s19_block_bits.job (only
# the per-block bit-width ints differ, not tensor shapes or op count -- see
# that job's own header for the real-HPC-rate derivation: <=1.07s/iteration
# measured on this partition). That job's own real run needed a short
# resume past its 10:00:00 budget (checkpoint_best.pth reached epoch 135 of
# 150 before the walltime cutoff) -- budgeting 11:00:00 here for the same
# reason, though resume_qat_s19_acc2x.job would be the fallback if this
# isn't enough either (mirror resume_qat_s19_block_bits.job's pattern if
# needed).
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# QAT (quantization-aware training) of the ACCURACY-WEIGHTED HAWQ two-pass
# per-block search (compression/hawq/ilp_search.py --sensitivity-weight 2.0,
# compression/hawq/block_bits_s19_acc2x.json) on nnUNetTrainerENet_19_
# reginterleaved_separable_nonneg_block_double_mid's ("S19") exact
# architecture -- same trainer class as every other S19 per-block run
# (nnUNetTrainerENetQuantS19Block), only ENET_S19_BLOCK_BITS_FILE differs.
#
# HOW THIS DIFFERS FROM THE OTHER S19 SEARCHES: qat_s19_block_bits.job used
# the default two-pass search (--sensitivity-weight 1.0, block_bits_s19.json
# -- since regenerated by the later 16-bit-candidate experiment, historical
# record preserved at block_bits_s19_validated.json). qat_s19_block_bits_
# joint.job used --joint at the same default weight (block_bits_s19_joint.json).
# This job instead weights the ILP's accuracy-impact (sensitivity) term 2x
# relative to LUT/BRAM (--sensitivity-weight 2.0, default --lut-weight/
# --bram-weight 1.0 each), still via the two-pass method and now with the
# 16-bit candidate available (compression/hawq/block_sensitivity_s19.json/
# finn_block_costs_23_1.json both include it) -- 23/37 blocks changed bits
# vs. the sensitivity_weight=1.0 two-pass result, avg weight bits 3.78->4.05,
# avg act bits 3.03->4.11, but still nothing pushed all the way to 16-bit
# even at this weighting. Calibrated cost: LUT 458.1% of budget, BRAM_18K
# 114.3% (both informational -- soft-penalty search, no hard cap).
#
# TRAINABLE SLOPE: QuantENetS19Block.py unconditionally passes
# trainable_slope=True at every encoder activation site (see
# QuantDecomposedLeakyAct's own docstring and qat_s19_block_bits_joint.job's
# own TRAINABLE SLOPE comment for the full background) -- no separate flag
# needed here.
#
# WARM START: S19's own FP32 checkpoint_final.pth -- same source
# qat_s19_block_bits.job's original two-pass run used (NOT either
# already-trained per-block QAT checkpoint), since this is an independent
# point in the bit-assignment search space, not a continuation of either.
#
# Decomposed nonneg-PReLU activation (ENET_S19_LEAKY_SLOPE_MAP_FILE below):
# same slope map as every other S19 QAT job -- NOT optional, see
# qat_s19_block_bits.job's own header for the documented incident of
# skipping it.
#
# Confirmed via local docker smoke test (nnUNetv2_train, 1 epoch/2
# iterations, ENET_VAL_ITERATIONS_PER_EPOCH=1, ENET_DISABLE_CHECKPOINTING=1):
# nnUNetTrainerENetQuantS19Block builds with block_bits_s19_acc2x.json,
# warm-starts from S19's own FP32 checkpoint_final.pth (873/996 keys
# transferred, 0 shape mismatches -- identical transfer count to every
# other S19-from-FP32 job, since only the per-block bit-width ints differ),
# all 107/107 QuantDecomposedLeakyAct sites confirmed trainable
# (nn.Parameter, requires_grad=True) AND warm-started to the real per-block
# slope-map values (spot-checked initial/down1/stage2.0 -- exact match),
# and completes a real forward+backward+optimizer step end to end.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"

RUN_NAME="s19_qat_acc2x"
TRAINER_CLASS="nnUNetTrainerENetQuantS19Block"

SOURCE_NET_NAME="nnUNetTrainerENet_19_reginterleaved_separable_nonneg_block_double_mid"
BLOCK_BITS_FILE="compression/hawq/block_bits_s19_acc2x.json"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/19_reginterleaved_separable_nonneg_block_double_mid.json"
SOURCE_CHECKPOINT="data/nnUNet_results/Dataset509_ARCADE_1x1_4c/${SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_final.pth"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- HAWQ per-block QAT knobs ---------------------------------------------------
export ENET_S19_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_S19_LEAKY_SLOPE_MAP_FILE="$HOME/LightM-UNet/${SLOPE_MAP_FILE}"
export ENET_S19_PRETRAINED_CHECKPOINT="$HOME/LightM-UNet/${SOURCE_CHECKPOINT}"
# Full 150-epoch budget, nnU-Net's real default 250 iterations/epoch --
# ENET_ITERATIONS_PER_EPOCH deliberately left UNSET, see WALLTIME comment
# above.
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"
echo "Block bits file:       ${ENET_S19_BLOCK_BITS_FILE}"
echo "Slope map file:        ${ENET_S19_LEAKY_SLOPE_MAP_FILE}"
echo "Warm-start checkpoint: ${ENET_S19_PRETRAINED_CHECKPOINT}"
echo "Output folder:         ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

echo "=== Checking required input files exist ==="
for f in "$ENET_S19_BLOCK_BITS_FILE" "$ENET_S19_LEAKY_SLOPE_MAP_FILE" "$ENET_S19_PRETRAINED_CHECKPOINT"; do
    if [ ! -f "$f" ]; then
        echo "ERROR: required file not found: $f" >&2
        exit 1
    fi
done

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Checking for a COMPLETED checkpoint for ${RUN_NAME} ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${ENET_OUTPUT_FOLDER} -- skipping training."
else
    echo "=== Start training (QAT): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Training finished for ${RUN_NAME}."

    echo "=== Archiving checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${TRAINER_CLASS}_${RUN_NAME}" 2d 0
fi

echo "=== Collecting results into compression/results.csv ==="
cd "$HOME/LightM-UNet"
SLOPE_MAP_JSON=$(python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage experiment_s19_qat_acc2x \
    --dataset-name "${DATASET_NAME}" \
    --dataset-id "${DATASET_ID}" \
    --channels 4,16,32,16,4 \
    --bottlenecks 4,12,12,2,1 \
    --decoder-type upsample_conv \
    --use-asymmetric 0 \
    --context-pattern dense_dilation_reg_interleaved_double_mid \
    --separable-dilated 1 \
    --leaky-slope-map "$SLOPE_MAP_JSON" \
    --quant-bits 32 \
    --trainer-class "${TRAINER_CLASS}"
# --quant-bits 32 here is a deliberate placeholder, same rationale as
# qat_s19_block_bits.job's own note -- real per-block params/bops/LUT/BRAM
# live in compression/hawq/finn_block_costs_23_1.json / block_bits_s19_acc2x.json,
# not this row's own params/flops/bops columns.

echo "Done: ${RUN_NAME}."
