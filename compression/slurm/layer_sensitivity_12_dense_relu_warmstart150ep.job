#!/bin/bash
#SBATCH --job-name=layer_sensitivity_12_dense_relu_warmstart150ep
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=06:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Per-layer HAWQ sensitivity (Hutchinson Hessian trace x quantization error, MILP/layer_sensitivity.py) of the S12 dense bilinear-decoder net
# nnUNetTrainerENet_12_dense_relu_warmstart150ep (checkpoint_best.pth), with MANY samples: every preprocessed training image (--n-batches 1200;
# ~1/3 are skipped for shapes ENet's stride-8 stages cannot take, ~790 are used) x 40 probes each.
#
# Why: at 64 batches x 30 probes this checkpoint still had 23-29 of 85 layers with a NEGATIVE weight trace, only 8 of them in both seeds, and a seed-to-seed
# Spearman of 0.24 (the 300-epoch checkpoint was clean at the same setting): the estimate is dominated by Hutchinson noise (one layer, regular5.0.expand.0,
# has a trace ~1e4 times the rest). ~25x more samples should cut that noise ~5x. Locally this run was OOM-killed once (all 1200 images held in RAM); the script now
# loads them one at a time, so memory stays flat.
#
# Progress: one flushed line per batch in logs/%x_<jobid>.out -- "[done] batch 213/1200 | elapsed 0:41:12 | 11.6 s/batch | ETA 3:11:40 | 14:02:11 | peak RSS 2310 MB".
#   tail -f logs/layer_sensitivity_12_dense_relu_warmstart150ep_<jobid>.out
# Output: MILP/artifacts/layer_sensitivity_12_dense_relu_warmstart150ep_n1200p40_seed${SEED}.json (override: sbatch --export=ALL,SEED=1 ...). The file is written only at the end.
# --time=06:00:00: ~790 batches x ~12 s on a laptop RTX 2050 is ~2.6 h; a MIG slice may be slower, so the margin is generous. Resubmit if it times out (no partial save).

CONFIG="config_12_dense_relu_warmstart150ep"
SEED="${SEED:-0}"
N_BATCHES=1200
N_PROBES=40
OUT_FILE="MILP/artifacts/layer_sensitivity_12_dense_relu_warmstart150ep_n${N_BATCHES}p${N_PROBES}_seed${SEED}.json"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export PYTHONUNBUFFERED=1

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Config: ${CONFIG}  seed ${SEED}  ${N_BATCHES} batches x ${N_PROBES} probes"
echo "Output: ${OUT_FILE}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

CKPT="$nnUNet_results/Dataset509_ARCADE_1x1_4c/nnUNetTrainerENet_12_dense_relu_warmstart150ep__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
if [ ! -f "$CKPT" ]; then
    echo "ERROR: checkpoint not found: $CKPT" >&2
    exit 1
fi

echo "=== Layer sensitivity (progress line per batch below) ==="
python MILP/layer_sensitivity.py \
    --config "${CONFIG}" \
    --checkpoint-name checkpoint_best.pth \
    --candidate-bits 4,6,8 \
    --n-batches "${N_BATCHES}" --n-probes "${N_PROBES}" --seed "${SEED}" \
    --out-file "${OUT_FILE}"

echo "=== Done: $(date) -> ${OUT_FILE} ==="
