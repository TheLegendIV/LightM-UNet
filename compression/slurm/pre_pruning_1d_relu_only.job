#!/bin/bash
#SBATCH --job-name=pre_pruning_1d_relu_only
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Section 1d -- PReLU-vs-ReLU ablation on O4 (Original-derived reference
# pick, native bottlenecks, upsample_conv, all special ops on, per
# cfinal_ops.env -- same structural config as 1c). Q: how much Dice does
# the ENet-paper PReLU-encoder/ReLU-decoder split buy over a single
# activation everywhere?
#
# ENET_USE_PRELU=0 collapses ENet's encoder (initial/down1/down2/regular1/
# stage2/proj2_to_3/stage3) from PReLU to plain ReLU too -- the decoder
# (regular4/regular5/up4/up5) is already hardcoded to ReLU regardless of
# this flag (see ENet.py), so this run's whole network ends up ReLU-only.
#
# Baseline ("PReLU, all on") is 1a's seed=0 run
# (nnUNetTrainerENet_1a_seed_O4_s0, Dice 0.7507) -- not retrained here, same
# convention as 1c's single-flag-off ablations reusing that run instead of
# rebuilding the "everything on" comparator.

DATASET_ID=501
DATASET_NAME="Dataset501_ARCADE"

RUN_NAME="1d_relu_only"
TRAINER_CLASS="nnUNetTrainerENet"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------

module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------

unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------

export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet configuration -------------------------------------------------------

export ENET_CHANNELS="16,16,32,16,4"
export ENET_BOTTLENECKS="4,8,8,2,1"

export ENET_DECODER_TYPE="upsample_conv"

export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=1
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_USE_PRELU=0

export ENET_EPOCHS=150

export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"


echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Run: ${RUN_NAME}"

echo "Configuration:"
echo "  Dilated:    ${ENET_USE_DILATED}"
echo "  Asymmetric: ${ENET_USE_ASYMMETRIC}"
echo "  Strided:    ${ENET_USE_STRIDED}"
echo "  DSC:        ${ENET_USE_DSC}"
echo "  PReLU:      ${ENET_USE_PRELU}"

echo "Output folder:"
echo "${ENET_OUTPUT_FOLDER}"


echo "=== GPU info ==="
nvidia-smi


cd "$HOME/LightM-UNet/enet"


echo "=== Plan + preprocess ==="

if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi


if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi


echo "=== Checking checkpoint ==="

if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] || \
   [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_best.pth" ]; then

    echo "Checkpoint exists. Skipping training."

else

    echo "=== Start training ==="

    nnUNetv2_train "${DATASET_NAME}" 2d 0 \
        -tr "${TRAINER_CLASS}"

    echo "Training finished."

    echo "=== Archiving checkpoint ==="

    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" \
        "${DATASET_NAME}" \
        "${TRAINER_CLASS}_${RUN_NAME}" \
        2d 0

fi


echo "=== Collecting results ==="

cd "$HOME/LightM-UNet"

python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
    --stage 1d_prelu_ablation \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --trainer-class "${TRAINER_CLASS}"


echo "Done: ${RUN_NAME}"
