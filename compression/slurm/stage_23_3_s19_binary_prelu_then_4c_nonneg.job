#!/bin/bash
#SBATCH --job-name=stage_23_3_s19_binary_prelu_then_4c_nonneg
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# Stage 23, strategy 3 of 3 -- transfer-training strategy comparison for
# S19's own architecture (see stage_23_1's own header for the full context;
# this is strategy 3, "150 epochs on the old binary Dataset501 problem WITH
# STANDARD PER-CHANNEL PRELU, then 150 epochs on Dataset509 4c WITH
# NONNEG_BLOCK"). Tests whether pretraining with the richer, unconstrained
# per-channel PReLU representation -- known from this project's own PReLU-
# vs-nonneg_block ablations to sometimes reach higher dice than nonneg_block
# on the same architecture -- gives nonneg_block's eventual 4c fine-tune a
# better starting point than pretraining with nonneg_block throughout
# (strategy 2, stage_23_2) or not pretraining on binary at all (strategy 1,
# stage_23_1).
#
# Phase A: S19's exact architecture, prelu_variant=standard (real per-
# channel PReLU, i.e. ENET_PRELU_VARIANT simply left unset), cold start,
# 150 epochs on Dataset501_ARCADE (binary, 2-class head auto-derived).
#
# Slope extraction: Phase A's checkpoint is a real per-channel PReLU model
# -- its activation weights do NOT share shape with nonneg_block's ONE
# shared scalar per block, so -pretrained_weights alone would silently skip
# every activation weight (same shape-mismatch-skip mechanism as the
# final.weight/bias 2-class-vs-5-class skip, just at every PReLU site
# instead of just the head) and Phase B's nonneg_block scalars would start
# blind at NonNegativePReLU's own default (0.25), wasting exactly the
# signal this strategy is trying to test. extract_leaky_slope_map.py
# --prelu-variant standard (this script's own new flag, added for this job)
# collects each bottleneck block's mean per-channel PReLU slope from Phase
# A's checkpoint -- same collect_prelu_block_means function S13's own
# from-Dataset509 warm-start recipe used, just pointed at a Dataset501
# checkpoint here. Fed into Phase B via ENET_NONNEG_BLOCK_INIT_MAP
# (nnUNetTrainerENet.py's own apply_nonneg_block_init) -- an initializer
# only, the scalar stays fully learnable afterward.
#
# Phase B: same architecture, prelu_variant=nonneg_block, -pretrained_weights
# from Phase A's checkpoint (transfers every conv/BN weight by name+shape;
# final.weight/bias and every PReLU activation weight skipped for shape
# mismatch) PLUS ENET_NONNEG_BLOCK_INIT_MAP (sets what -pretrained_weights
# itself couldn't), 150 more epochs on Dataset509 4c.
#
# Single run, not an array -- one architecture, two sequential training
# phases plus one extraction step in between, in this exact order.

DATASET_ID_A=501
DATASET_NAME_A="Dataset501_ARCADE"
DATASET_ID_B=509
DATASET_NAME_B="Dataset509_ARCADE_1x1_4c"

RUN_NAME_A="23_3a_s19_binary_prelu"
RUN_NAME_B="23_3_s19_binary_prelu_then_4c_nonneg"
TRAINER_CLASS="nnUNetTrainerENet"
SLOPE_MAP_FILE="compression/post-quantization/slope_maps/23_3a_s19_binary_prelu.json"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S19's exact recipe, activation differs by phase --
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,12,12,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation_reg_interleaved_double_mid"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=1
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=0
export ENET_SEPARABLE_DILATED=1
export ENET_DSC_NO_PROJECTION=0
export ENET_EPOCHS=150

OUTPUT_FOLDER_A="$nnUNet_results/${DATASET_NAME_A}/${TRAINER_CLASS}_${RUN_NAME_A}__nnUNetPlans__2d/fold_0"
OUTPUT_FOLDER_B="$nnUNet_results/${DATASET_NAME_B}/${TRAINER_CLASS}_${RUN_NAME_B}__nnUNetPlans__2d/fold_0"
PRETRAINED_CKPT="${OUTPUT_FOLDER_A}/checkpoint_final.pth"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Phase A: ${RUN_NAME_A} on ${DATASET_NAME_A} (standard PReLU)"
echo "Phase B: ${RUN_NAME_B} on ${DATASET_NAME_B} (nonneg_block, warm-started from Phase A)"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Phase A: plan + preprocess Dataset501 (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME_A}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID_A}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi

echo "=== Phase A: checking for a COMPLETED checkpoint for ${RUN_NAME_A} ==="
export ENET_OUTPUT_FOLDER="${OUTPUT_FOLDER_A}"
unset ENET_PRELU_VARIANT  # Phase A: prelu_variant="standard" (real per-channel PReLU)
if [ -f "${OUTPUT_FOLDER_A}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${OUTPUT_FOLDER_A} -- skipping Phase A training."
else
    echo "=== Phase A: start training: ${RUN_NAME_A} (cold start, no pretrained weights) ==="
    nnUNetv2_train "${DATASET_NAME_A}" 2d 0 -tr "${TRAINER_CLASS}"
    echo "Phase A training finished for ${RUN_NAME_A}."

    echo "=== Archiving Phase A checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME_A}" "${TRAINER_CLASS}_${RUN_NAME_A}" 2d 0
fi

echo "=== Phase A: checking checkpoint exists before extraction ==="
if [ ! -f "${PRETRAINED_CKPT}" ]; then
    echo "ERROR: Phase A checkpoint not found at ${PRETRAINED_CKPT}" >&2
    exit 1
fi

cd "$HOME/LightM-UNet"
echo "=== Extracting Phase A's real per-block leaky slope map (standard PReLU source) ==="
if [ -f "$SLOPE_MAP_FILE" ]; then
    echo "$SLOPE_MAP_FILE already exists -- skipping extraction."
else
    python compression/post-quantization/extract_leaky_slope_map.py \
        --net-name "${TRAINER_CLASS}_${RUN_NAME_A}" \
        --dataset-name "${DATASET_NAME_A}" \
        --channels "${ENET_CHANNELS}" --bottlenecks "${ENET_BOTTLENECKS}" --decoder-type "${ENET_DECODER_TYPE}" \
        --use-asymmetric "${ENET_USE_ASYMMETRIC}" --context-pattern "${ENET_CONTEXT_PATTERN}" \
        --separable-dilated "${ENET_SEPARABLE_DILATED}" --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
        --prelu-variant standard --out-channels 2 \
        --checkpoint-name checkpoint_final.pth \
        --out-file "$SLOPE_MAP_FILE"
fi
cd "$HOME/LightM-UNet/enet"

echo "=== Phase B: plan + preprocess Dataset509 (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME_B}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID_B}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME_B}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME_B}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME_B}/splits_final.json"
fi

echo "=== Phase B: checking for a COMPLETED checkpoint for ${RUN_NAME_B} ==="
export ENET_OUTPUT_FOLDER="${OUTPUT_FOLDER_B}"
export ENET_PRELU_VARIANT="nonneg_block"  # Phase B: switch to nonneg_block
export ENET_NONNEG_BLOCK_INIT_MAP="$(cd "$HOME/LightM-UNet" && python -c "import json; print(json.dumps(json.load(open('${SLOPE_MAP_FILE}'))))")"
if [ -f "${OUTPUT_FOLDER_B}/checkpoint_final.pth" ]; then
    echo "checkpoint_final.pth already exists at ${OUTPUT_FOLDER_B} -- skipping Phase B training, going straight to collect_results.py."
else
    echo "=== Phase B: start training: ${RUN_NAME_B} (warm-started from ${PRETRAINED_CKPT}, nonneg_block init from Phase A's slope map) ==="
    nnUNetv2_train "${DATASET_NAME_B}" 2d 0 -tr "${TRAINER_CLASS}" -pretrained_weights "${PRETRAINED_CKPT}"
    echo "Phase B training finished for ${RUN_NAME_B}."

    echo "=== Archiving Phase B checkpoints + logs to \$HOME/models ==="
    bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME_B}" "${TRAINER_CLASS}_${RUN_NAME_B}" 2d 0
fi

echo "=== Collecting Phase B results into compression/results.csv ==="
# No --leaky-slope-map here -- that flag only has an effect on
# prelu_variant="leaky" (nnUNetTrainerENet.py's own docstring), not
# nonneg_block. Phase B's checkpoint already has its own trained
# NonNegativePReLU per-block scalars baked in, same as every other FP32
# nonneg_block eval in this repo (e.g. S19's own collect_results.py call).
cd "$HOME/LightM-UNet"
python compression/collect_results.py \
    --net-name "${TRAINER_CLASS}_${RUN_NAME_B}" \
    --stage 23_s19_transfer_strategies \
    --dataset-name "${DATASET_NAME_B}" \
    --dataset-id "${DATASET_ID_B}" \
    --channels "${ENET_CHANNELS}" \
    --bottlenecks "${ENET_BOTTLENECKS}" \
    --decoder-type "${ENET_DECODER_TYPE}" \
    --use-dilated "${ENET_USE_DILATED}" \
    --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
    --use-strided "${ENET_USE_STRIDED}" \
    --use-dsc "${ENET_USE_DSC}" \
    --separable-dilated "${ENET_SEPARABLE_DILATED}" \
    --context-pattern "${ENET_CONTEXT_PATTERN}" \
    --use-prelu "${ENET_USE_PRELU}" \
    --prelu-variant "${ENET_PRELU_VARIANT}" \
    --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
    --trainer-class "${TRAINER_CLASS}"

echo "Done: ${RUN_NAME_B} (via ${RUN_NAME_A})."
