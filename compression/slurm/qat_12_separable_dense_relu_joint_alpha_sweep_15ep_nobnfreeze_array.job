#!/bin/bash
#SBATCH --job-name=qat_12_separable_dense_relu_joint_alpha_sweep_15ep_nobnfreeze
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --array=0-4
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# NON-frozen (BN keeps adapting normally) half of a 2-array A/B comparison
# against qat_12_separable_dense_relu_joint_alpha_sweep_15ep_bnfreeze_array.
# job (identical in every way except ENET_FREEZE_BN) -- same 5 alpha points
# (0.0/0.25/0.5/0.75/1.0,
# --max-latency-ms 1000 --clock-mhz 100 hard-capped combined bits+folding
# ILP results) as the earlier 5-epoch sweep, but a real 15-epoch schedule
# this time, with a DISTINCT checkpoint saved every 5 epochs (checkpoint_
# epoch5.pth/epoch10.pth/epoch15.pth, via the new ENET_CHECKPOINT_EVERY --
# see enet/nnunetv2/training/nnUNetTrainer/nnUNetTrainerENet.py's own
# on_epoch_end docstring; NOT the same as nnU-Net's own save_every, which
# only keeps ONE rolling checkpoint_latest.pth, overwritten each interval).
#
# PURPOSE (two separate questions this A/B is answering):
#   1. Does freezing BatchNorm during QAT help, and by how much? -- compare
#      this array's own results.csv rows against the nobnfreeze array's,
#      alpha-by-alpha, epoch-by-epoch.
#   2. Is 5 epochs (the earlier sweep's budget) enough to determine the
#      TRUE relative ranking across alpha values, or does the ranking shift
#      between 5/10/15 epochs? -- compare THIS array's own epoch5/epoch10/
#      epoch15 rows against each other, per alpha.
# These are orthogonal axes (BN freeze x epoch count), which is why this is
# two separate arrays rather than one -- a single job can't hold both an
# ENET_FREEZE_BN=1 and =0 run for the same array task index.
#
# Runs on ENTIRELY FRESH output-folder names (RUN_NAME_ARR below has never
# been used by any earlier job, including the original 5-epoch sweep) --
# deliberately, to rule out one plausible cause of a real anomaly seen in
# that earlier sweep (alpha=0.25 there reported epochs=1 in its results.csv
# row despite ENET_EPOCHS=5 being set uniformly across the array; this
# session could not conclusively root-cause it without the real HPC-side
# SLURM logs for that task, which aren't available from the dev sandbox --
# a stale/mismatched pre-existing checkpoint being picked up by the
# "resume" logic below was the leading candidate explanation). Starting
# every task here from a checkpoint history of zero removes that
# possibility entirely for this run.
QAT_EPOCHS=15
ENET_FREEZE_BN=0
ENET_CHECKPOINT_EVERY=5

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerCombinedQuantENet_12_separable_dense_relu_perblock"
FP32_SOURCE_NET_NAME="nnUNetTrainerENet_12_separable_dense_relu"

BLOCK_BITS_ARR=(
    "compression/hawq/artifacts/block_bits_folding_12_separable_dense_relu_joint_alpha0.0_maxlat1000ms.json"
    "compression/hawq/artifacts/block_bits_folding_12_separable_dense_relu_joint_alpha0.25_maxlat1000ms.json"
    "compression/hawq/artifacts/block_bits_folding_12_separable_dense_relu_joint_alpha0.5_maxlat1000ms.json"
    "compression/hawq/artifacts/block_bits_folding_12_separable_dense_relu_joint_alpha0.75_maxlat1000ms.json"
    "compression/hawq/artifacts/block_bits_folding_12_separable_dense_relu_joint_alpha1.0_maxlat1000ms.json"
)
CALIBRATED_NET_ARR=(
    nnUNetTrainerCombinedQuantENet_12_separable_dense_relu_perblock_joint_alpha0.0_maxlat1000ms_calibrated
    nnUNetTrainerCombinedQuantENet_12_separable_dense_relu_perblock_joint_alpha0.25_maxlat1000ms_calibrated
    nnUNetTrainerCombinedQuantENet_12_separable_dense_relu_perblock_joint_alpha0.5_maxlat1000ms_calibrated
    nnUNetTrainerCombinedQuantENet_12_separable_dense_relu_perblock_joint_alpha0.75_maxlat1000ms_calibrated
    nnUNetTrainerCombinedQuantENet_12_separable_dense_relu_perblock_joint_alpha1.0_maxlat1000ms_calibrated
)
RUN_NAME_ARR=(
    12_separable_dense_relu_joint_alpha0.0_maxlat1000ms_ft15ep_nobnfreeze
    12_separable_dense_relu_joint_alpha0.25_maxlat1000ms_ft15ep_nobnfreeze
    12_separable_dense_relu_joint_alpha0.5_maxlat1000ms_ft15ep_nobnfreeze
    12_separable_dense_relu_joint_alpha0.75_maxlat1000ms_ft15ep_nobnfreeze
    12_separable_dense_relu_joint_alpha1.0_maxlat1000ms_ft15ep_nobnfreeze
)

TASK_ID=${SLURM_ARRAY_TASK_ID}
BLOCK_BITS_FILE="${BLOCK_BITS_ARR[$TASK_ID]}"
CALIBRATED_NET_NAME="${CALIBRATED_NET_ARR[$TASK_ID]}"
RUN_NAME="${RUN_NAME_ARR[$TASK_ID]}"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME}"
echo "BLOCK_BITS_FILE=${BLOCK_BITS_FILE}"
echo "QAT_EPOCHS=${QAT_EPOCHS}"
echo "ENET_FREEZE_BN=${ENET_FREEZE_BN}"
echo "ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}"

FP32_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${FP32_SOURCE_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== Checking FP32 source checkpoint exists ==="
if [ ! -f "$FP32_CHECKPOINT" ]; then
    echo "ERROR: FP32 source checkpoint not found: $FP32_CHECKPOINT -- run stage_12_separable_dense_relu.job first." >&2
    exit 1
fi

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet"

CALIBRATED_CHECKPOINT="$nnUNet_results/${DATASET_NAME}/${CALIBRATED_NET_NAME}__nnUNetPlans__2d/fold_0/checkpoint_best.pth"
echo "=== STEP 1: calibrate (warm-start from the real FP32 checkpoint; skip if already done) ==="
if [ -f "$CALIBRATED_CHECKPOINT" ]; then
    echo "Calibrated checkpoint already exists at ${CALIBRATED_CHECKPOINT} -- skipping calibration."
else
    python compression/post-quantization/calibrate_12_separable_dense_relu_perblock.py \
        --source-net-name "${FP32_SOURCE_NET_NAME}" \
        --out-net-name "${CALIBRATED_NET_NAME}" \
        --dataset-name "${DATASET_NAME}" \
        --block-bits-file "${BLOCK_BITS_FILE}"
fi

echo "=== STEP 2: real QAT fine-tuning, complete ${QAT_EPOCHS}-epoch schedule ==="
export ENET_BLOCK_BITS_FILE="$HOME/LightM-UNet/${BLOCK_BITS_FILE}"
export ENET_PRETRAINED_CHECKPOINT="${CALIBRATED_CHECKPOINT}"
export ENET_EPOCHS=${QAT_EPOCHS}
export ENET_FREEZE_BN=${ENET_FREEZE_BN}
export ENET_CHECKPOINT_EVERY=${ENET_CHECKPOINT_EVERY}
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    # Diagnostic (added after a real anomaly in the earlier 5-epoch sweep --
    # see header): print exactly what was found and why the script is about
    # to resume vs. skip, so an unexpected outcome is visible in THIS run's
    # own log rather than only inferable after the fact from results.csv.
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "DIAGNOSTIC: found existing checkpoint at ${EXISTING_CHECKPOINT}, current_epoch=${CURRENT_EPOCH}, target ENET_EPOCHS=${ENET_EPOCHS}. This folder should NOT have pre-existed (RUN_NAME=${RUN_NAME} is new this array) -- if you see this branch taken, something wrote to ${ENET_OUTPUT_FOLDER} before this task ran; investigate before trusting this task's results.csv row."
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real ${QAT_EPOCHS}-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME ${QAT_EPOCHS}-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real ${QAT_EPOCHS}-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    NET_NAME="${TRAINER_CLASS}_${RUN_NAME}"
    COMMON_ARGS=(
        --net-name "${NET_NAME}"
        --dataset-name "${DATASET_NAME}"
        --dataset-id "${DATASET_ID}"
        --channels 4,16,32,16,4
        --bottlenecks 4,8,8,2,1
        --decoder-type upsample_conv
        --use-asymmetric 0
        --context-pattern dense_dilation
        --separable-dilated 1
        --quant-bits 8
        --trainer-class "${TRAINER_CLASS}"
    )
    # --quant-bits 8 is a deliberate placeholder (this row's REAL per-block
    # bits AND folding live in the block_bits_folding_*.json file this task
    # was built from, not this row's own params/flops/bops columns), same
    # convention every other per-block job's own collect_results.py call
    # uses.
    # DIAGNOSTIC (added after a real, now-explained anomaly in the earlier
    # 5-epoch sweep -- alpha=0.25 there reported epochs=1 in its results.csv
    # row despite training a real, complete 5-epoch schedule: checkpoint_
    # best.pth only gets overwritten when EMA pseudo-dice IMPROVES, and in
    # that run it improved once, at epoch 0, and never again -- so "best"
    # stayed frozen at "1 epoch done" metadata while training correctly
    # continued to epoch 5. Not a bug, just easy to misread from the CSV
    # alone -- print both epoch counts explicitly here so a plateaued
    # "best" is visible in THIS log immediately, not only inferable from
    # results.csv afterward.
    BEST_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_best.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
    echo "DIAGNOSTIC: checkpoint_best.pth is at epoch ${BEST_EPOCH}, checkpoint_final.pth is at epoch ${FINAL_EPOCH} (target ${ENET_EPOCHS})."
    if [ "$BEST_EPOCH" != "$FINAL_EPOCH" ]; then
        echo "NOTE: 'best' EMA dice plateaued before the run finished (last improved at epoch ${BEST_EPOCH}, training reached ${FINAL_EPOCH}) -- the standard row below reports epoch-${BEST_EPOCH} weights, not epoch-${FINAL_EPOCH}. This is real, not a failure -- the epoch5/10/15 rows below are NOT affected (fixed snapshots, independent of EMA-best tracking)."
    fi
    # collect_results.py's own prediction_dir (labelsPr_<net-name>) is keyed
    # ONLY by --net-name, which is the SAME across all 4 calls below (only
    # --checkpoint-name differs) -- and it SKIPS re-running inference if
    # that directory already exists (see its own --skip-inference flag /
    # "if not prediction_dir.exists()" check), by design, for a caller that
    # wants to re-score already-known-good predictions without repeating
    # slow inference. That default is WRONG for this job specifically: each
    # call below predicts from DIFFERENT checkpoint weights, so reusing a
    # prior call's predictions silently scores the WRONG checkpoint under
    # the right label. Force fresh inference every time by removing the
    # shared prediction dir before each call.
    PREDICTION_DIR="$nnUNet_raw/${DATASET_NAME}/labelsPr_${NET_NAME}"

    echo "--- Evaluating checkpoint_best.pth (standard 'best EMA dice' row) ---"
    rm -rf "${PREDICTION_DIR}"
    python compression/collect_results.py "${COMMON_ARGS[@]}" \
        --stage "${RUN_NAME}" --checkpoint-name checkpoint_best.pth

    for EP in 5 10 15; do
        CKPT="${ENET_OUTPUT_FOLDER}/checkpoint_epoch${EP}.pth"
        if [ -f "$CKPT" ]; then
            echo "--- Evaluating checkpoint_epoch${EP}.pth ---"
            rm -rf "${PREDICTION_DIR}"
            python compression/collect_results.py "${COMMON_ARGS[@]}" \
                --stage "${RUN_NAME}_epoch${EP}" --config-name "${NET_NAME}_epoch${EP}" \
                --checkpoint-name "checkpoint_epoch${EP}.pth"
        else
            echo "checkpoint_epoch${EP}.pth not found at ${ENET_OUTPUT_FOLDER} -- skipping that row."
        fi
    done
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME}."
