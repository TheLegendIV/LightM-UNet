#!/bin/bash
#SBATCH --job-name=stage_8_2_relu_no_reg_dscproj_r
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=05:00:00
#SBATCH --array=0-2
#SBATCH --output=logs/%x_%a_%j.out
#SBATCH --error=logs/%x_%a_%j.err

set -e

# S8.2 "no reg" (plain dense_dilation, native full width channels=
# (4,16,32,16,4) -- same width as nnUNetTrainerENet_8_2_relu_no_reg_
# fullwidth), but instead of that net's own dsc_no_projection=1 (DSC with
# NO reduce/expand at all, operating at the full channel width), this
# family adds a real 1x1 reduce/expand projection BEFORE and AFTER the
# depthwise+pointwise DSC pair -- exactly RegularBottleneck's own
# pre-existing use_dsc=True branch (reduce: C -> C/r, DSC at C/r width,
# expand: C/r -> C), swept at r (ENet.py's new dsc_internal_ratio
# constructor param, added this session and threaded through every
# RegularBottleneck(...) call site) in {2,4,8}:
#
#   0: r=2 -- internal width C/2 (e.g. context stage 32 -> 16)
#   1: r=4 -- internal width C/4 (e.g. context stage 32 -> 8, ENet's own
#      pre-existing DEFAULT internal_ratio, included here for a genuine
#      3-point sweep even though it's not a "new" configuration per se)
#   2: r=8 -- internal width C/8 (e.g. context stage 32 -> 4)
#
# This is a STRUCTURALLY DIFFERENT bottleneck (RegularBottleneck+use_dsc,
# real reduce/expand modules) from nnUNetTrainerENet_8_2_relu_no_reg_
# fullwidth's own DSCNoProjectionBottleneck (no reduce/expand at all) --
# NOT weight-compatible, no warm-start possible. Every task trains from
# scratch (fresh init). Verified: all 3 r values build + forward-pass
# correctly at the intended internal channel width (checked directly:
# r=2/4/8 -> context-stage internal_channels=16/8/4 out of 32, exactly
# C/r), and the ENET_DSC_INTERNAL_RATIO env var (new this session, added
# to nnUNetTrainerENet.py's own build_network_architecture) correctly
# threads through. Smoke-tested (1 epoch, docker, reduced iterations,
# r=4) with a clean exit before this job was written.
#
# ENET_EPOCHS=150 sets the REAL PolyLR schedule length ("LR of 150 total
# epochs" -- the schedule's own LR decay is computed against the full 150,
# not against however many epochs any one submission actually runs);
# ENET_MAX_EPOCHS_TO_RUN=50 caps EACH submission to 50 of those 150 (per
# explicit request: "Perform 50 epoch tests"). Standard LR (no ENET_LR
# override). Self-healing checkpoint_final.pth-vs-checkpoint_latest.pth
# promotion included (same real incident/rationale as every other
# multi-submission job this session -- see qat_8_2_relu_no_reg_w20_
# perblock_acc2x_15ep.job's own header) since a 50-epoch submission is a
# real candidate for a SLURM --time wall-clock cutoff mid-run.

DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_1x1_4c"
TRAINER_CLASS="nnUNetTrainerENet"

R_VALUES=(2 4 8)
TASK_ID=${SLURM_ARRAY_TASK_ID}
R="${R_VALUES[$TASK_ID]}"
RUN_NAME="8_2_relu_no_reg_dscproj_r${R}"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs -- S8.2 native width, plain dense_dilation, DSC+projection at ratio r
export ENET_CHANNELS="4,16,32,16,4"
export ENET_BOTTLENECKS="4,8,8,2,1"
export ENET_CONTEXT_PATTERN="dense_dilation"
export ENET_DECODER_TYPE="upsample_conv"
export ENET_USE_PRELU=0
export ENET_USE_DILATED=1
export ENET_USE_ASYMMETRIC=0
export ENET_USE_STRIDED=1
export ENET_USE_DSC=1
export ENET_DSC_INTERNAL_RATIO="${R}"
export ENET_DSC_NO_PROJECTION=0
export ENET_DSC_NO_PROJECTION_CONTEXT_ONLY=0
export ENET_REG_BOOKEND_DSC=0
export ENET_EPOCHS=150
export ENET_MAX_EPOCHS_TO_RUN=50
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${TRAINER_CLASS}_${RUN_NAME}__nnUNetPlans__2d/fold_0"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Array task: ${TASK_ID} -> ${RUN_NAME} (r=${R})"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

cd "$HOME/LightM-UNet/enet"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist, skipping."
fi
if [ -f "$nnUNet_raw/${DATASET_NAME}/splits_final.json" ]; then
    cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
       "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"
fi

echo "=== Self-healing check: promote checkpoint_latest.pth over a STALE checkpoint_final.pth ==="
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ] && [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    FINAL_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    LATEST_EPOCH_CHECK=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth', map_location='cpu', weights_only=False)['current_epoch'])")
    if [ "$LATEST_EPOCH_CHECK" -gt "$FINAL_EPOCH_CHECK" ]; then
        echo "checkpoint_final.pth (epoch ${FINAL_EPOCH_CHECK}) is STALE relative to checkpoint_latest.pth (epoch ${LATEST_EPOCH_CHECK}) -- promoting latest, backing up the stale final."
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final_STALE_epoch${FINAL_EPOCH_CHECK}_backup.pth"
        cp "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
    fi
fi

echo "=== Checking training progress for ${RUN_NAME} ==="
EXISTING_CHECKPOINT=""
if [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_final.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_final.pth"
elif [ -f "${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth" ]; then
    EXISTING_CHECKPOINT="${ENET_OUTPUT_FOLDER}/checkpoint_latest.pth"
fi

if [ -z "$EXISTING_CHECKPOINT" ]; then
    echo "=== Start training (fresh): ${RUN_NAME} ==="
    nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}"
else
    CURRENT_EPOCH=$(cd "$HOME/LightM-UNet" && python -c "import torch; print(torch.load('${EXISTING_CHECKPOINT}', map_location='cpu', weights_only=False)['current_epoch'])")
    echo "Existing checkpoint (${EXISTING_CHECKPOINT}) is at epoch ${CURRENT_EPOCH}/${ENET_EPOCHS}."
    if [ "$CURRENT_EPOCH" -ge "$ENET_EPOCHS" ]; then
        echo "Real 150-epoch schedule already complete -- skipping training."
    else
        echo "=== Resuming training with --c (continues the SAME 150-epoch LR schedule from epoch ${CURRENT_EPOCH}) ==="
        nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr "${TRAINER_CLASS}" --c
    fi
fi
echo "Training step finished for ${RUN_NAME} (this submission's epoch budget)."

echo "=== Collecting results into compression/results.csv (only meaningful once the real 150-epoch schedule is complete) ==="
cd "$HOME/LightM-UNet"
FINAL_EPOCH=$(python -c "import torch; print(torch.load('${ENET_OUTPUT_FOLDER}/checkpoint_final.pth', map_location='cpu', weights_only=False)['current_epoch'])" 2>/dev/null || echo -1)
if [ "$FINAL_EPOCH" -ge "$ENET_EPOCHS" ]; then
    python compression/collect_results.py \
        --net-name "${TRAINER_CLASS}_${RUN_NAME}" \
        --stage "8_2_relu_no_reg_dscproj_r${R}" \
        --dataset-name "${DATASET_NAME}" \
        --dataset-id "${DATASET_ID}" \
        --channels "${ENET_CHANNELS}" \
        --bottlenecks "${ENET_BOTTLENECKS}" \
        --decoder-type "${ENET_DECODER_TYPE}" \
        --use-dilated "${ENET_USE_DILATED}" \
        --use-asymmetric "${ENET_USE_ASYMMETRIC}" \
        --use-strided "${ENET_USE_STRIDED}" \
        --use-dsc "${ENET_USE_DSC}" \
        --context-pattern "${ENET_CONTEXT_PATTERN}" \
        --use-prelu "${ENET_USE_PRELU}" \
        --dsc-no-projection "${ENET_DSC_NO_PROJECTION}" \
        --dsc-no-projection-context-only "${ENET_DSC_NO_PROJECTION_CONTEXT_ONLY}" \
        --reg-bookend-dsc "${ENET_REG_BOOKEND_DSC}" \
        --trainer-class "${TRAINER_CLASS}"
else
    echo "Only at epoch ${FINAL_EPOCH}/${ENET_EPOCHS} -- skipping collect_results.py (resubmit this job to continue training)."
fi

echo "Done: ${RUN_NAME} (r=${R})."
