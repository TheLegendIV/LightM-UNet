#!/bin/bash
#SBATCH --job-name=preprocess_508
#SBATCH --partition=rome           # CPU-only -- no GPU needed for plan_and_preprocess
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Plan+preprocess Dataset508_ARCADE_refinement_hard from nnUNet_raw only --
# no training, no GPU. Mirrors preprocess_dataset507.job. Requires
# build_dataset508_refinement_hard.sh (plain local script, not a SLURM job --
# run directly on an HPC node) to have completed first, which itself
# requires run_enetoriginal_probabilities.job before that -- run order:
# probabilities (sbatch) -> build (bash, local) -> preprocess (sbatch).



DATASET_ID=508
DATASET_NAME="Dataset508_ARCADE_refinement_hard"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "CPUs: ${SLURM_CPUS_PER_TASK:-unknown}"

echo "=== Plan + preprocess ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Confirm planned patch_size (expect [96, 96] -- built at 96x96 natively this time) ==="
python - <<'PY'
import json, os
from pathlib import Path
p = Path(os.environ["nnUNet_preprocessed"]) / "Dataset508_ARCADE_refinement_hard" / "nnUNetPlans.json"
cfg = json.loads(p.read_text())["configurations"]["2d"]
print("patch_size:", cfg["patch_size"])
print("batch_size:", cfg["batch_size"])
PY

echo "Preprocessing finished for ${DATASET_NAME}."
