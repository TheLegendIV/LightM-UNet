#!/bin/bash
#SBATCH --job-name=enetpost
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --mem=120G
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# nnUNetTrainerENetPost on Dataset509_ARCADE_ENetPost -- ENetOriginal's own
# architecture (nnunetv2.nets.ENet.ENet, not the ENetCombo attention-gate
# family), fed 2 channels: Dataset501's original grayscale image (channel 0)
# plus nnUNetTrainerSmallENet's own reconstructed vessel-probability map,
# trained on Dataset507_ARCADE_refinement (channel 1) -- see
# dataset-prep/prepare_arcade_509_enetpost.py for exactly how Dataset509 was
# built (grid+overlay confidence-blend reconstruction, same technique
# analysis/Dataset507_ARCADE_refinement/preview_507_smallenet_grid_reconstruction.ipynb
# validated: that checkpoint's confidence-blend view beat SmallENet trained
# directly on 502/504/505 on the same standardized evaluation).
#
# No architecture changes needed to add the second channel -- ENet.__init__
# already takes in_channels from num_input_channels
# (nnUNetTrainerENet.build_network_architecture reads it off the dataset),
# so this is a plain 2-channel ENetOriginal run, same channels config
# (20,72,144,72,20) as every other ENet* trainer in this repo unless
# ENET_CHANNELS is overridden below.
#
# Adds one thing on top of plain ENetOriginal: a weight-1.0 clDice loss term
# (DC_and_CE_and_clDice_loss, do_bg=False -- scores connectivity for the 3
# foreground classes, LAD/RCA/LCX, background excluded) -- see
# nnUNetTrainerENetPost.py's docstring. ENETPOST_CLDICE_WEIGHT=0 would
# reproduce plain Dice+CE exactly; left at the trainer's own default (1.0)
# here, just set explicitly so the log shows what actually ran.
#
# Batch size, LR, epochs, etc. are all inherited from nnUNetTrainerENet's
# ENET_* env vars (unset here -- same defaults train.job/Dataset501 used),
# since Dataset509 is image-scale-identical to Dataset501 (512x512, same
# split) -- nothing about the auto-configured batch size should need to
# change just because of the extra input channel.



RUN_NAME="nnUNetTrainerENetPost"
DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_ENetPost"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

# -- ENetPost trainer knobs ----------------------------------------------------
export ENETPOST_CLDICE_WEIGHT=1.0   # explicit for log visibility -- matches the trainer default
export ENETPOST_CLDICE_ITERS=12     # explicit for log visibility -- matches the trainer default
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"
# ENET_CHANNELS / ENET_LR / ENET_EPOCHS / ENET_BATCH_SIZE left at their
# defaults (20,72,144,72,20 / 1e-3 / whatever nnUNetTrainerLightMUNet's base
# default is / nnU-Net's own auto-planned batch size).

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "Trainer: ${RUN_NAME}"
echo "ENETPOST_CLDICE_WEIGHT=${ENETPOST_CLDICE_WEIGHT}"
echo "ENETPOST_CLDICE_ITERS=${ENETPOST_CLDICE_ITERS}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Dataset check ==="
ls "$nnUNet_raw/${DATASET_NAME}"
cat "$nnUNet_raw/${DATASET_NAME}/dataset.json"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Plan check (expect 512x512, matching Dataset501) ==="
python - <<PY
import json
import os
from pathlib import Path

p = Path(os.environ["nnUNet_preprocessed"]) / "${DATASET_NAME}" / "nnUNetPlans.json"
with open(p, "r") as f:
    plans = json.load(f)

cfg = plans["configurations"]["2d"]
print("patch_size:", cfg["patch_size"])
print("batch_size:", cfg["batch_size"])
print("median_image_size_in_voxels:", cfg["median_image_size_in_voxels"])

assert cfg["patch_size"] == [512, 512], "Dataset509 did not plan a 512x512 patch size"
assert cfg["median_image_size_in_voxels"] == [512.0, 512.0], "Unexpected median image size"
PY

echo "=== Start ENetPost training ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerENetPost

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."
