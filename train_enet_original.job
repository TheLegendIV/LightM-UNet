#!/bin/bash
#SBATCH --job-name=enet_original
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# nnUNetTrainerENet on Dataset501_ARCADE -- "ENet original" arm of the ENet
# vs ENet-E1 compression study: reduced channel widths
# (16, 64, 128, 128, 64, 16 -- stage2/3 share one value since there's no
# downsampling between them, so ENet.py's 5-value channels tuple is
# (16, 64, 128, 64, 16)). Same task/data as train_enet_e1.job -- binary
# vessel segmentation (background=0, vessel=1), single grayscale input
# channel, full 512x512 frames (--grid 1x1, no patch tiling) -- only
# ENET_CHANNELS differs between the two arms.
#
# Only ENET_CHANNELS/ENET_EPOCHS are set explicitly below; ENET_BATCH_SIZE
# is left unset so nnU-Net's own auto-planned batch size is used (matches
# the convention in train_small_refinement_enet_508.job).


RUN_NAME="nnUNetTrainerENet_Original"
DATASET_ID=501
DATASET_NAME="Dataset501_ARCADE"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- ENet trainer knobs --------------------------------------------------------
export ENET_CHANNELS="16,64,128,64,16"   # ENet original (this study's compressed baseline)
export ENET_EPOCHS=150
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"
# ENET_BATCH_SIZE / ENET_LR left at their defaults (nnU-Net's own
# auto-planned batch size / 1e-3).

cd "$HOME/LightM-UNet/enet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "Trainer: ${RUN_NAME}"
echo "ENET_CHANNELS=${ENET_CHANNELS}"
echo "ENET_EPOCHS=${ENET_EPOCHS}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Dataset check ==="
ls "$nnUNet_raw/${DATASET_NAME}"
cat "$nnUNet_raw/${DATASET_NAME}/dataset.json"

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Plan check (expect 512x512, matching Dataset501) ==="
python - <<PY
import json
import os
from pathlib import Path

p = Path(os.environ["nnUNet_preprocessed"]) / "${DATASET_NAME}" / "nnUNetPlans.json"
with open(p, "r") as f:
    plans = json.load(f)

cfg = plans["configurations"]["2d"]
print("patch_size:", cfg["patch_size"])
print("batch_size:", cfg["batch_size"])
print("median_image_size_in_voxels:", cfg["median_image_size_in_voxels"])

assert cfg["patch_size"] == [512, 512], "Dataset501 did not plan a 512x512 patch size"
assert cfg["median_image_size_in_voxels"] == [512.0, 512.0], "Unexpected median image size"
PY

echo "=== Start ENet-original training ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerENet

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."

echo "=== Archiving checkpoints + logs to \$HOME/models ==="
bash "$HOME/LightM-UNet/scripts/archive_checkpoint.sh" "${DATASET_NAME}" "${RUN_NAME}" 2d 0
