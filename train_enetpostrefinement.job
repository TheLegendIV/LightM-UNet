#!/bin/bash
#SBATCH --job-name=enetpostrefinement
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

set -e

# nnUNetTrainerENetPostRefinement on Dataset509_ARCADE_ENetPost -- the
# "separate stems, fuse later" sibling of train_enetpost.job's ENetPost.
# Same dataset, same clDice-augmented loss (inherited unchanged from
# nnUNetTrainerENetPost), only the network differs: ENetPostRefinement
# (nnunetv2/nets/ENetPostRefinement.py) gives each input channel its own
# ENet InitialBlock stem before fusing via a 1x1 conv, instead of plain
# ENet's single shared first conv mixing both channels immediately. See
# ENetPostRefinement.py's module docstring for the reasoning (channel 1 is
# a prior guess from another model, not an independent modality -- early
# fusion risks the same passthrough-shortcut behavior
# nnUNetTrainerSmallRefinementENet needed a gap-focused loss to fight on
# Dataset508).
#
# --partition=gpu_mig here (vs. train_enetpost.job's gpu_a100) -- resource
# sizing (--cpus-per-task=8, --mem=64G) adapted down to match this repo's
# other gpu_mig jobs' convention, NOT measured for this specific network at
# full 512x512 scale. ENetPostRefinement is ~300 params heavier than plain
# 2-channel ENet (466,907 vs 466,609 -- confirmed via direct smoke test) so
# memory/time needs should be close to train_enetpost.job's, but watch the
# first epoch's wall-clock/memory and adjust --mem/--time if this partition's
# MIG slice turns out tighter than expected.
#
# IMPORTANT: requires Dataset509_ARCADE_ENetPost to already exist -- see
# dataset-prep/prepare_arcade_509_enetpost.py (built once already, reused
# here; not regenerated by this job).



RUN_NAME="nnUNetTrainerENetPostRefinement"
DATASET_ID=509
DATASET_NAME="Dataset509_ARCADE_ENetPost"

mkdir -p logs

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

# -- ENetPostRefinement trainer knobs ------------------------------------------
export ENETPOST_CLDICE_WEIGHT=1.0   # explicit for log visibility -- matches the trainer default
export ENETPOST_CLDICE_ITERS=12     # explicit for log visibility -- matches the trainer default
export ENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"
# ENETPOST_STEM_CHANNELS left unset -- defaults to max(2, initial_channels // 2)
# (see ENetPostRefinement.py), i.e. half of ENET_CHANNELS' first value.
# ENET_CHANNELS / ENET_LR / ENET_EPOCHS / ENET_BATCH_SIZE left at their
# defaults, same as train_enetpost.job.

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "Trainer: ${RUN_NAME}"
echo "ENETPOST_CLDICE_WEIGHT=${ENETPOST_CLDICE_WEIGHT}"
echo "ENETPOST_CLDICE_ITERS=${ENETPOST_CLDICE_ITERS}"
echo "Output folder: ${ENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Dataset check ==="
ls "$nnUNet_raw/${DATASET_NAME}"
cat "$nnUNet_raw/${DATASET_NAME}/dataset.json"

echo "=== Plan + preprocess (skipped if already done -- e.g. by train_enetpost.job's earlier run) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Plan check (expect 512x512, matching Dataset501) ==="
python - <<PY
import json
import os
from pathlib import Path

p = Path(os.environ["nnUNet_preprocessed"]) / "${DATASET_NAME}" / "nnUNetPlans.json"
with open(p, "r") as f:
    plans = json.load(f)

cfg = plans["configurations"]["2d"]
print("patch_size:", cfg["patch_size"])
print("batch_size:", cfg["batch_size"])
print("median_image_size_in_voxels:", cfg["median_image_size_in_voxels"])

assert cfg["patch_size"] == [512, 512], "Dataset509 did not plan a 512x512 patch size"
assert cfg["median_image_size_in_voxels"] == [512.0, 512.0], "Unexpected median image size"
PY

echo "=== Start ENetPostRefinement training ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerENetPostRefinement

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."
