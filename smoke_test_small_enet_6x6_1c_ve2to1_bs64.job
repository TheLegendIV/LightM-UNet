#!/bin/bash
#SBATCH --job-name=small_enet_6x6_1c_ve2to1_bs64_smoketest
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=00:30:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Quick end-to-end smoke test for nnUNetTrainerSmallENet on
# Dataset503_ARCADE_6x6_1c_ve2to1 (2:1 vessel:empty rebalanced training pool,
# see dataset-prep/downsample_empty_patches.py) with batch_size=64 instead of
# the batch_size=12 used in train_small_enet_6x6_1c.job/_ve2to1.job -- just
# enough (2 epochs, 5 train / 2 val iterations) to prove batch_size=64 fits in
# VRAM on this MIG slice and trains without crashing/NaNs before committing a
# full 150-epoch run at that batch size.
#
# nnU-Net's own planner set batch_size=362 in this dataset's plans.json (auto
# batch size for the default architecture at this patch size/resolution), so
# 64 should have plenty of headroom on a small, full-resolution, no-pooling
# net like SmallENet -- this smoke test is here to actually confirm that
# rather than assume it.
#
# Also runs nnUNetv2_plan_and_preprocess -d 503 if not already done, since
# Dataset503 hasn't been preprocessed yet at the time this job was written.
#
# Separate output folder from both the batch_size=12 real run and any other
# smoke tests (nnUNetTrainerSmallENet_smoketest_bs64), so this never collides
# with or contaminates real checkpoints.

set -e
mkdir -p logs

RUN_NAME="nnUNetTrainerSmallENet"
DATASET_ID=503
DATASET_NAME="Dataset503_ARCADE_6x6_1c_ve2to1"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNet_results"

# -- Minimal smoke-test settings ------------------------------------------------
export SMALLENET_EPOCHS=2
export SMALLENET_BATCH_SIZE=64
export SMALLENET_ITERATIONS_PER_EPOCH=5
export SMALLENET_VAL_ITERATIONS_PER_EPOCH=2
export SMALLENET_SKIP_FINAL_VALIDATION=1   # required -- see train_small_enet_6x6_1c.job
export SMALLENET_SKIP_ARCH_PLOT=1
export SMALLENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}_smoketest_bs64__nnUNetPlans__2d/fold_0"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "SMALLENET_EPOCHS=${SMALLENET_EPOCHS}"
echo "SMALLENET_BATCH_SIZE=${SMALLENET_BATCH_SIZE}"
echo "Output folder: ${SMALLENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Smoke test: nnUNetTrainerSmallENet, batch_size=64, 2 epochs, 5 iters/epoch, ${DATASET_NAME} ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerSmallENet

echo "Smoke test finished."
echo "Check the log above for: (1) no exceptions/OOM at batch_size=64, (2) per-epoch loss values are finite"
echo "(no NaN/inf), (3) wall-clock time per iteration, to sanity-check the full 150-epoch run's time budget"
echo "before committing it to the queue."
