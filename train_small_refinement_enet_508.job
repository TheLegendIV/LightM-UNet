#!/bin/bash
#SBATCH --job-name=small_refinement_enet_508
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=64G
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# nnUNetTrainerSmallRefinementENet on Dataset508_ARCADE_refinement_hard --
# the "hard" curriculum successor to train_small_refinement_enet_507.job:
# 50% real discontinuity / 25% synthetically-corrupted / 25% empty (no
# well-predicted "normal" category at all, unlike 507's 25/50/25), 96x96
# patches natively (not 85x85 padded up to 96 like 507), channel 1 is
# continuous vessel probability (not a binarized mask). See
# dataset-prep/prepare_arcade_508_refinement_hard.py's docstring for the
# full recipe.
#
# REQUIRES, in order: run_enetoriginal_probabilities.job (sbatch) ->
# build_dataset508_refinement_hard.sh (bash, local HPC node) ->
# preprocess_dataset508.job (sbatch) -- this job assumes all three already
# completed; it still has the same inline "preprocess if not already done"
# guard as train_small_refinement_enet_507.job as a fallback, but that guard
# only calls plan_and_preprocess, NOT the dataset508 build step, so it can't
# recover from skipping build_dataset508_refinement_hard.sh.
#
# Gap-focused BCE weighting (nnUNetTrainerSmallRefinementENet.py) is ON BY
# DEFAULT for this trainer -- SMALLENET_GAP_LOSS_BOOST defaults to 8.0,
# SMALLENET_CLDICE_WEIGHT defaults to 1.0 -- no env var required below to
# enable either; this job sets them explicitly anyway purely so the actual
# values used are visible in the job log rather than buried in trainer
# defaults. Set SMALLENET_GAP_LOSS_BOOST=0 to fall back to plain
# Dice+BCE+clDice with no gap weighting (matches 507's loss exactly).
#
# Batch size deliberately left unset here (unlike 507's hardcoded 362,
# carried over from the 85x85-patch dataset family) -- Dataset508 is
# natively 96x96, not padded-up-from-85, so nnU-Net's own auto-planned
# batch_size for it hasn't been cross-checked against that guess. Leaving
# SMALLENET_BATCH_SIZE unset makes nnUNetTrainerSmallENet.__init__ keep
# whatever nnU-Net's planner picked during preprocess_dataset508.job -- the
# "Plan check" step below prints it so you can see what's actually running.
#
# IMPORTANT: SMALLENET_SKIP_FINAL_VALIDATION=1 is required -- inherited from
# nnUNetTrainerSmallENet, same single-logit-sigmoid incompatibility with
# nnU-Net's normal sliding-window export path.



RUN_NAME="nnUNetTrainerSmallRefinementENet"
DATASET_ID=508
DATASET_NAME="Dataset508_ARCADE_refinement_hard"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
set +u   # conda's package-level activation hooks (e.g. CUDA nvcc's
         # NVCC_PREPEND_FLAGS) aren't nounset-safe
conda activate "$HOME/conda-envs/lightmunet"
set -u

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

# -- SmallRefinementENet trainer knobs -----------------------------------------
export SMALLENET_EPOCHS=150
export SMALLENET_SAVE_EVERY=25
export SMALLENET_SKIP_FINAL_VALIDATION=1   # required -- see note above
export SMALLENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"
export SMALLENET_GAP_LOSS_BOOST=8.0        # explicit for log visibility -- matches the trainer default
export SMALLENET_CLDICE_WEIGHT=1.0         # explicit for log visibility -- matches the trainer default
# SMALLENET_STEM_CHANNELS / SMALLENET_STAGE_CHANNELS left at their defaults
# (8 / 32) -- see SmallRefinementENet.py.

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "Trainer: ${RUN_NAME}"
echo "SMALLENET_EPOCHS=${SMALLENET_EPOCHS}"
echo "SMALLENET_GAP_LOSS_BOOST=${SMALLENET_GAP_LOSS_BOOST}"
echo "SMALLENET_CLDICE_WEIGHT=${SMALLENET_CLDICE_WEIGHT}"
echo "Output folder: ${SMALLENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Plan check (expect Dataset508 already preprocessed by preprocess_dataset508.job) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    echo "Plans not found -- running plan_and_preprocess now (should normally have been done by preprocess_dataset508.job already)."
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
fi
python - <<PY
import json, os
from pathlib import Path
p = Path(os.environ["nnUNet_preprocessed"]) / "${DATASET_NAME}" / "nnUNetPlans.json"
cfg = json.loads(p.read_text())["configurations"]["2d"]
print("planned patch_size:", cfg["patch_size"])
print("planned batch_size:", cfg["batch_size"], "(SMALLENET_BATCH_SIZE unset -- this is what actually runs)")
PY

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Start SmallRefinementENet training (epochs=${SMALLENET_EPOCHS}, gap_loss_boost=${SMALLENET_GAP_LOSS_BOOST}, cldice_weight=${SMALLENET_CLDICE_WEIGHT}) ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerSmallRefinementENet

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."
