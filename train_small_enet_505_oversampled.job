#!/bin/bash
#SBATCH --job-name=small_enet_505_oversampled
#SBATCH --partition=gpu_mig
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=1
#SBATCH --mem=32G
#SBATCH --time=08:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# nnUNetTrainerSmallENet on Dataset505_ARCADE_oversampled -- built from
# scratch by dataset-prep/prepare_arcade_vessel_coverage.py, NOT derived
# from Dataset502 like Dataset503/504 are. Instead of tiling each source
# image into a fixed grid and then thinning/filtering empty patches after
# the fact, patches are placed directly on the vessel: skeletonize the
# whole image's vessel mask, farthest-point-sample 36 well-spread centers
# along that skeleton, crop an 85x85 patch at each one. Every patch center
# is itself a vessel pixel, so every patch contains vessel by construction
# -- confirmed on a 2000-patch random sample: 0 empty, vessel density
# 1.8-49% of patch pixels (median 15%). See
# dataset-prep/preview_dataset505.ipynb for the full verification (coverage
# plots, density histogram, sample patches) and
# dataset-prep/prepare_arcade_vessel_coverage.py's docstring for why
# skeletonize+FPS was picked over a heatmap+threshold approach.
#
# 43,200 total patches: 36,000 train (1000 source images x 36) + 7,200 val
# (200 source images x 36). No imagesTs/labelsTs generated on purpose --
# evaluate against Dataset502_ARCADE_6x6_1c's imagesTs/labelsTs (standard
# grid tiling, not vessel-biased) for metrics comparable to every other
# experiment in this repo.
#
# Same VesselGapTransform + clDice loss recipe as
# train_small_enet_504_noempty.job (both already smoke-tested there --
# see nnUNetTrainerSmallENet.py's module docstring for the rationale on
# each). Adjust SMALLENET_GAP_AUG_P / SMALLENET_CLDICE_WEIGHT below if you
# want a different setting for this dataset specifically.
#
# Batch size 362 is nnU-Net's own auto-configured planner default for this
# dataset's 2d plan -- confirmed identical to Dataset504's (same patch
# dimensions feed the same sizing heuristic). --mem=64G/--time=08:00:00
# are carried over from that job as first guesses, not measured numbers for
# this specific dataset; watch the first couple of epochs and tighten.
#
# IMPORTANT: SMALLENET_SKIP_FINAL_VALIDATION=1 is required -- see
# nnUNetTrainerSmallENet.py.
#
# NOTE: verify `--partition=gpu_mig` (and whether your cluster wants a
# `--gres=gpu:<slice>:1`-style request instead of plain `--gpus=1` for MIG)
# against `sinfo -o "%P %G"` on your cluster.



RUN_NAME="nnUNetTrainerSmallENet"
DATASET_ID=505
DATASET_NAME="Dataset505_ARCADE_oversampled"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023
module load CUDA/12.1.1

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

# -- SmallENet trainer knobs ----------------------------------------------------
export SMALLENET_EPOCHS=150
export SMALLENET_BATCH_SIZE=362
export SMALLENET_SAVE_EVERY=25
export SMALLENET_SKIP_FINAL_VALIDATION=1   # required -- see note above
export SMALLENET_OUTPUT_FOLDER="$nnUNet_results/${DATASET_NAME}/${RUN_NAME}__nnUNetPlans__2d/fold_0"

# -- Vessel-gap augmentation ---------------------------------------------------
export SMALLENET_GAP_AUG=1
export SMALLENET_GAP_AUG_P=0.6
# SMALLENET_GAP_AUG_DROP / _MARGIN / _MIN_SEGMENT left at their defaults
# (0.55 / 8 / 40) -- see vessel_gap_transform.py.

# -- clDice loss term -----------------------------------------------------------
export SMALLENET_CLDICE_WEIGHT=1.0
export SMALLENET_CLDICE_ITERS=12

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "SMALLENET_EPOCHS=${SMALLENET_EPOCHS}"
echo "SMALLENET_BATCH_SIZE=${SMALLENET_BATCH_SIZE}"
echo "SMALLENET_GAP_AUG=${SMALLENET_GAP_AUG} (p=${SMALLENET_GAP_AUG_P})"
echo "SMALLENET_CLDICE_WEIGHT=${SMALLENET_CLDICE_WEIGHT} (iters=${SMALLENET_CLDICE_ITERS})"
echo "Output folder: ${SMALLENET_OUTPUT_FOLDER}"

echo "=== GPU info ==="
nvidia-smi

python - <<'PY'
import torch
print("CUDA available:", torch.cuda.is_available())
print("GPU:", torch.cuda.get_device_name(0) if torch.cuda.is_available() else None)
assert torch.cuda.is_available(), "CUDA is not available in PyTorch"
PY

echo "=== Plan + preprocess (skipped if already done) ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "=== Start SmallENet training (batch_size=${SMALLENET_BATCH_SIZE}, epochs=${SMALLENET_EPOCHS}, gap_aug_p=${SMALLENET_GAP_AUG_P}, cldice_weight=${SMALLENET_CLDICE_WEIGHT}) ==="
nnUNetv2_train "${DATASET_NAME}" 2d 0 -tr nnUNetTrainerSmallENet

echo "Training finished for ${RUN_NAME} on ${DATASET_NAME}."
