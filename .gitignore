dataset-prep/ARCADE/*

# -- Heavy nnU-Net data/output dirs -------------------------------------------
# Preprocessed caches and training outputs are regenerated by the job scripts
# (nnUNetv2_plan_and_preprocess / nnUNetv2_train) -- never worth committing,
# for any dataset.
data/nnUNET_preprocessed/*
data/nnUNET_results/*
data/nnUNET_results_pareto/*
data/nnUNET_results_smoke/*
data/nnUNET_results_smoke_test/*
data/*.log

# Raw datasets: keep only what's needed for a full Dataset504 training run.
# Other configs' raw patches (Dataset501/502/503, Dataset801/802, ...) are
# excluded for now -- rebuild via dataset-prep/ scripts if needed again.
data/nnUNet_raw/*
!data/nnUNet_raw/Dataset504_ARCADE_6x6_1c_noempty/
