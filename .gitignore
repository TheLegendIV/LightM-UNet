__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only dataset tooling (raw external dumps + prep scripts) and
# analysis-script result outputs -- both regenerated locally, never pushed.
dataset-prep/
analysis/*/results/
analysis/*/predictions/

# enet-compression: clean branch for the ENet / ENet-E1 compression study on
# Dataset501_ARCADE. Preprocessed caches and training output are always
# regenerated on HPC (nnUNetv2_plan_and_preprocess / train_*.job) or
# archived out to ~/models via scripts/archive_checkpoint.sh -- never worth
# committing. Checkpoints and per-case validation PNGs in particular must
# never be pushed.
data/nnUNet_preprocessed/*
# data/nnUNet_results/*
# data/*.log
*.pth

# Raw datasets: no longer pushed at all (both Dataset509_ARCADE_1x1_4c and
# Dataset511_ARCADE_1x1_3c now exist as local files on the machines that need
# them -- the 3c one is regenerable any time from Dataset509 via
# compression/scripts/make_arcade_3c_dataset.py, and the 4c one is the
# original ARCADE export). Carrying ~190MB/dataset of raw PNGs through every
# clone/pull was never worth it once that regeneration path existed.
data/nnUNet_raw/*

deployment/baremetal

logs/*

**/validation/*

# nnU-Net's own per-run training-curve plot -- regenerable from the run's
# own training_log_*.txt at any time, never worth committing. Scoped to
# data/nnUNet_results specifically so this can't ever catch a real report
# figure (e.g. analysis/report/**/*.png) that happens to be named progress.png.
data/nnUNet_results/**/progress.png

# Regenerable from a checkpoint + compression/export_quant_checkpoint.py at
# any time -- never worth committing.
# compression/configs/qonnx_exports/

# Runtime mutex for collect_results.py's results.csv flock -- never has
# content worth tracking, just a lock target.
*.lock

# Any directory named "archive" anywhere in the repo (old/retired
# experiment files, kept locally but never worth pushing).
**/archive/

FINN

deployment/FINN_interface/*

!**/run.c*
!**/main.c*


*.pdf