__pycache__/
*.pyc
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local-only dataset tooling (raw external dumps + prep scripts) and
# analysis-script result outputs -- both regenerated locally, never pushed.
dataset-prep/
analysis/*/results/
analysis/*/predictions/

# enet-compression: clean branch for the ENet / ENet-E1 compression study on
# Dataset501_ARCADE. Preprocessed caches and training output are always
# regenerated on HPC (nnUNetv2_plan_and_preprocess / train_*.job) or
# archived out to ~/models via scripts/archive_checkpoint.sh -- never worth
# committing. Checkpoints and per-case validation PNGs in particular must
# never be pushed.
data/nnUNet_preprocessed/*
# data/nnUNet_results/*
# data/*.log
# *.pth

# Raw datasets: keep only Dataset509 (the current 4-class objective this
# branch trains on -- Dataset501 was the retired binary objective, see
# compression/README.md's top note) -- and even within it, drop any
# inference-output labelsPr_* dirs a preview notebook may have written;
# only the ground-truth raw pngs are pushed.
# data/nnUNet_raw/*
!data/nnUNet_raw/Dataset509_ARCADE_1x1_4c/
data/nnUNet_raw/Dataset509_ARCADE_1x1_4c/labelsPr_*/

data/nnUNet_raw/Dataset501_ARCADE/labelsPr_*/

logs/*

*/validation/*

# Regenerable from a checkpoint + compression/export_quant_checkpoint.py at
# any time -- never worth committing.
# compression/configs/qonnx_exports/

# Runtime mutex for collect_results.py's results.csv flock -- never has
# content worth tracking, just a lock target.
*.lock

# Any directory named "archive" anywhere in the repo (old/retired
# experiment files, kept locally but never worth pushing).
**/archive/