dataset-prep/ARCADE/*
__pycache__/

# -- Heavy nnU-Net data/output dirs -------------------------------------------
# Preprocessed caches are regenerated by the job scripts
# (nnUNetv2_plan_and_preprocess / preprocess_dataset507.job) -- normally
# never worth committing, EXCEPT Dataset507 (current active work, kept
# alongside its raw data below) and Dataset501 (long-tracked, untouched).
data/nnUNET_preprocessed/*
!data/nnUNET_preprocessed/Dataset501_ARCADE/
!data/nnUNET_preprocessed/Dataset507_ARCADE_refinement/

data/nnUNET_results/*
data/nnUNET_results_pareto/*
data/nnUNET_results_smoke/*
data/nnUNET_results_smoke_test/*
data/*.log

*/imagesTs
*/labelsTs

# Raw datasets: keep only Dataset501 (long-tracked, untouched) and
# Dataset507 (current active work). Everything else (502/503/504/505/506,
# Dataset801/802, ...) is untracked -- files stay on disk, just out of git;
# regenerate via dataset-prep/ scripts if needed again.
data/nnUNet_raw/*
!data/nnUNet_raw/Dataset501_ARCADE/
!data/nnUNet_raw/Dataset507_ARCADE_refinement/
