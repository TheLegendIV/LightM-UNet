# enet-post: minimal branch for training ENetPost / ENetPostRefinement on
# Dataset509_ARCADE_ENetPost only. Preprocessed caches and training output
# are always regenerated by the job scripts (nnUNetv2_plan_and_preprocess /
# train_enetpost.job / train_enetpostrefinement.job), never worth
# committing.
data/nnUNET_preprocessed/*
data/nnUNET_results/*
data/*.log

**/imagesTs
**/labelsTs

# Raw datasets: keep only Dataset509 (everything this branch trains on).
data/nnUNet_raw/*
!data/nnUNet_raw/Dataset509_ARCADE_ENetPost/

logs/*
