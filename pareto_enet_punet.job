#!/bin/bash
#SBATCH --job-name=enet_punet_pareto
#SBATCH --partition=gpu_a100
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --gpus=1
#SBATCH --mem=120G
#SBATCH --time=36:00:00
#SBATCH --output=%x_%j.out
#SBATCH --error=%x_%j.err

set -e

mkdir -p logs

module purge
module load 2023
module load CUDA/12.1.1

source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

export CUDA_HOME="$CONDA_PREFIX"
export PATH="$CUDA_HOME/bin:$PATH"
export LD_LIBRARY_PATH="$CUDA_HOME/lib:$CUDA_HOME/lib64:$LD_LIBRARY_PATH"

unset PYTHONPATH
export PYTHONHASHSEED=42
export MAX_JOBS=4
export PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:128

export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Working dir: $(pwd)"
echo "Conda env: $CONDA_PREFIX"

echo "=== GPU info ==="
nvidia-smi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/Dataset501_ARCADE/splits_final.json" \
   "$nnUNet_preprocessed/Dataset501_ARCADE/splits_final.json"

echo "=== Start ENetOriginal/PUNet Pareto sweep ==="
python pareto_experiments/run_enet_punet_pareto.py \
  --epochs 10 \
  --batch-size 8 \
  --fold 0 \
  --seed 42 \
  --overwrite \
  --output-root "$HOME/LightM-UNet/data/nnUNET_results_pareto/enet_punet_bs8_e10"

echo "=== ENetOriginal/PUNet Pareto sweep finished ==="
echo "Summary:"
cat "$HOME/LightM-UNet/data/nnUNET_results_pareto/enet_punet_bs8_e10/summary.csv"
