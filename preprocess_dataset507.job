#!/bin/bash
#SBATCH --job-name=preprocess_507
#SBATCH --partition=rome           # CPU-only -- no GPU needed for plan_and_preprocess; check `sinfo -o "%P %G"`
                                   # for this cluster's actual CPU-only partition name, this is a guess
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --time=02:00:00
#SBATCH --output=logs/%x_%j.out
#SBATCH --error=logs/%x_%j.err

# Plan+preprocess Dataset507_ARCADE_refinement from nnUNet_raw only -- no
# training, no GPU. Split out from train_small_enet_507.job /
# train_small_refinement_enet_507.job (which both still have their own
# inline "preprocess if not already done" guard, so running this first is
# optional, not required) so the ~20-40 min, CPU/IO-bound preprocessing step
# doesn't tie up a scarce gpu_mig slot while nothing on the GPU side is
# happening yet. One run of this covers both training jobs -- plans.json is
# per dataset+configuration, not per trainer, so nnUNetTrainerSmallENet and
# nnUNetTrainerSmallRefinementENet both read the same preprocessed cache
# this produces.
#
# Preprocessed output is NOT committed to git (data/nnUNET_preprocessed/*
# is gitignored for every dataset, regenerated on demand) -- this script is
# how you regenerate it on a fresh checkout before training.



DATASET_ID=507
DATASET_NAME="Dataset507_ARCADE_refinement"

# -- HPC environment ----------------------------------------------------------
module purge
module load 2023

# -- Activate Conda environment -----------------------------------------------
source "$HOME/miniconda3/etc/profile.d/conda.sh"
conda activate "$HOME/conda-envs/lightmunet"

# -- General settings ---------------------------------------------------------
unset PYTHONPATH
export PYTHONHASHSEED=42

# -- nnU-Net paths ------------------------------------------------------------
export nnUNet_raw="$HOME/LightM-UNet/data/nnUNet_raw"
export nnUNet_preprocessed="$HOME/LightM-UNet/data/nnUNet_preprocessed"
export nnUNet_results="$HOME/LightM-UNet/data/nnUNET_results"

cd "$HOME/LightM-UNet/lightm-unet"

echo "=== Job info ==="
echo "Host: $(hostname)"
echo "Date: $(date)"
echo "Dataset: ${DATASET_NAME} (id ${DATASET_ID})"
echo "CPUs: ${SLURM_CPUS_PER_TASK:-unknown}"

echo "=== Plan + preprocess ==="
if [ ! -f "$nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json" ]; then
    nnUNetv2_plan_and_preprocess -d "${DATASET_ID}" --verify_dataset_integrity
else
    echo "Plans already exist at $nnUNet_preprocessed/${DATASET_NAME}/nnUNetPlans.json, skipping."
fi

echo "=== Ensure official split is present ==="
cp "$nnUNet_raw/${DATASET_NAME}/splits_final.json" \
   "$nnUNet_preprocessed/${DATASET_NAME}/splits_final.json"

echo "Preprocessing finished for ${DATASET_NAME}. Ready for train_small_enet_507.job / train_small_refinement_enet_507.job."
